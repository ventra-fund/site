{
	"name": "site",
	"main": "@astrojs/cloudflare/entrypoints/server",
	// Workers runtime behaviour is pinned to this date; bump it deliberately when adopting newer runtime changes.
	"compatibility_date": "2026-09-20",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Per-IP cap on form submissions (/api/contact, /api/partner), read in
	// src/lib/server/rate-limit.ts. Two per minute is enough for a visitor to send, say, a contact
	// message and a partner inquiry back to back; a third within the minute gets a 429. `period` can
	// only be 10 or 60. `namespace_id` is an arbitrary account-unique id for this counter.
	"ratelimits": [
		{
			"name": "FORM_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 2,
				"period": 60
			}
		},
		// The signing link's steps (/api/sign/[token]: accept the disclosure, then sign). A signer
		// needs two, plus a few retries after a mistyped EIN or SSN; the link token is already the
		// real gate, this only stops a script guessing at it from one IP.
		{
			"name": "SIGN_RATE_LIMIT",
			"namespace_id": "1005",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		// The contact reveal (/api/contact/reveal): one call to show the number and one per Copy or
		// Call, each behind its own Turnstile token. 12 is far above a person and still stops a script.
		{
			"name": "CONTACT_RATE_LIMIT",
			"namespace_id": "1006",
			"simple": {
				"limit": 12,
				"period": 60
			}
		}
	],
	// Stored copies of statements uploaded with past applications (src/lib/server/documents.ts),
	// kept with the records in DRAFTS_DB and deleted by the same purge. One-time setup, see README: create the
	// bucket. No lifecycle rule: it would delete statements of applications that must be kept.
	"r2_buckets": [
		{
			"binding": "DOCUMENTS",
			"bucket_name": "ventra-fund-documents"
		},
		{
			"bucket_name": "ventra-fund-documents",
			"binding": "ventra_fund_documents"
		}
	],
	// Apply schema changes with `pnpm migrate:local` / `pnpm migrate:remote` (package.json), which
	// run every database's migrations. No `database_id`s: `wrangler deploy` provisions each
	// database on first deploy and writes the id back. One environment only, no staging copies.
	"d1_databases": [
		// Admin sign-in (src/lib/server/auth.ts): users, sessions, one-time codes and rate-limit
		// counters. Schema in migrations/.
		{
			"binding": "AUTH_DB",
			"database_name": "ventra-fund-auth",
			"migrations_dir": "migrations"
		},
		// Applications from the old public form (/apply, since removed), their decisions and
		// signatures, and the retention settings (src/lib/server/drafts.ts). Schema in migrations-drafts/.
		{
			"binding": "DRAFTS_DB",
			"database_name": "ventra-fund-drafts",
			"migrations_dir": "migrations-drafts"
		}
	],
	 "observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
		"enabled": true,
		"head_sampling_rate": 1,
		"invocation_logs": true,
		"persist": true
		},
		"traces": {
		"enabled": true,
		"head_sampling_rate": 1,
		"persist": true
		},
		"issue_detection": {
		"enabled": true
		}
	},
	// Worker Previews (`wrangler preview`, and Workers Builds on non-production branches). Previews
	// inherit none of the bindings above, so each is redeclared here against staging copies: test
	// test data and admin sign-ins never touch production data. Apply schema changes to
	// the staging databases with `pnpm migrate:preview`. Secrets are separate too:
	// `wrangler preview base-config secret put NAME`.
	"previews": {
		// Astro sessions. Production's SESSION is added by the adapter and provisioned by `wrangler
		// deploy`, but `wrangler preview` won't provision one, so it needs a real namespace id here
		// (declaring it also stops the adapter adding an id-less one).
		"kv_namespaces": [
			{ "binding": "SESSION", "id": "f4387630a4ed4b88a3384c33a3244ca0" }
		],
		// Same limits as production, on their own counters (namespace ids 2xxx vs 1xxx).
		"ratelimits": [
			{ "name": "FORM_RATE_LIMIT", "namespace_id": "2001", "simple": { "limit": 2, "period": 60 } },
			{ "name": "SIGN_RATE_LIMIT", "namespace_id": "2005", "simple": { "limit": 10, "period": 60 } },
			{ "name": "CONTACT_RATE_LIMIT", "namespace_id": "2006", "simple": { "limit": 12, "period": 60 } }
		],
		"r2_buckets": [
			{ "binding": "DOCUMENTS", "bucket_name": "ventra-fund-documents-preview" },
			{ "binding": "ventra_fund_documents", "bucket_name": "ventra-fund-documents-preview" }
		],
		"d1_databases": [
			{
				"binding": "AUTH_DB",
				"database_name": "ventra-fund-auth-preview",
				"database_id": "4ba5639a-c034-4de0-9fa0-3c7536063583",
				"migrations_dir": "migrations"
			},
			{
				"binding": "DRAFTS_DB",
				"database_name": "ventra-fund-drafts-preview",
				"database_id": "781de14e-05b8-4b41-851d-ede5846692ce",
				"migrations_dir": "migrations-drafts"
			}
		]
	}
}