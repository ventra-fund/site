{
	"name": "ventra-fund",
	"main": "@astrojs/cloudflare/entrypoints/server",
	// Workers runtime behaviour is pinned to this date; bump it deliberately when adopting newer runtime changes.
	"compatibility_date": "2026-09-20",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Per-IP cap on form submissions (/api/apply, /api/contact, /api/partner), read in
	// src/lib/server/rate-limit.ts. Two per minute is enough for a visitor to send, say, a contact
	// message and an application back to back; a third within the minute gets a 429. `period` can
	// only be 10 or 60. `namespace_id` is an arbitrary account-unique id for this counter.
	"ratelimits": [
		{
			"name": "FORM_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 2, "period": 60 }
		},
		// Statement uploads (/api/apply/upload) get their own counter so re-picking files doesn't
		// eat the submit budget. The unit is a REQUEST, not a file: the page sends up to 4 files
		// per request (MAX_FILES_PER_UPLOAD), so a full pick of 6 is two requests and 4/min leaves
		// room for a second full pick inside a minute. Each request can put up to 4 documents
		// through the (paid) document provider, so this is also the per-IP spend cap: 4 × 4 files a
		// minute at most.
		{
			"name": "UPLOAD_RATE_LIMIT",
			"namespace_id": "1002",
			"simple": { "limit": 4, "period": 60 }
		},
		// Status polls (/api/apply/parse-status) are free to call but each one asks the document
		// provider about up to 6 jobs. The page polls every 6 s (10 a minute) while statements are
		// being read, so 30 leaves room for a few applicants on one office IP and still stops a
		// script from burning the provider's rate limit for everyone.
		{
			"name": "STATUS_RATE_LIMIT",
			"namespace_id": "1003",
			"simple": { "limit": 30, "period": 60 }
		}
	],
	// PARKED: server-side storage of uploaded statements (src/lib/server/documents.ts). Switched
	// off until the abandoned-form-fill work lands, so statements and that data share one bucket
	// and one set of lifecycle rules. To turn it on: uncomment, create the bucket once with
	// `npx wrangler r2 bucket create ventra-fund-documents`, and wire documents.ts back into the
	// upload/submit endpoints.
	// "r2_buckets": [
	// 	{
	// 		"binding": "DOCUMENTS",
	// 		"bucket_name": "ventra-fund-documents"
	// 	}
	// ],
	// Admin sign-in (src/lib/server/auth.ts): users, sessions, one-time codes and rate-limit
	// counters. Schema lives in migrations/; apply with
	// `npx wrangler d1 migrations apply ventra-fund-auth --local` (or `--remote`). No
	// `database_id`: `wrangler deploy` provisions the database on first deploy and writes it back.
	"d1_databases": [
		{
			"binding": "AUTH_DB",
			"database_name": "ventra-fund-auth",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	}
}
