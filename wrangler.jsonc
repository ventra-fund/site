{
	"name": "ventra-fund",
	"main": "@astrojs/cloudflare/entrypoints/server",
	// Workers runtime behaviour is pinned to this date; bump it deliberately when adopting newer runtime changes.
	"compatibility_date": "2026-09-20",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}
