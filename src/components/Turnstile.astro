---
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';

interface Props {
  id?: string;
  action?: string;
  appearance?: 'always' | 'execute' | 'interaction-only';
  size?: 'normal' | 'flexible' | 'compact';
  class?: string;
}

// The site key is public (it is rendered into the HTML), so it is read at build time from
// PUBLIC_TURNSTILE_SITE_KEY. The astro:env schema makes a missing key fail the build. See .env.example.
const sitekey = PUBLIC_TURNSTILE_SITE_KEY;

const {
  id,
  action = 'contact',
  appearance = 'interaction-only',
  size = 'normal',
  class: className,
} = Astro.props;
---

<turnstile-widget
  id={id}
  data-sitekey={sitekey}
  data-action={action}
  data-appearance={appearance}
  data-size={size}
  class={className}
></turnstile-widget>

<script>
  import '@/lib/turnstile';
</script>
