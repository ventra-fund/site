---
interface Props {
  id?: string;
  action?: string;
  appearance?: 'always' | 'execute' | 'interaction-only';
  size?: 'normal' | 'flexible' | 'compact';
  class?: string;
}

// The site key is public (it is rendered into the HTML), so it is read at build time from
// PUBLIC_TURNSTILE_SITE_KEY. See .env.example.
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
if (!sitekey) {
  console.warn('[turnstile] PUBLIC_TURNSTILE_SITE_KEY is not set; the widget will not render. See .env.example.');
}

const {
  id,
  action = 'contact',
  appearance = 'interaction-only',
  size = 'normal',
  class: className,
} = Astro.props;
---

<turnstile-widget
  id={id}
  data-sitekey={sitekey}
  data-action={action}
  data-appearance={appearance}
  data-size={size}
  class={className}
></turnstile-widget>

<script>
  import '@/lib/turnstile';
</script>
