---
// Public site header, the same nav as Main Capital's (~/Projects/capital/themaincapital, src/layouts/Layout.astro):
// wordmark, the menu in the middle, Dashboard on the right. It sits over the top of the page rather than
// taking space, so the home hero's sky runs up behind it; the content pages' top padding (pt-30) clears it.
// It scrolls away with the page.
//
// By width: from xl the menu is centred on the page (a 1fr/auto/1fr grid, which needs about 1025px for
// the wordmark either side of the menu); from lg it sits between the wordmark and Dashboard; below lg it
// folds into a menu button whose panel lists the same links. Below 360px Dashboard moves into the panel too.
//
// Links with no Ventra page yet go to "#": API Docs and Syndicate.
import {
  NavigationMenu,
  NavigationMenuContent,
  NavigationMenuIndicator,
  NavigationMenuItem,
  NavigationMenuLink,
  NavigationMenuList,
  NavigationMenuTrigger,
} from "@/ui/navigation-menu";
import { Popover, PopoverContent, PopoverTrigger } from "@/ui/popover";
import { cn } from "@/lib/utils";

// The menu's sliding indicator is the only hover/focus/open background: the trigger's and links' own
// hover:bg-muted, fading in place while the pill slid over them, read as a flicker. Their focus rings stay.
const noItemBg = "bg-transparent!";

// The plain links next to the dropdown, as Main Capital styles them.
const topLink = `cn-navigation-menu-trigger group/navigation-menu-trigger inline-flex h-9 w-max items-center justify-center outline-none disabled:pointer-events-none ${noItemBg}`;

const dashboard =
  "inline-flex h-9 items-center justify-center rounded-3xl bg-primary px-4.5 text-sm font-medium text-primary-foreground transition-all outline-none hover:bg-primary/90 focus-visible:ring-3 focus-visible:ring-ring/30";

// A row of the mobile panel: 44px tall, for touch.
const panelRow =
  "flex items-center rounded-2xl px-3 py-2.5 text-base font-medium outline-none transition-colors hover:bg-muted focus-visible:bg-muted focus-visible:ring-3 focus-visible:ring-ring/30";

const links = [
  { href: "#", label: "API Docs" },
  { href: "/about", label: "About Us" },
  { href: "/careers", label: "Careers" },
  { href: "#", label: "Syndicate" },
  { href: "/contact", label: "Contact" },
];

const onboard = {
  href: "/partner",
  title: "Onboard with us",
  text: "Access our CRM, calculate commission, automated pre-underwriting analysis.",
};

const isoLinks = [
  { href: "/who-we-fund", title: "Guidelines", text: "What we fund" },
  { href: "/our-assurances", title: "Our Assurances", text: "Contractual obligations" },
  { href: "/why-us/faq", title: "FAQs", text: "Common questions" },
];
---

<header
  class="absolute inset-x-0 top-0 z-10 flex items-center justify-between gap-4 p-4 sm:px-6 xl:grid xl:grid-cols-[1fr_auto_1fr]"
>
  <a href="/" class="justify-self-start" aria-label="Ventra Fund home">
    <img src="/ventrafund-wordmark.svg" alt="" width="4060" height="522" class="h-5 w-auto sm:h-6 dark:invert" />
  </a>
  <NavigationMenu class="hidden lg:flex">
    <NavigationMenuList>
      <NavigationMenuItem value="iso-information">
        <NavigationMenuTrigger class={noItemBg}>ISO Information</NavigationMenuTrigger>
        <NavigationMenuContent>
          <div class="grid w-[480px] grid-cols-[1fr_200px] gap-2 p-2">
            <div class="row-span-3">
              <NavigationMenuLink
                href={onboard.href}
                class="flex h-full flex-col items-start rounded-md bg-gradient-to-b from-muted/50 to-muted p-4 no-underline"
              >
                <div class="mb-2 text-lg font-medium">{onboard.title}</div>
                <p class="text-sm text-muted-foreground">{onboard.text}</p>
              </NavigationMenuLink>
            </div>
            {isoLinks.map(({ href, title, text }) => (
              <NavigationMenuLink href={href}>
                <div class="flex flex-col gap-1">
                  <div class="leading-none font-medium">{title}</div>
                  <div class="line-clamp-2 text-muted-foreground">{text}</div>
                </div>
              </NavigationMenuLink>
            ))}
          </div>
        </NavigationMenuContent>
      </NavigationMenuItem>
      {links.map(({ href, label }) => (
        <NavigationMenuItem>
          <NavigationMenuLink href={href} class={topLink}>{label}</NavigationMenuLink>
        </NavigationMenuItem>
      ))}
      <NavigationMenuIndicator />
    </NavigationMenuList>
  </NavigationMenu>
  <div class="flex items-center gap-2 justify-self-end">
    <a href="/partner/login" class={cn(dashboard, "max-[22.5rem]:hidden")}>Dashboard</a>
    <Popover class="flex lg:hidden" data-site-menu>
      <PopoverTrigger variant="ghost" size="icon" aria-label="Menu" class="group flex-col gap-1.5 rounded-full hover:bg-muted">
        <!-- Two bars that cross into an X while the panel is open. -->
        <span class="block h-0.5 w-4.5 rounded-full bg-foreground transition-transform duration-200 group-aria-expanded:translate-y-1 group-aria-expanded:rotate-45"></span>
        <span class="block h-0.5 w-4.5 rounded-full bg-foreground transition-transform duration-200 group-aria-expanded:-translate-y-1 group-aria-expanded:-rotate-45"></span>
      </PopoverTrigger>
      <!-- Always straight under the button. With collision handling on, a panel taller than the room below
           (ISO Information open, on a short phone) would be clamped into the viewport, up over the button; it
           scrolls inside itself instead. Its width keeps it 1rem from both edges, so it never collides sideways. -->
      <PopoverContent
        align="end"
        sideOffset={8}
        data-avoid-collisions="false"
        class="max-h-[calc(100dvh-6rem)] w-[min(22rem,calc(100vw-2rem))] gap-0 overflow-y-auto rounded-3xl p-2 shadow-lg ring-foreground/5 lg:hidden"
      >
        <nav aria-label="Main" class="flex flex-col">
          <!-- A native disclosure, as the desktop dropdown's stand-in: no menu JS of its own. -->
          <details class="group/iso">
            <summary class={cn(panelRow, "cursor-pointer list-none justify-between [&::-webkit-details-marker]:hidden")}>
              ISO Information
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-4 transition-transform duration-200 group-open/iso:rotate-180" aria-hidden="true"
                ><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9l6 6l6-6" /></svg
              >
            </summary>
            <div class="flex flex-col gap-1 pb-2">
              <a
                href={onboard.href}
                class="rounded-2xl bg-gradient-to-b from-muted/50 to-muted p-4 outline-none focus-visible:ring-3 focus-visible:ring-ring/30"
              >
                <div class="mb-1 font-medium">{onboard.title}</div>
                <p class="text-sm text-muted-foreground">{onboard.text}</p>
              </a>
              {isoLinks.map(({ href, title, text }) => (
                <a href={href} class={cn(panelRow, "flex-col items-start gap-0.5")}>
                  {title}
                  <span class="text-sm font-normal text-muted-foreground">{text}</span>
                </a>
              ))}
            </div>
          </details>
          {links.map(({ href, label }) => (
            <a href={href} class={panelRow}>{label}</a>
          ))}
          <a href="/partner/login" class={cn(dashboard, "mt-2 h-11 text-base min-[22.5rem]:hidden")}>Dashboard</a>
        </nav>
      </PopoverContent>
    </Popover>
  </div>
</header>

<script>
  // The menu button and its panel go away at lg; close the panel then, rather than leave it open behind them.
  const wide = matchMedia("(min-width: 64rem)");
  wide.addEventListener("change", () => {
    if (!wide.matches) return;
    document
      .querySelectorAll("[data-site-menu]")
      .forEach((menu) => menu.dispatchEvent(new CustomEvent("popover:set", { detail: { open: false } })));
  });
</script>
