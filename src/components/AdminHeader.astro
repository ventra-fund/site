---
import { Button } from "@/ui/button";

// Top bar for the admin pages: where you are, who you're signed in as, and sign out.
interface Props {
  current: "overview" | "applications";
}

const { current } = Astro.props;
const email = Astro.locals.adminSession?.user.email;
const links = [
  { key: "overview", href: "/admin", label: "Overview" },
  { key: "applications", href: "/admin/drop-offs", label: "Applications" },
] as const;
---

<header class="flex flex-wrap items-center justify-between gap-4 border-b border-border pb-4">
  <nav class="flex gap-4 text-sm font-medium">
    {links.map((l) => (
      <a href={l.href} class={l.key === current ? "text-foreground" : "text-muted-foreground hover:text-foreground"} aria-current={l.key === current ? "page" : undefined}>{l.label}</a>
    ))}
  </nav>
  <div class="flex items-center gap-3 text-sm text-muted-foreground">
    {email}
    <Button variant="outline" size="sm" data-sign-out>Sign out</Button>
  </div>
</header>

<script>
  import { authClient } from "@/lib/auth-client";

  document.querySelector("[data-sign-out]")?.addEventListener("click", async () => {
    await authClient.signOut();
    location.assign("/admin/sign-in");
  });
</script>
