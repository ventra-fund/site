---
import Plus from "@lucide/astro/icons/plus";
import Minus from "@lucide/astro/icons/minus";

interface Props {
  pros: string[];
  cons: string[];
}

const { pros, cons } = Astro.props;
---

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
  <div class="flex flex-col gap-2">
    <h4 class="text-sm font-semibold uppercase tracking-widest text-foreground">Pros</h4>
    <ul class="flex list-none flex-col gap-2">
      {pros.map((p) => <li class="flex gap-2"><Plus class="mt-1 size-4 shrink-0 text-primary" aria-hidden="true" />{p}</li>)}
    </ul>
  </div>
  <div class="flex flex-col gap-2">
    <h4 class="text-sm font-semibold uppercase tracking-widest text-foreground">Cons</h4>
    <ul class="flex list-none flex-col gap-2">
      {cons.map((c) => <li class="flex gap-2"><Minus class="mt-1 size-4 shrink-0 text-destructive" aria-hidden="true" />{c}</li>)}
    </ul>
  </div>
</div>
