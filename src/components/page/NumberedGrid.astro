---
// Numbered cards: steps, values, or a run of facts. Numbers come from the order.
import GlareCard from "@/components/GlareCard.astro";

interface Props {
  items: { title: string; text: string }[];
  columns?: 2 | 3 | 4;
}

const { items, columns = 3 } = Astro.props;
const cols = { 2: "md:grid-cols-2", 3: "md:grid-cols-2 lg:grid-cols-3", 4: "md:grid-cols-2 lg:grid-cols-4" }[columns];
---

<ol class:list={["grid list-none grid-cols-1 gap-4", cols]}>
  {items.map(({ title, text }, i) => (
    <li class="flex">
      <GlareCard class="flex w-full flex-col border border-border bg-card p-8">
        <span class="text-sm text-muted-foreground tabular-nums">{String(i + 1).padStart(2, "0")}</span>
        <h3 class="mt-10 text-xl font-medium tracking-[-0.02em]">{title}</h3>
        <p class="mt-2 text-base text-muted-foreground">{text}</p>
      </GlareCard>
    </li>
  ))}
</ol>
