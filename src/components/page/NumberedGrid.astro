---
// Numbered cards: steps, values, or a run of facts. Numbers come from the order.
interface Props {
  items: { title: string; text: string }[];
  columns?: 2 | 3 | 4;
}

const { items, columns = 3 } = Astro.props;
const cols = { 2: "md:grid-cols-2", 3: "md:grid-cols-2 lg:grid-cols-3", 4: "md:grid-cols-2 lg:grid-cols-4" }[columns];
---

<ol class:list={["grid list-none grid-cols-1 gap-4", cols]}>
  {items.map(({ title, text }, i) => (
    <li class="flex flex-col gap-3 border border-border bg-card p-6">
      <span class="self-start bg-secondary px-3 py-2 text-sm font-semibold text-primary">{String(i + 1).padStart(2, "0")}</span>
      <h3 class="text-lg font-bold text-foreground">{title}</h3>
      <p class="text-base text-muted-foreground">{text}</p>
    </li>
  ))}
</ol>
