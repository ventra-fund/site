---
// Icon, title and a line of text per item, as hover-lit cards in a row of up to three (or four with
// `columns={4}`).
import GlareCard from "@/components/GlareCard.astro";

interface Props {
  items: { icon: any; title: string; text: string }[];
  columns?: 3 | 4;
}

const { items, columns = 3 } = Astro.props;
---

<ul class:list={["grid list-none grid-cols-1 gap-4 sm:grid-cols-2", columns === 4 ? "lg:grid-cols-4" : "lg:grid-cols-3"]}>
  {items.map(({ icon: Icon, title, text }) => (
    <li class="flex">
      <GlareCard class="flex w-full flex-col border border-border bg-card p-8">
        <Icon class="size-7 text-foreground" stroke-width={1.5} aria-hidden="true" />
        <h3 class="mt-10 text-xl font-medium tracking-[-0.02em]">{title}</h3>
        <p class="mt-2 text-base text-muted-foreground">{text}</p>
      </GlareCard>
    </li>
  ))}
</ul>
