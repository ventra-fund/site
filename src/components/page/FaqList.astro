---
// Questions as an accordion. Closed answers use hidden="until-found", so they stay in the page and
// the browser's find-in-page still reaches (and opens) them.
import ChevronDown from "@lucide/astro/icons/chevron-down";
import type { Faq } from "@/data/faqs";
import { Accordion, AccordionItem, AccordionTrigger, AccordionContent } from "@/ui/accordion";
import ProsCons from "./ProsCons.astro";

interface Props {
  items: Faq[];
}

const { items } = Astro.props;
---

<Accordion multiple data-hidden-until-found class="border-t border-border">
  {items.map((faq, i) => (
    <AccordionItem value={`faq-${i}`} class="border-border">
      <AccordionTrigger class="items-center gap-6 py-5 text-lg font-semibold text-foreground hover:no-underline **:data-[slot=accordion-trigger-icon]:size-5 **:data-[slot=accordion-trigger-icon]:text-foreground">
        {faq.q}
        <ChevronDown slot="icon" class="size-5 transition-transform group-aria-expanded/accordion-trigger:rotate-180" aria-hidden="true" />
      </AccordionTrigger>
      <AccordionContent class="flex max-w-3xl flex-col gap-4 pb-6 text-base text-muted-foreground [&_p:not(:last-child)]:mb-0">
        {faq.a.map((p) => <p>{p}</p>)}
        {faq.list && <ul class="list-disc pl-5">{faq.list.map((li) => <li>{li}</li>)}</ul>}
        {faq.pros && faq.cons && <ProsCons pros={faq.pros} cons={faq.cons} />}
      </AccordionContent>
    </AccordionItem>
  ))}
</Accordion>
