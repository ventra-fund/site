---
// Ticked list. Items are plain strings, or a bold lead-in with text after it.
import CircleCheck from "@lucide/astro/icons/circle-check";

interface Props {
  items: (string | { title: string; text: string })[];
  columns?: 1 | 2;
}

const { items, columns = 1 } = Astro.props;
---

<ul class:list={["grid list-none grid-cols-1 gap-x-10 gap-y-4", columns === 2 && "md:grid-cols-2"]}>
  {items.map((item) => (
    <li class="flex gap-3 text-base text-foreground">
      <CircleCheck class="mt-0.5 size-5 shrink-0 text-primary" aria-hidden="true" />
      {typeof item === "string"
        ? <span>{item}</span>
        : <span><strong class="font-semibold">{item.title}.</strong> <span class="text-muted-foreground">{item.text}</span></span>}
    </li>
  ))}
</ul>
