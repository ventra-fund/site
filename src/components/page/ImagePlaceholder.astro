---
// Stand-in for a photo or illustration that hasn't been sourced yet. `label` says what belongs here,
// so swapping in the real <Image> later is a find-and-replace on this component.
import { cn } from "@/lib/utils";
import ImageIcon from "@lucide/astro/icons/image";

interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<div role="img" aria-label={`Placeholder: ${label}`} class={cn("flex aspect-4/3 w-full flex-col items-center justify-center gap-2 bg-muted p-6 text-center text-sm text-muted-foreground", className)}>
  <ImageIcon class="size-8" stroke-width={1.5} aria-hidden="true" />
  <span class="max-w-xs">{label}</span>
</div>
