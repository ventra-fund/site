---
// Two-column "them vs us" comparison, one row per factor. Stacks into cards on narrow screens.
interface Props {
  them: string;
  us?: string;
  rows: { label: string; them: string; us: string }[];
}

const { them, us = "Ventra Fund", rows } = Astro.props;
---

<div class="overflow-hidden border border-border">
  <div class="hidden grid-cols-[1fr_2fr_2fr] bg-secondary text-sm font-semibold uppercase tracking-widest text-muted-foreground md:grid">
    <span class="p-4"></span>
    <span class="p-4">{them}</span>
    <span class="p-4 text-accent">{us}</span>
  </div>
  {rows.map((row) => (
    <div class="grid grid-cols-1 border-t border-border first:border-t-0 md:grid-cols-[1fr_2fr_2fr] md:first:border-t">
      <span class="p-4 pb-0 font-semibold text-foreground md:pb-4">{row.label}</span>
      <p class="p-4 pb-2 text-muted-foreground md:pb-4"><span class="font-semibold md:hidden">{them}: </span>{row.them}</p>
      <p class="p-4 pt-0 text-foreground md:pt-4"><span class="font-semibold text-accent md:hidden">{us}: </span>{row.us}</p>
    </div>
  ))}
</div>
