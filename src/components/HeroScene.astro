---
// The home page hero's backdrop: a CSS sky that paints with the page, and the 3D scene
// (src/lib/hero-scene) fading in over it once the page has finished loading. Goes inside a
// `relative isolate` section; the hero copy must carry `data-hero-copy` so the stage can be framed
// in the space it leaves free.
//
// The backdrop runs --hero-bleed past the bottom of the hero, over the top of the next section, where
// the scene's fog bank thins out into the page's white (src/lib/hero-scene/fog.ts). So the hero must
// not clip vertically, and the next section must be positioned to paint over it.
//
// Data Saver, browsers without WebGL 2 and any failure keep the CSS sky. Reduced motion gets the
// scene as a still frame.
---

<div class="hero-scene pointer-events-none absolute inset-x-0 top-0 -z-10" data-hero-scene aria-hidden="true">
  <div class="wash wash-top"></div>
  <div class="wash wash-left"></div>
  <div class="wash wash-bottom"></div>
</div>

<style>
  .hero-scene {
    --hero-bleed: clamp(7rem, 22svh, 13rem);
    bottom: calc(-1 * var(--hero-bleed));
    overflow: hidden; /* see the canvas */
    /* Stand-in for the 3D sky until it fades in (and for good where it never does): the sky, then a
       few white puffs along the hero's bottom edge over a fade to the page's white. */
    background:
      radial-gradient(36% calc(var(--hero-bleed) * 0.8) at 12% calc(100% - var(--hero-bleed) * 0.8), #fff 25%, rgb(255 255 255 / 0)),
      radial-gradient(30% calc(var(--hero-bleed) * 0.65) at 50% calc(100% - var(--hero-bleed) * 0.9), #fff 25%, rgb(255 255 255 / 0)),
      radial-gradient(40% calc(var(--hero-bleed) * 0.85) at 90% calc(100% - var(--hero-bleed) * 0.75), #fff 25%, rgb(255 255 255 / 0)),
      linear-gradient(to top, #fff calc(var(--hero-bleed) * 0.5), rgb(255 255 255 / 0) calc(var(--hero-bleed) * 1.5)),
      linear-gradient(to top, rgb(209 234 243 / 0.95) var(--hero-bleed), rgb(209 234 243 / 0) calc(var(--hero-bleed) + 36%)),
      linear-gradient(to right, #d0e8f1, #a1d5e8 40%, #7ccbe6);
  }
  /* A few px taller than the backdrop, which clips them: browsers can blend a faint grey into the last
     row of an upscaled canvas, and that row would draw a line across the white below the hero. */
  .hero-scene :global(canvas) {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 100%;
    height: calc(100% + 4px);
    opacity: 0;
    transition: opacity 0.9s ease-out;
  }
  .hero-scene[data-ready] :global(canvas) {
    opacity: 1;
  }

  /* Legibility washes between the scene and the copy. */
  .wash {
    position: absolute;
  }
  .wash-top {
    inset-inline: 0;
    top: 0;
    height: 7rem;
    background: linear-gradient(rgb(212 234 242 / 0.6), rgb(212 234 242 / 0));
  }
  .wash-left {
    top: 0;
    bottom: var(--hero-bleed);
    left: 0;
    width: 55%;
    background: linear-gradient(to right, #d4eaf2, rgb(212 234 242 / 0.85) 35%, rgb(212 234 242 / 0));
    /* giving way to the fog bank toward the bottom of the hero */
    -webkit-mask-image: linear-gradient(#000 55%, transparent 95%);
    mask-image: linear-gradient(#000 55%, transparent 95%);
  }
  .wash-bottom {
    display: none;
  }
  /* Same breakpoint as src/lib/hero-scene/scene.ts (STACKED): the copy moves under the stage. */
  @media (max-aspect-ratio: 9/10) {
    .wash-left {
      display: none;
    }
    .wash-bottom {
      display: block;
      inset-inline: 0;
      bottom: 0;
      height: calc(60% + 0.4 * var(--hero-bleed)); /* 60% of the hero, plus the overreach */
      background: linear-gradient(rgb(212 234 242 / 0), rgb(212 234 242 / 0.82) 30%, #d4eaf2 calc(100% - var(--hero-bleed)), #fff);
      transition: opacity 0.9s ease-out;
    }
    /* Once the scene is up, the copy sits in its fog bank instead. */
    .hero-scene[data-ready] .wash-bottom {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scene :global(canvas),
    .wash-bottom {
      transition: none;
    }
  }
</style>

<script>
  import logoUrl from "@/assets/hero/vf-logo.glb?url";

  const root = document.querySelector<HTMLElement>("[data-hero-scene]");
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;

  if (root && !saveData && "WebGL2RenderingContext" in window) {
    const start = () => {
      // The model and the scene code download in parallel.
      const logo = fetch(logoUrl).then((response) => {
        if (!response.ok) throw new Error(`${logoUrl}: HTTP ${response.status}`);
        return response.arrayBuffer();
      });
      logo.catch(() => {}); // surfaced through mountHeroScene, which awaits it
      import("@/lib/hero-scene/scene")
        .then(({ mountHeroScene }) =>
          mountHeroScene({
            root,
            copy: document.querySelector<HTMLElement>("[data-hero-copy]"),
            logo,
            reducedMotion: window.matchMedia("(prefers-reduced-motion: reduce)").matches,
          }),
        )
        .catch((error) => console.error("Hero scene failed to start:", error));
    };
    // After the load event and an idle moment, so three.js never competes with the page itself.
    const whenIdle = () =>
      "requestIdleCallback" in window ? requestIdleCallback(start, { timeout: 2000 }) : setTimeout(start, 200);
    if (document.readyState === "complete") whenIdle();
    else window.addEventListener("load", whenIdle, { once: true });
  }
</script>
