---
import { LinkGroup, LinkGroupTitle, LinkGroupList, LinkGroupItem } from '@/ui/link-group';
import Instagram from "@/components/Instagram.astro";
import Facebook from "@/components/Facebook.astro";
import LinkedIn from "@/components/LinkedIn.astro";
---

<footer class="py-20 md:py-28">
  <div class="mx-auto w-[calc(100%-2rem)] md:w-[calc(100%-8rem)] flex flex-col gap-16 sm:flex-row sm:flex-wrap lg:flex-nowrap">
    <LinkGroup>
      <LinkGroupTitle>Company</LinkGroupTitle>
      <LinkGroupList>
        <LinkGroupItem><a href="/">Home</a></LinkGroupItem>
        <LinkGroupItem><a href="/contact">Contact</a></LinkGroupItem>
        <LinkGroupItem><a href="/partner">Partner</a></LinkGroupItem>
      </LinkGroupList>
    </LinkGroup>
    <LinkGroup>
      <LinkGroupTitle>Capital</LinkGroupTitle>
      <LinkGroupList>
        <LinkGroupItem><a href="/apply">Apply</a></LinkGroupItem>
        <LinkGroupItem><a href="/capital">Overview</a></LinkGroupItem>
      </LinkGroupList>
    </LinkGroup>
    <LinkGroup>
      <LinkGroupTitle>Social</LinkGroupTitle>
      <LinkGroupList>
        <LinkGroupItem><a href="#" class="inline-flex items-center gap-2"><Instagram class="size-5 shrink-0" />Instagram</a></LinkGroupItem>
        <LinkGroupItem><a href="#" class="inline-flex items-center gap-2"><Facebook class="size-5 shrink-0" />Facebook</a></LinkGroupItem>
        <LinkGroupItem><a href="#" class="inline-flex items-center gap-2"><LinkedIn class="size-5 shrink-0" />LinkedIn</a></LinkGroupItem>
      </LinkGroupList>
    </LinkGroup>
    <LinkGroup>
      <LinkGroupTitle>Legal</LinkGroupTitle>
      <LinkGroupList>
        <LinkGroupItem><a href="/privacy">Privacy</a></LinkGroupItem>
        <LinkGroupItem><a href="/terms">Terms</a></LinkGroupItem>
      </LinkGroupList>
    </LinkGroup>
    <div class="w-full">
      <!-- VF mark with the hero's grainy gradient: the gradient-filled mark, then the same shape filled with the grain tile and overlay-blended on top -->
      <svg class="isolate h-auto w-full max-w-md" viewBox="0 0 1192 713" role="img" aria-label="Ventra Fund" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="wordmark-gradient" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" style="stop-color: var(--chart-2); stop-color: oklch(from var(--chart-1) calc(l * 0.7) c h)" />
            <stop offset="1" style="stop-color: var(--chart-5); stop-color: oklch(from var(--chart-4) calc(l * 0.5) c h)" />
          </linearGradient>
          <pattern id="wordmark-grain" patternUnits="userSpaceOnUse" width="440" height="440">
            <image href="/textures/grain.png" width="440" height="440" />
          </pattern>
          <g id="wordmark">
          <path d="M0 0 L233 0 L381.68 362.64 L563 0 L1192 0 L1161.5 61 L599.5 61 L370.66 518.68 L183.01 61 L100.01 61 L342.32 652 L388 652 L646.5 135 L1144.5 135 L1046 332 L771 332 L734.5 405 L1009.5 405 L918.5 587 L643.5 587 L580.5 713 L509.5 713 L603 526 L879 526 L909 466 L633 466 L730.5 271 L1006.5 271 L1044 196 L693 196 L434.5 713 L292.33 713 Z" />
          </g>
        </defs>
        <use href="#wordmark" fill="url(#wordmark-gradient)" />
        <use href="#wordmark" fill="url(#wordmark-grain)" opacity="0.6" style="mix-blend-mode: overlay" />
      </svg>
    </div>
    <p class="w-full text-sm text-muted-foreground">© {new Date().getFullYear()} Ventra Fund</p>
  </div>
</footer>
