---
import { LinkGroup, LinkGroupTitle, LinkGroupList, LinkGroupItem } from '@/ui/link-group';
import Instagram from "@/components/Instagram.astro";
import Facebook from "@/components/Facebook.astro";
import LinkedIn from "@/components/LinkedIn.astro";
---

<footer class="pb-15">
  <div class="mx-auto w-[calc(100%-2rem)] md:w-[calc(100%-8rem)] flex flex-col gap-16">
    <!-- The V's top bar spans the full width; at lg the links sit under it, right of the mark. Everything is sized from the mark's height (--mark-h) in viewBox units (1192 × 713, bar 61 tall) -->
    <div class="relative flex flex-col gap-16 [--mark-h:5rem] lg:block lg:min-h-(--mark-h) lg:[--mark-h:15rem]">
      <div class="relative h-(--mark-h) w-full lg:absolute lg:inset-x-0 lg:top-0">
        <!-- VF mark with the hero's grainy gradient: the gradient-filled mark, then the same shape filled with the grain tile and overlay-blended on top.
             The mark sits at the box's left; the V's top bar runs on to the box's right edge, where a right-aligned mask cuts its slanted end back in. -->
        <svg class="isolate absolute inset-0 size-full" role="img" aria-label="Ventra Fund" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="wordmark-gradient" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" style="stop-color: var(--chart-2); stop-color: oklch(from var(--chart-1) calc(l * 0.7) c h)" />
              <stop offset="1" style="stop-color: var(--chart-5); stop-color: oklch(from var(--chart-4) calc(l * 0.5) c h)" />
            </linearGradient>
            <pattern id="wordmark-grain" patternUnits="userSpaceOnUse" width="440" height="440">
              <image href="/textures/grain.png" width="440" height="440" />
            </pattern>
            <g id="wordmark">
            <path d="M0 0 L233 0 L381.68 362.64 L563 0 L100000 0 L100000 61 L599.5 61 L370.66 518.68 L183.01 61 L100.01 61 L342.32 652 L388 652 L646.5 135 L1144.5 135 L1046 332 L771 332 L734.5 405 L1009.5 405 L918.5 587 L643.5 587 L580.5 713 L509.5 713 L603 526 L879 526 L909 466 L633 466 L730.5 271 L1006.5 271 L1044 196 L693 196 L434.5 713 L292.33 713 Z" />
            </g>
            <mask id="wordmark-bar-end" maskUnits="userSpaceOnUse" x="0" y="0" width="100%" height="100%">
              <rect width="100%" height="100%" fill="white" />
              <svg width="100%" height="100%" viewBox="0 0 1192 713" preserveAspectRatio="xMaxYMid meet" overflow="visible">
                <path d="M1192 -1 L2000 -1 L2000 62 L1161.5 62 L1161.5 61 Z" fill="black" />
              </svg>
            </mask>
          </defs>
          <g mask="url(#wordmark-bar-end)">
            <svg width="100%" height="100%" viewBox="0 0 1192 713" preserveAspectRatio="xMinYMid meet" overflow="visible">
              <use href="#wordmark" fill="url(#wordmark-gradient)" />
              <use href="#wordmark" fill="url(#wordmark-grain)" opacity="0.6" style="mix-blend-mode: overlay" />
            </svg>
          </g>
        </svg>
      </div>
      <div class="relative flex flex-col gap-16 sm:flex-row sm:flex-wrap lg:flex-nowrap lg:pl-[calc(var(--mark-h)*1192/713_+_2rem)] lg:pt-[calc(var(--mark-h)*61/713_+_1.5rem)]">
        <LinkGroup>
          <LinkGroupTitle>Company</LinkGroupTitle>
          <LinkGroupList>
            <LinkGroupItem><a href="/">Home</a></LinkGroupItem>
            <LinkGroupItem><a href="/contact">Contact</a></LinkGroupItem>
            <LinkGroupItem><a href="/partner">Partner</a></LinkGroupItem>
            <LinkGroupItem><a href="/privacy">Privacy</a></LinkGroupItem>
            <LinkGroupItem><a href="/terms">Terms</a></LinkGroupItem>
          </LinkGroupList>
        </LinkGroup>
        <LinkGroup>
          <LinkGroupTitle>Capital</LinkGroupTitle>
          <LinkGroupList>
            <LinkGroupItem><a href="/apply">Apply</a></LinkGroupItem>
            <LinkGroupItem><a href="/capital">Overview</a></LinkGroupItem>
          </LinkGroupList>
        </LinkGroup>
        <LinkGroup>
          <LinkGroupTitle>Social</LinkGroupTitle>
          <LinkGroupList>
            <LinkGroupItem><a href="#" class="inline-flex items-center gap-2"><Instagram class="size-5 shrink-0" />Instagram</a></LinkGroupItem>
            <LinkGroupItem><a href="#" class="inline-flex items-center gap-2"><Facebook class="size-5 shrink-0" />Facebook</a></LinkGroupItem>
            <LinkGroupItem><a href="#" class="inline-flex items-center gap-2"><LinkedIn class="size-5 shrink-0" />LinkedIn</a></LinkGroupItem>
          </LinkGroupList>
        </LinkGroup>
      </div>
    </div>
    <p class="w-full text-sm text-muted-foreground">© {new Date().getFullYear()} Ventra Fund</p>
  </div>
</footer>

