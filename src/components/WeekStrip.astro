---
// A Mon–Sun row of day cells with the given days filled. Decorative: the card it sits in states the
// days in text, so it's hidden from assistive tech. (After the same strip on Main Capital's site.)
import { DAYS, type Day } from "@/data/iso-program";

interface Props {
  active: Day[];
  class?: string;
}

const { active, class: className } = Astro.props;
---

<ol class:list={["grid list-none grid-cols-7 gap-2 text-sm", className]} aria-hidden="true">
  {DAYS.map((day) => (
    <li
      class:list={[
        "border py-3 text-center",
        active.includes(day) ? "border-foreground bg-foreground text-background" : "border-border text-muted-foreground",
      ]}
    >
      <span class="lg:hidden">{day[0]}</span>
      <span class="hidden lg:inline">{day}</span>
    </li>
  ))}
</ol>
