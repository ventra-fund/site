---
import { Button } from "@/ui/button";
import { LayoutDashboard, FolderKanban, FilePlus, Calculator, ScrollText, Library, Users, Code2, Settings, LifeBuoy, Menu } from "@lucide/astro";
import { org, currentUser } from "@/data/portal-fixtures";

// The portal's sidebar: where you are, the organisation you're acting for, and who you are.
// Prototype: the org switcher and user menu are static. On phones it collapses to a top bar with
// a disclosure button (src/lib/portal/nav.ts).
export type PartnerNavKey = "dashboard" | "deals" | "submit" | "calculator" | "terms" | "resources" | "team" | "developers" | "settings" | "help";

interface Props {
  current: PartnerNavKey;
}

const { current } = Astro.props;

const groups: { label?: string; links: { key: PartnerNavKey; href: string; label: string; Icon: typeof LayoutDashboard }[] }[] = [
  {
    links: [
      { key: "dashboard", href: "/partner/dashboard", label: "Dashboard", Icon: LayoutDashboard },
      { key: "deals", href: "/partner/deals", label: "Deals", Icon: FolderKanban },
      { key: "submit", href: "/partner/submit", label: "Submit a deal", Icon: FilePlus },
    ],
  },
  {
    label: "Pricing",
    links: [
      { key: "calculator", href: "/partner/calculator", label: "Commission calculator", Icon: Calculator },
      { key: "terms", href: "/partner/terms", label: "Partner terms", Icon: ScrollText },
      { key: "resources", href: "/partner/resources", label: "Resources", Icon: Library },
    ],
  },
  {
    label: "Organisation",
    links: [
      { key: "team", href: "/partner/team", label: "Team", Icon: Users },
      { key: "developers", href: "/partner/developers", label: "Developers", Icon: Code2 },
      { key: "settings", href: "/partner/settings", label: "Settings", Icon: Settings },
      { key: "help", href: "/partner/help", label: "Help", Icon: LifeBuoy },
    ],
  },
];

const initials = currentUser.name.split(" ").map((p) => p[0]).join("").slice(0, 2);
---

<aside data-partner-nav class="flex flex-col border-b border-border bg-sidebar text-sidebar-foreground lg:sticky lg:top-0 lg:h-screen lg:w-64 lg:shrink-0 lg:border-r lg:border-b-0">
  <div class="flex items-center justify-between gap-3 px-4 py-3 lg:px-5 lg:py-5">
    <a href="/partner/dashboard" class="flex items-center gap-2 font-semibold">
      <span class="grid size-7 place-items-center bg-primary text-xs font-bold text-primary-foreground">VF</span>
      <span>Partner portal</span>
    </a>
    <Button variant="ghost" size="icon-sm" class="lg:hidden" data-nav-toggle aria-expanded="false" aria-controls="partner-nav-panel" aria-label="Menu">
      <Menu class="size-5" aria-hidden="true" />
    </Button>
  </div>

  <div id="partner-nav-panel" data-nav-panel hidden class="flex flex-col gap-6 px-3 pb-4 lg:flex lg:flex-1 lg:px-3 lg:pb-5">
    {/* Organisation switcher. One org per user in the prototype; the real one lists memberships. */}
    <button type="button" class="flex w-full flex-col items-start gap-0.5 border border-sidebar-border bg-background px-3 py-2 text-left text-sm hover:bg-sidebar-accent" aria-label="Switch organisation" title="Switch organisation">
      <span class="text-xs text-muted-foreground">Organisation</span>
      <span class="font-medium">{org.name}</span>
    </button>

    <nav class="flex flex-1 flex-col gap-5" aria-label="Portal">
      {groups.map((g) => (
        <div class="flex flex-col gap-1">
          {g.label && <p class="px-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">{g.label}</p>}
          {g.links.map(({ key, href, label, Icon }) => (
            <a
              href={href}
              aria-current={key === current ? "page" : undefined}
              class:list={[
                "flex items-center gap-2.5 px-3 py-2 text-sm",
                key === current ? "bg-sidebar-accent font-medium text-sidebar-accent-foreground" : "text-muted-foreground hover:bg-sidebar-accent/60 hover:text-foreground",
              ]}
            >
              <Icon class="size-4 shrink-0" aria-hidden="true" />
              {label}
            </a>
          ))}
        </div>
      ))}
    </nav>

    <div class="flex items-center gap-3 border-t border-sidebar-border pt-4 text-sm">
      <span class="grid size-8 shrink-0 place-items-center bg-muted text-xs font-semibold" aria-hidden="true">{initials}</span>
      <div class="min-w-0 flex-1">
        <p class="truncate font-medium">{currentUser.name}</p>
        <p class="truncate text-xs text-muted-foreground">{currentUser.email}</p>
      </div>
      <a href="/partner/login" class="text-xs text-muted-foreground hover:text-foreground">Sign out</a>
    </div>
  </div>
</aside>

<script>
  import "@/lib/portal/nav";
</script>
