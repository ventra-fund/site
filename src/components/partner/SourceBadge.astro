---
import { SOURCE_LABEL, type DealSource } from "@/data/portal-fixtures";
import { Globe, Mail, Code2 } from "@lucide/astro";

// How a deal came in. The three intake channels share one pipeline, so the badge is the only
// place the channel shows.
interface Props {
  source: DealSource;
}

const { source } = Astro.props;
const Icon = source === "email" ? Mail : source === "api" ? Code2 : Globe;
---

<span class="inline-flex items-center gap-1 whitespace-nowrap text-xs text-muted-foreground" title={`Submitted via ${SOURCE_LABEL[source]}`}>
  <Icon class="size-3.5" aria-hidden="true" />
  {SOURCE_LABEL[source]}
</span>
