---
import { DEAL_STATUS, type DealStatus } from "@/data/portal-fixtures";

interface Props {
  status: DealStatus;
  class?: string;
}

const { status, class: className } = Astro.props;
const { label, tone, help } = DEAL_STATUS[status];
const tones = {
  neutral: "bg-muted text-muted-foreground",
  info: "bg-primary/10 text-primary dark:text-chart-1",
  warning: "bg-amber-500/15 text-amber-700 dark:text-amber-300",
  success: "bg-emerald-500/15 text-emerald-700 dark:text-emerald-300",
  danger: "bg-destructive/10 text-destructive",
};
---

<span class:list={["inline-flex items-center whitespace-nowrap px-2 py-0.5 text-xs font-medium", tones[tone], className]} title={help}>{label}</span>
