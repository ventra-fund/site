---
// One contact detail behind the anti-scrape reveal (docs/contact-reveal.md). The page never holds
// the value: "Show" passes Turnstile and asks /api/contact/reveal for vector outlines, drawn here on a
// canvas in the surrounding text's size and colour. The same response carries the text, held only in
// this script's memory, so Copy / Call need no second check. Multi-instance: every [data-contact-reveal] on the page is wired by
// the one bundled script below. Turnstile loads on the first click, not with the page, and lives in a
// popover anchored to the detail, which opens for "Checking…" and any challenge that needs a person.
import Turnstile from '@/components/Turnstile.astro';
import { CONTACT_META, type ContactKey } from '@/lib/contact/keys';
import Copy from '@lucide/astro/icons/copy';
import Mail from '@lucide/astro/icons/mail';
import Phone from '@lucide/astro/icons/phone';

interface Props {
  contact: ContactKey;
  class?: string;
}

const { contact, class: className } = Astro.props;
const meta = CONTACT_META[contact];
const noun = meta.kind === 'email' ? 'email address' : 'phone number';
const btn = 'inline-flex items-center gap-1 rounded-md px-1.5 py-0.5 text-sm text-muted-foreground hover:text-foreground hover:bg-secondary transition-colors disabled:opacity-50';
---

<span data-contact-reveal data-contact={contact}
  class:list={['inline', className]}>
  <!-- Inline and inheriting font and colour, so "Show number" reads as part of the sentence or link row it sits in. -->
  <button type="button" data-cr-show class="inline cursor-pointer p-0 [font:inherit] text-inherit underline decoration-dotted underline-offset-4 hover:decoration-solid disabled:opacity-50" aria-label={`Show our ${noun}`}>
    Show {meta.kind === 'email' ? 'email' : 'number'}
  </button>
  <canvas data-cr-canvas hidden class="inline" role="img" aria-label={`Our ${noun}, shown as an image. Use the buttons beside it to copy it or ${meta.kind === 'email' ? 'write to us' : 'call'}.`}></canvas>
  <span data-cr-actions hidden class="ml-2 inline-flex items-center gap-1 align-middle">
    <button type="button" data-cr-copy class={btn} aria-label={`Copy ${noun}`}><Copy size={14} aria-hidden="true" /> Copy</button>
    {meta.kind === 'email'
      ? <button type="button" data-cr-open class={btn} aria-label="Write an email"><Mail size={14} aria-hidden="true" /> Email</button>
      : <button type="button" data-cr-open class={btn} aria-label="Call this number"><Phone size={14} aria-hidden="true" /> Call</button>}
  </span>
  <span data-cr-note role="status" class="ml-2 text-sm text-muted-foreground" hidden></span>
  <!-- Native popover, not @/ui/popover: that one moves its panel to <body> on open, and moving the
       Turnstile iframe reloads it, losing its token. The top layer also clears the fixed site nav.
       Positioned by the script below; `display` only while open, so the UA's closed display:none wins. -->
  <span data-cr-popover popover="auto"
    class="inset-auto m-0 w-max max-w-[min(22rem,calc(100vw-1rem))] flex-col gap-3 rounded-lg bg-popover p-4 text-left text-sm font-normal leading-normal text-popover-foreground shadow-md ring-1 ring-foreground/10 [&:popover-open]:flex">
    <span data-cr-status role="status" class="text-muted-foreground">Checking…</span>
    <Turnstile action="contact-reveal" class="block empty:hidden" />
  </span>
</span>

<script>
  import { awaitTurnstileToken, refreshTurnstile, TURNSTILE_UNAVAILABLE_MESSAGE } from '@/lib/turnstile';

  interface Outline { d: string; width: number; height: number; baseline: number; unitsPerEm: number }

  interface Revealed { outline: Outline; text: string; href: string }

  async function reveal(key: string, token: string): Promise<Revealed> {
    const res = await fetch('/api/contact/reveal', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ key, token }),
    });
    // A WAF challenge (no pre-clearance cookie) answers with an HTML page, not JSON.
    const data = await res.json().catch(() => null) as { outline?: Outline; text?: string; href?: string; error?: string } | null;
    if (!res.ok || !data?.outline || !data.text || !data.href) throw new Error(data?.error ?? `http_${res.status}`);
    return data as Revealed;
  }

  function draw(canvas: HTMLCanvasElement, outline: Outline) {
    // The canvas inherits the surrounding text's size and colour like any inline element.
    const style = getComputedStyle(canvas);
    const fontSize = parseFloat(style.fontSize) || 16;
    const scale = fontSize / outline.unitsPerEm;
    const dpr = window.devicePixelRatio || 1;
    const w = Math.ceil(outline.width * scale);
    const h = Math.ceil(outline.height * scale);
    canvas.width = Math.ceil(w * dpr);
    canvas.height = Math.ceil(h * dpr);
    canvas.style.width = `${w}px`;
    canvas.style.height = `${h}px`;
    // Sit the drawn baseline on the text's baseline: an inline replaced element's bottom edge rests on
    // the baseline, so drop it by the outline's descent.
    canvas.style.verticalAlign = `${-((outline.height - outline.baseline) * scale)}px`;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    ctx.setTransform(dpr * scale, 0, 0, dpr * scale, 0, 0);
    ctx.clearRect(0, 0, outline.width, outline.height);
    ctx.fillStyle = style.color;
    ctx.fill(new Path2D(outline.d));
  }

  function messageFor(err: unknown): string {
    const code = String((err as Error)?.message);
    if (code === 'too_many_requests') return 'Too many requests. Try again in a minute.';
    if (code === 'not_configured') return "This isn't available right now. Please send us a message instead.";
    if (code === 'Turnstile script failed to load') return TURNSTILE_UNAVAILABLE_MESSAGE;
    return 'Could not verify. Please try again.';
  }

  // Below the detail, left edges aligned, kept inside the viewport; above it when there's no room below.
  function place(popover: HTMLElement, anchor: HTMLElement) {
    const gap = 8;
    const a = anchor.getBoundingClientRect();
    const { offsetWidth: w, offsetHeight: h } = popover;
    const left = Math.min(Math.max(gap, a.left), window.innerWidth - w - gap);
    const below = a.bottom + gap;
    const top = below + h > window.innerHeight - gap && a.top - gap - h >= gap ? a.top - gap - h : below;
    popover.style.position = 'fixed';
    popover.style.left = `${Math.max(gap, left)}px`;
    popover.style.top = `${top}px`;
  }

  function init(root: HTMLElement) {
    const key = root.dataset.contact!;
    const showBtn = root.querySelector<HTMLButtonElement>('[data-cr-show]')!;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-cr-canvas]')!;
    const actions = root.querySelector<HTMLElement>('[data-cr-actions]')!;
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-cr-copy]')!;
    const openBtn = root.querySelector<HTMLButtonElement>('[data-cr-open]')!;
    const note = root.querySelector<HTMLElement>('[data-cr-note]')!;
    const popover = root.querySelector<HTMLElement>('[data-cr-popover]')!;
    const status = popover.querySelector<HTMLElement>('[data-cr-status]')!;
    const widget = popover.querySelector('turnstile-widget')!;
    // Set once Show succeeds; never written to the DOM.
    let revealed: Revealed | null = null;
    let busy = false;

    const reposition = () => place(popover, root);
    // The Turnstile widget grows when it shows a challenge, so follow its size as well as scrolling.
    const resizes = new ResizeObserver(reposition);
    popover.addEventListener('toggle', (event) => {
      if ((event as ToggleEvent).newState === 'open') {
        reposition();
        resizes.observe(popover);
        window.addEventListener('scroll', reposition, { passive: true });
        window.addEventListener('resize', reposition);
      } else {
        resizes.disconnect();
        window.removeEventListener('scroll', reposition);
        window.removeEventListener('resize', reposition);
      }
    });
    const openPopover = (msg: string) => {
      status.textContent = msg;
      if (!popover.matches(':popover-open')) popover.showPopover();
    };
    const closePopover = () => { if (popover.matches(':popover-open')) popover.hidePopover(); };
    // Errors stay up in the popover, where the visitor was looking, until dismissed.
    const fail = (err: unknown) => openPopover(messageFor(err));
    const flash = (msg: string) => {
      note.textContent = msg;
      note.hidden = false;
      setTimeout(() => { note.hidden = true; }, 2000);
    };


    showBtn.addEventListener('click', async () => {
      // Dismissing the popover doesn't cancel a check in progress; a second click brings it back.
      if (busy) return openPopover(status.textContent || 'Checking…');
      busy = true;
      openPopover('Checking…');
      try {
        const token = await awaitTurnstileToken(widget);
        closePopover();
        try {
          revealed = await reveal(key, token);
        } catch (err) {
          // The token is spent; start solving a fresh one for the retry.
          refreshTurnstile(widget);
          throw err;
        }
        draw(canvas, revealed.outline);
        showBtn.hidden = true;
        canvas.hidden = false;
        actions.hidden = false;
      } catch (err) {
        fail(err);
      } finally {
        busy = false;
      }
    });

    copyBtn.addEventListener('click', async () => {
      if (!revealed) return;
      try {
        await navigator.clipboard.writeText(revealed.text);
        flash('Copied.');
      } catch {
        flash("Couldn't copy. Please try again.");
      }
    });

    openBtn.addEventListener('click', () => {
      if (revealed) window.location.href = revealed.href;
    });

    // Redraw in the new text colour when the theme flips.
    new MutationObserver(() => { if (revealed) draw(canvas, revealed.outline); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  }

  document.querySelectorAll<HTMLElement>('[data-contact-reveal]').forEach(init);
</script>
