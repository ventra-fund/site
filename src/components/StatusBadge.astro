---
import type { DraftStatus } from "@/lib/server/drafts";

// Whether an /apply session was submitted, as shown on the drop-off pages.
interface Props {
  status: DraftStatus;
}

const { status } = Astro.props;
---

<span class={`rounded px-2 py-0.5 text-xs font-medium ${status === "converted" ? "bg-accent/15 text-accent" : "bg-muted text-muted-foreground"}`}>
  {status === "converted" ? "Submitted" : "Unsubmitted"}
</span>
