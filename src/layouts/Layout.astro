---
import "@/styles/globals.css";
import { Font } from "astro:assets";
import SiteNav from "@/components/SiteNav.astro";

interface Props {
  /** Page-specific part of the <title>; the site name is appended. Omit on the home page. */
  title?: string;
  /** Keep the page out of search results (the admin pages). */
  noindex?: boolean;
}

const { title, noindex = false } = Astro.props;
const SITE_NAME = "Ventra Fund";
const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;

// Trailing-slash-insensitive, like the nav's own current-page check.
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
// The admin pages and the signing page stand apart from the public site: no nav.
const showNav = !/^\/(admin|sign)(\/|$)/.test(currentPath);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- bejamas:astro-fonts:start -->
    <!-- Weights/styles are restricted on purpose; see the FONT WEIGHTS note in astro.config.mjs. -->
    <Font cssVariable="--font-sans" preload />
    <!-- bejamas:astro-fonts:end -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body>
    {showNav && <SiteNav />}
    <slot />
  </body>
</html>
