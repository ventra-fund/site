---
import "@/styles/globals.css";
import { Font } from "astro:assets";
import SiteNav from "@/components/SiteNav.astro";

interface Props {
  /** Page-specific part of the <title>; the site name is appended. Omit on the home page. */
  title?: string;
  /** Keep the page out of search results (the admin pages). */
  noindex?: boolean;
}

const { title, noindex = false } = Astro.props;
const SITE_NAME = "Ventra Fund";
const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
// Every page shares one link-preview image; scripts/og-image.html is its source. Scrapers need an absolute
// URL, which comes from `site` in astro.config.mjs.
const ogImage = new URL("/og-image.jpg", Astro.site ?? Astro.url).href;

// Trailing-slash-insensitive, like the nav's own current-page check.
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
// The admin pages, the signing page and the partner portal (/partner/<page>, not the public
// /partner inquiry page) stand apart from the public site: no nav.
const showNav = !/^\/(admin|sign)(\/|$)|^\/partner\//.test(currentPath);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- bejamas:astro-fonts:start -->
    <!-- Weights/styles are restricted on purpose; see the FONT WEIGHTS note in astro.config.mjs. -->
    <Font cssVariable="--font-sans" preload />
    <!-- bejamas:astro-fonts:end -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{pageTitle}</title>
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ventra Fund. Working capital. Built for growth." />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    {showNav && <SiteNav />}
    <slot />
  </body>
</html>
