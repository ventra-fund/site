---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";

interface Props extends HTMLAttributes<"div"> {
  class?: string;
}

const { class: className = "", ...rest } = Astro.props as Props;

// The sliding pill behind the hovered, focused or open item; the items draw no background of their own
// (SiteHeader). It sits under the items (-z-1 inside the list's isolate), so it doesn't grey out their labels.
// It fades with an opacity transition rather than enter/exit keyframes: the exit keyframe faded to the
// already-hidden opacity, so the pill vanished at once, and the enter keyframe restarted from 0 on every
// re-show. data-instant (set by the library when the pill appears) turns off only the slide, not the fade.
---

<div
  {...rest}
  data-slot="navigation-menu-indicator"
  class={cn(
    "rounded-3xl absolute left-0 top-0 -z-1 pointer-events-none opacity-0 transition-[translate,width,height,opacity] duration-150 ease data-instant:transition-[opacity] data-[state=visible]:opacity-100",
    "translate-x-(--indicator-left,0px) translate-y-(--indicator-top,0px)",
    "w-(--indicator-width,0) h-(--indicator-height,0)",
    className,
  )}
>
  <div class="bg-muted ring-border/40 ring-1 absolute inset-0 rounded-[inherit]"></div>
  <div class="hidden bg-border rounded-tl-sm shadow-md absolute top-full left-1/2 h-2 w-2 -translate-x-1/2 -translate-y-[40%] rotate-45"></div>
</div>
