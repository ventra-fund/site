---
import { cn } from "@/lib/utils";
import { Button } from "../button";
import type { Props as ButtonProps } from "../button/Button.astro";

// Always renders the button itself: the popover library finds the trigger by `data-slot` and
// puts aria-expanded/aria-controls/aria-haspopup on that element, so it has to be the real
// interactive control. For a custom trigger, put `data-slot="popover-trigger"` directly on your
// own <button> instead of wrapping it (see DateField.astro).
type Props = ButtonProps & {
  class?: string;
};

const { class: className = "", ...rest } = Astro.props as Props;
---

<Button
  data-slot="popover-trigger"
  class={cn("", "inline-flex items-center", className)}
  {...rest as any}
>
  <slot />
</Button>
