---
// Minimal partner inquiry page: lenders, brokers, and service providers can send us a message.
// There's no account to create and nothing to approve here, this is a contact form with a role
// attached, not a signup flow. A business owner isn't a partner lead at all, so picking that
// option hands off to /apply immediately instead of posting anything.
import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/Footer.astro";
import QuillEditor from "@/components/QuillEditor.astro";
import Turnstile from "@/components/Turnstile.astro";
import { Button } from "@/ui/button";
import { Input } from "@/ui/input";
import { Select, SelectTrigger, SelectValue, SelectContent, SelectItem } from "@/ui/select";
import { Checkbox } from "@/ui/checkbox";
import { PARTNER_INTERESTS } from "@/lib/partner-schema";

// Mirrors the server's z.email(): the browser's own type="email" check would pass "me@localhost".
const EMAIL_PATTERN = "[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}";
---
<Layout title="Partner with us">
    <main class="w-full min-h-screen px-4 pt-30 pb-20">
        <div class="mx-auto flex max-w-2xl flex-col gap-8">
            <div class="flex flex-col gap-3">
                <h1 class="text-3xl font-bold text-accent sm:text-5xl">Partner with us</h1>
                <p class="text-lg text-muted-foreground">Lenders, brokers, and service providers: tell us a bit about yourselves and what you're looking for.</p>
            </div>

            <form data-partner-form novalidate class="flex flex-col gap-5">
                <div class="flex flex-col gap-1.5">
                    <span id="pt-role-label" class="text-sm font-medium">I am a</span>
                    {/* Deliberately not `required`: the generated hidden field starts empty, and a
                        `required` select reports itself invalid the instant it mounts, which paints
                        the trigger red before the visitor has done anything. Checked by hand on
                        submit instead, same as the other friendly checks below. */}
                    <Select id="pt-role" name="role" placeholder="Select one" defaultValue="broker" class="w-full">
                        {/* text-base to match the text inputs below; the component defaults to text-sm. */}
                        <SelectTrigger id="pt-role-trigger" aria-labelledby="pt-role-label" class="w-full text-base">
                            <SelectValue />
                        </SelectTrigger>
                        <SelectContent>
                            <SelectItem value="broker" class="text-base">Broker</SelectItem>
                            <SelectItem value="lender" class="text-base">Lender</SelectItem>
                            <SelectItem value="service_provider" class="text-base">Service provider</SelectItem>
                            <SelectItem value="owner" class="text-base">Business owner looking for funding</SelectItem>
                        </SelectContent>
                    </Select>
                </div>

                {/* One group per role, only the matching one shown; toggled by the role script
                    below. Boxes are unchecked and hidden together on a role switch, so a stale
                    answer from a role someone changed their mind about can never ride along. */}
                <div data-interests class="flex flex-col gap-1.5">
                    <span class="text-sm font-medium">What are you interested in?</span>
                    {/* Broker starts visible: it's the Select's defaultValue below. */}
                    {Object.entries(PARTNER_INTERESTS).map(([roleValue, options]) => (
                        <div data-interest-group={roleValue} hidden={roleValue !== 'broker'} class="flex flex-col gap-2">
                            {options.map((option) => (
                                <Checkbox
                                    id={`pt-interest-${roleValue}-${option.value}`}
                                    name="interests"
                                    value={option.value}
                                >
                                    {option.label}
                                </Checkbox>
                            ))}
                        </div>
                    ))}
                </div>

                <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                    <label class="flex flex-col gap-1.5 text-sm font-medium">
                        Name
                        <Input name="name" type="text" required maxlength="200" autocomplete="name" />
                    </label>
                    <label class="flex flex-col gap-1.5 text-sm font-medium">
                        Business email
                        <Input name="email" type="email" required maxlength="254" pattern={EMAIL_PATTERN} autocomplete="email" placeholder="you@yourcompany.com" />
                    </label>
                </div>

                <div class="flex flex-col gap-1.5">
                    <span id="pt-message-label" class="text-sm font-medium">Message</span>
                    <QuillEditor placeholder="Tell us about your company and what you're looking for." labelledby="pt-message-label" toolbar="open" />
                </div>

                <Turnstile action="partner" />

                <p data-partner-error hidden role="alert" class="text-sm text-destructive"></p>
                <p data-partner-success hidden role="status" class="text-sm font-medium text-accent">Thanks, your message was sent. We'll be in touch.</p>

                <Button type="submit" size="lg" class="self-start" data-partner-submit data-label="Send message" disabled>Checking security…</Button>
            </form>
        </div>
    </main>
    <Footer />
</Layout>

<script>
    import { gateOnFirstInteraction } from '@/lib/turnstile';
    import { setupValidation, showMessage, submitJson, validateForm } from '@/lib/form';

    const form = document.querySelector<HTMLFormElement>('[data-partner-form]');
    if (form) {
        const roleSelect = document.getElementById('pt-role')!;
        const editorEl = form.querySelector('[data-quill-editor]') as (HTMLElement & { quill?: any }) | null;
        const widget = form.querySelector('turnstile-widget');
        const submitBtn = form.querySelector<HTMLButtonElement>('[data-partner-submit]')!;
        const errorEl = form.querySelector<HTMLElement>('[data-partner-error]')!;
        const successEl = form.querySelector<HTMLElement>('[data-partner-success]')!;
        const showError = (msg: string) => showMessage(errorEl, msg);

        // Turnstile is only fetched once the user touches the form; from then on submit stays disabled
        // until it verifies (invisible first, visible fallback after 5s).
        if (widget) gateOnFirstInteraction({ form, widget, button: submitBtn, onError: showError });

        // A business owner isn't a partner lead: send them straight to the application, the same
        // hand-off the home page's capital CTA makes, instead of letting this form collect a message
        // that would just need to be redirected by hand later.
        const interestGroups = form.querySelectorAll<HTMLElement>('[data-interest-group]');
        // Matches the Select's defaultValue (see the markup above) and the interest group that
        // starts visible: select:change only fires on an actual change, never for the preset value.
        let role = 'broker';
        const showGroupFor = (value: string) => {
            for (const group of interestGroups) {
                const isMatch = group.dataset.interestGroup === value;
                group.hidden = !isMatch;
                // Only the selected role's checkboxes show, and the others are cleared with it: a box
                // ticked before switching roles should never ride along as if it were an answer to a
                // question the form no longer shows.
                if (!isMatch) {
                    for (const box of group.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')) box.checked = false;
                }
            }
        };
        roleSelect.addEventListener('select:change', (e) => {
            role = (e as CustomEvent<{ value: string }>).detail?.value ?? '';
            if (role === 'owner') window.location.href = '/apply';
            showGroupFor(role);
        });

        setupValidation(form);

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            errorEl.hidden = true;
            successEl.hidden = true;

            if (!validateForm(form, errorEl)) return;
            // Not part of native validity (the select isn't `required`, see the comment on it above).
            if (!role) { showError('Please select your role.'); document.getElementById('pt-role-trigger')?.focus(); return; }

            const quill = editorEl?.quill;
            // Friendly checks only. The limits that count are enforced by the zod schema in
            // src/lib/partner-schema.ts on the server; keep the numbers here in step with it.
            const text = quill?.getText().trim() ?? '';
            if (!text) { showError('Please enter a message.'); quill?.focus(); return; }
            if (text.length > 10_000) { showError('Your message is too long.'); quill?.focus(); return; }

            const data = new FormData(form);
            await submitJson({
                form, widget, button: submitBtn, errorEl, successEl,
                url: '/api/partner',
                body: () => ({
                    name: String(data.get('name') ?? '').trim(),
                    email: String(data.get('email') ?? '').trim(),
                    role: String(data.get('role') ?? ''),
                    interests: data.getAll('interests').map(String),
                    html: quill.getSemanticHTML(),
                }),
                onSuccess: () => {
                    form.reset();
                    quill.setText('');
                    // The Select's own reset restores its defaultValue ("broker") but doesn't re-fire
                    // select:change (see its adapter), so the interest groups won't follow it back.
                    role = 'broker';
                    showGroupFor(role);
                },
            });
        });
    }
</script>
