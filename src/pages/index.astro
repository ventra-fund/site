---
import Layout from "@/layouts/Layout.astro";
import StepsBackground from "@/components/StepsBackground.astro";
import StepsAccent from "@/components/StepsAccent.astro";
import Star from "@/components/Star.astro";
import Footer from "@/components/Footer.astro";
import { Button } from "@/ui/button";
import { Image } from "astro:assets";
// Photos live in src/assets so Astro resizes/re-encodes them at build time (see astro.config.mjs
// `imageService: "compile"`): the outputs in dist/_astro are plain static files, no runtime work.
// `widths` caps the candidates at the source width; `sizes` mirrors each slot's CSS width.
import businesswoman from "@/assets/media/businesswoman.webp";
import handshake from "@/assets/media/business-handshake.jpeg";
import hvac from "@/assets/media/hvac.jpeg";
import { BadgeDollarSign, ChevronLeft, ChevronRight, CircleCheck, CircleDollarSign, ClipboardCheck, Quote, Sheet, ShieldCheck, ToolCase, Timer, TrendingUp, UsersRound, Wallet } from "@lucide/astro";

const reviews = [
  { rating: 5, name: "Sandra K.", when: "2 days ago", title: "Applied Monday, funded Wednesday", body: "Had a big payroll week and an old tax bill land at the same time. Ventra covered both without the endless paperwork I expected. Now I just pay a fixed amount each week and it's easy to plan around." },
  { rating: 5, name: "Marcus T.", when: "5 days ago", title: "Finally a lender that answers the phone", body: "Every other company kept us waiting for weeks or called back to resell us. The rep explained the flat fee upfront and helped schedule payments around our slower months." },
  { rating: 4, name: "Priya S.", when: "6 days ago", title: "Good rates, honest terms", body: "Funding cleared quickly for our inventory order and the weekly repayments are easy to budget. Took a day longer to hit our account than promised, but the true cost was clear from day one." },
  { rating: 5, name: "Dan & Lyn M.", when: "1 week ago", title: "Kept our bakery running through summer", body: "Our delivery van gave out right before our busiest season. Ventra approved us in 24 hours and we had a replacement on the road the next week. Can't recommend them enough." },
  { rating: 4, name: "Renee C.", when: "2 weeks ago", title: "Rescued a late-paying client's contract", body: "A client paid late and we nearly missed payroll. The application took ten minutes and the decision came back the same day. Only downer is the fixed weekly payment day was a bit of a squeeze." },
];
---

<Layout>
<main>
  <!-- The steps background spans 210vh behind both the hero and the content that follows it -->
  <div class="relative isolate overflow-hidden bg-background">
    <StepsBackground class="absolute inset-x-0 top-0 -z-10 w-full h-[210vh]" />
    <div class="w-full h-[120vh] flex flex-col items-center mb-50 px-6">
      <h1 class="text-center text-3xl sm:text-5xl pt-50 mx-auto">Working capital<br>built for small businesses</h1>
      <p class="mx-auto text-center py-5 text-lg">Boost cash flow, inventory, operations, and more with Ventra Fund.</p>
    </div>
    
  </div>
  <section class="relative z-10 mx-auto grid w-[calc(100%-2rem)] max-w-[1300px] mt-[-70vh] mb-[4rem] grid-cols-1 md:min-h-176 md:grid-cols-[1fr_2fr] md:w-[calc(100%-8rem)]">
    <Image class="h-80 w-full bg-muted object-cover md:h-0 md:min-h-full" src={businesswoman} alt="Small business owner" widths={[400, 600]} sizes="(min-width: 768px) calc((100vw - 8rem) / 3), calc(100vw - 2rem)" format="webp" quality={75} loading="lazy" decoding="async" />
    <div class="flex flex-col gap-8 bg-secondary px-6 py-12 md:px-16 md:py-20">
      <h2 class="text-4xl font-bold text-accent md:text-5xl">Business financing to fuel your growth.</h2>
      <p class="max-w-xl text-lg text-secondary-foreground">Apply for working capital with Ventra Fund to cover inventory, payroll, marketing, and more, all from one simple application.</p>
      <ul class="flex flex-col gap-8">
        <li class="flex items-center gap-6 text-lg font-semibold text-accent">
          <BadgeDollarSign class="size-12 shrink-0" stroke-width={1.5} />
          <span>Access competitive pricing and repayment terms</span>
        </li>
        <li class="flex items-center gap-6 text-lg font-semibold text-accent">
          <ClipboardCheck class="size-12 shrink-0" stroke-width={1.5} />
          <span>Apply in minutes without impacting your credit score</span>
        </li>
        <li class="flex items-center gap-6 text-lg font-semibold text-accent">
          <Timer class="size-12 shrink-0" stroke-width={1.5} />
          <span>Get a decision in as fast as 24 hours</span>
        </li>
      </ul>
      <Button as="a" href="/capital" size="lg" class="mt-auto self-start">Explore business financing</Button>
    </div>
  </section>

  <section class="mx-auto grid w-[calc(100%-2rem)] max-w-[1300px] my-[4rem] grid-cols-1 md:min-h-176 md:grid-cols-[2fr_1fr] md:w-[calc(100%-8rem)]">
    <Image class="h-80 w-full bg-muted object-cover md:order-last md:h-0 md:min-h-full" src={handshake} alt="Business owners shaking hands" widths={[400, 736]} sizes="(min-width: 768px) calc((100vw - 8rem) / 3), calc(100vw - 2rem)" format="webp" quality={75} loading="lazy" decoding="async" />
    <div class="flex flex-col gap-8 bg-secondary px-6 py-12 md:px-16 md:py-20">
      <h2 class="text-4xl font-bold text-accent md:text-5xl">Unlock funding that doesn’t hold you back.</h2>
      <p class="max-w-xl text-lg text-secondary-foreground">Flexible working capital on terms that put your business first, with no strings attached.</p>
      <ul class="flex flex-col gap-8">
        <li class="flex items-center gap-6 text-lg font-semibold text-accent">
          <Wallet class="size-12 shrink-0" stroke-width={1.5} />
          <span>Use funds for anything your business needs - we trust you to know what’s best.</span>
        </li>
        <li class="flex items-center gap-6 text-lg font-semibold text-accent">
          <ShieldCheck class="size-12 shrink-0" stroke-width={1.5} />
          <span>No personal guarantee, so your personal assets aren’t on the line.</span>
        </li>
        <li class="flex items-center gap-6 text-lg font-semibold text-accent">
          <TrendingUp class="size-12 shrink-0" stroke-width={1.5} />
          <span>No prepayment fees because we don’t think you should be penalized for growth.</span>
        </li>
      </ul>
      <Button as="a" href="/apply" size="lg" class="mt-auto self-start">Check eligibility</Button>
    </div>
  </section>

  <section class="mx-auto grid w-[calc(100%-2rem)] max-w-[1300px] my-[4rem] grid-cols-1 gap-10 bg-secondary px-6 py-12 md:w-[calc(100%-8rem)] md:gap-8 md:px-16 md:py-20 lg:grid-cols-3">
      <div class="mx-auto flex max-w-sm flex-col items-center text-center">
        <CircleDollarSign class="mb-3 size-8 text-foreground" stroke-width={1.5} />
        <h3 class="text-lg font-extrabold text-foreground">Flat-fee pricing and competitive rates</h3>
        <p class="mt-1 text-lg text-muted-foreground">Easy-to-understand terms so you know your true cost of capital.</p>
      </div>
      <div class="mx-auto flex max-w-sm flex-col items-center text-center">
        <Sheet class="mb-3 size-8 text-foreground" stroke-width={1.5} />
        <h3 class="text-lg font-extrabold text-foreground">Fixed weekly repayment schedule</h3>
        <p class="mt-1 text-lg text-muted-foreground">Forecast your finances without the unpredictability of revenue-based payback.</p>
      </div>
      <div class="mx-auto flex max-w-sm flex-col items-center text-center">
        <UsersRound class="mb-3 size-8 text-foreground" stroke-width={1.5} />
        <h3 class="text-lg font-extrabold text-foreground">Long-term partnership</h3>
        <p class="mt-1 text-lg text-muted-foreground">Consultation on how payments impact the business in various forecast cases.</p>
      </div>
  </section>

  <section class="mx-auto w-[calc(100%-2rem)] max-w-[1300px] my-[4rem] md:w-[calc(100%-8rem)]">
    <h2 class="max-w-3xl text-4xl font-bold text-accent md:text-6xl mt-24">See why our customers love Ventra Fund.</h2>
    <p class="mt-6 text-lg text-secondary-foreground">And why you will, too.</p>
    <div class="mt-10 grid grid-cols-1 items-end gap-10 md:mt-6 md:grid-cols-[3fr_2fr]">
      <figure class="relative isolate flex flex-col justify-end gap-10 self-stretch">
        <StepsAccent class="absolute inset-0 -z-10 opacity-30" />
        <Quote class="size-14 fill-primary text-primary" stroke-width={0} />
        <blockquote class="max-w-2xl text-2xl text-accent md:text-3xl">
          “I applied on a Tuesday night and the money was in my account by Friday. We stocked up for summer before our suppliers raised their prices, and I didn't have to touch our cash reserves.”
        </blockquote>
        <figcaption class="flex items-center gap-8 text-accent">
          <div class="border-r border-border pr-8">
            <p class="font-bold">Josh N.</p>
            <p>Polar Bear Mechanical</p>
          </div>
          <div class="flex items-center gap-4">
            <ToolCase class="size-10 shrink-0" stroke-width={1.5} />
            <span>HVAC &amp; Refrigeration</span>
          </div>
        </figcaption>
      </figure>
      <Image class="h-auto w-full bg-muted" src={hvac} alt="HVAC business owner" widths={[400, 735]} sizes="(min-width: 768px) calc((100vw - 8rem) * 0.4), calc(100vw - 2rem)" format="webp" quality={75} loading="lazy" decoding="async" />
    </div>
  </section>

  <section class="relative py-24 md:py-40">
    <!-- Glow rising from the footer's VF mark: the footer has no top padding, so the section's bottom edge is the V's
         top bar. The gradient is centred on a rect twice the viewBox height, so only its upper half shows and the
         brightest point lands on that bottom edge. -->
    <svg class="pointer-events-none absolute inset-x-[10%] bottom-0 h-[34rem] w-4/5 md:h-[44rem]" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <radialGradient id="reviews-glow" cx="0.5" cy="0.5" r="0.5">
          <stop offset="0" style="stop-color: var(--chart-1); stop-color: oklch(from var(--chart-1) calc(l * 0.7) c h)" stop-opacity="0.55" />
          <stop offset="0.45" style="stop-color: var(--chart-1)" stop-opacity="0.25" />
          <stop offset="1" style="stop-color: var(--chart-1)" stop-opacity="0" />
        </radialGradient>
      </defs>
      <rect x="0" y="0" width="100" height="200" fill="url(#reviews-glow)" />
    </svg>
    <div class="relative mx-auto w-[calc(100%-2rem)] max-w-[1020px]">
      <h2 class="text-center text-4xl font-semibold tracking-tight text-accent md:text-6xl">Why Our Customers <span class="text-primary">Love Us</span></h2>
      <p class="mx-auto mt-8 max-w-xl text-center text-accent">Read real testimonies from real customers on their experience with Ventra Fund.</p>
      <div class="mt-16 flex flex-col items-center gap-8 md:mt-24 lg:flex-row lg:gap-7">
        <div class="flex w-[10.5rem] shrink-0 flex-col items-center text-center text-[#191919]">
          <p class="text-[1.4rem] leading-tight">Excellent</p>
          <div class="mt-1.5 flex gap-[3px]" role="img" aria-label="Rated 4.9 out of 5">
            {Array.from({ length: 5 }, (_, i) => (
              <span class:list={["grid size-[30px] place-items-center text-white", i < 4 ? "bg-[#00b67a]" : "bg-[linear-gradient(90deg,#00b67a_50%,#dcdce6_50%)]"]}><Star class="size-5" aria-hidden="true" /></span>
            ))}
          </div>
          <p class="mt-1.5 text-[13px]">Based on <span class="underline">128 reviews</span></p>
          <img class="mt-2 h-6 w-auto" src="/media/trustpilot-dark.svg" alt="Trustpilot" width="140" height="34" loading="lazy" />
        </div>
        <div class="flex w-full min-w-0 items-center gap-4 lg:gap-7" data-reviews>
          <button type="button" class="grid size-6 shrink-0 cursor-pointer place-items-center rounded-full border-[1.5px] border-[#191919] bg-white text-[#191919] transition-colors disabled:cursor-default disabled:border-[#191919]/25 disabled:text-[#191919]/25" aria-label="Previous reviews" data-reviews-prev>
            <ChevronLeft class="size-3.5" stroke-width={2.5} />
          </button>
          <div class="flex min-w-0 flex-1 snap-x snap-mandatory gap-11 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-reviews-track>
            {reviews.map((r) => (
              <article class="flex shrink-0 basis-full snap-start flex-col text-[#191919] sm:basis-[calc((100%-2.75rem)/2)] xl:basis-[calc((100%-5.5rem)/3)]">
                <div class="flex items-center gap-2">
                  <div class="flex gap-[2px]" role="img" aria-label={`Rated ${r.rating} out of 5`}>
                    {Array.from({ length: 5 }, (_, i) => (
                      <span class:list={["grid size-[18px] place-items-center text-white", i < r.rating ? "bg-[#00b67a]" : "bg-[#dcdce6]"]}><Star class="size-3" aria-hidden="true" /></span>
                    ))}
                  </div>
                  <span class="flex items-center gap-1 text-sm text-[#6c6c85]"><CircleCheck class="size-4 fill-[#6c6c85] text-white" aria-hidden="true" /><span class="underline">Verified</span></span>
                </div>
                <p class="mt-2.5 text-xs text-[#6c6c85]"><strong class="font-semibold">{r.name},</strong> {r.when}</p>
                <h3 class="mt-2 truncate text-sm font-semibold">{r.title}</h3>
                <p class="mt-1 line-clamp-2 text-[13px] leading-snug">{r.body}</p>
              </article>
            ))}
          </div>
          <button type="button" class="grid size-6 shrink-0 cursor-pointer place-items-center rounded-full border-[1.5px] border-[#191919] bg-white text-[#191919] transition-colors disabled:cursor-default disabled:border-[#191919]/25 disabled:text-[#191919]/25" aria-label="Next reviews" data-reviews-next>
            <ChevronRight class="size-3.5" stroke-width={2.5} />
          </button>
        </div>
      </div>
    </div>
  </section>

</main>
  <Footer />

</Layout>

<script>
  // Review carousel: arrows scroll by one card and disable at either end
  document.querySelectorAll<HTMLElement>("[data-reviews]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-reviews-track]")!;
    const prev = root.querySelector<HTMLButtonElement>("[data-reviews-prev]")!;
    const next = root.querySelector<HTMLButtonElement>("[data-reviews-next]")!;

    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max - 1;
    };

    const step = (dir: number) => {
      const card = track.firstElementChild as HTMLElement;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      track.scrollBy({ left: dir * (card.offsetWidth + gap), behavior: "smooth" });
    };

    prev.addEventListener("click", () => step(-1));
    next.addEventListener("click", () => step(1));
    track.addEventListener("scroll", update, { passive: true });
    new ResizeObserver(update).observe(track);
    update();
  });
</script>
