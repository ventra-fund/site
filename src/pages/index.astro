---
import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/Footer.astro";
import HeroScene from "@/components/HeroScene.astro";
import GlassButton from "@/components/GlassButton.astro";
import HeroPoints from "@/components/HeroPoints.astro";
import GlareCard from "@/components/GlareCard.astro";
import DealFlow from "@/components/DealFlow.astro";
import WeekStrip from "@/components/WeekStrip.astro";
import CtaBand from "@/components/page/CtaBand.astro";
import { dayList, isoProgram, shortDays, underwriterAvailability } from "@/data/iso-program";

const { commissionDays, underwriterDays, underwriterHours, renewAtPercent, bonusAt, stips } = isoProgram;

// The hero's tag lines, the same as Main Capital's: the lead shows, the rest unfolds on hover or tap.
const heroPoints = [
  { lead: "For brokers", rest: "with B/C-paper MCA deals" },
  { lead: "Sick of declined deals", rest: "even when they match funder guidelines" },
  { lead: "And inconsistent funders", rest: "with unclear communication" },
];

// Below the hero: Main Capital's ISO pitch, card by card, in its style. Each card is a size container,
// so its stat scales with the card (cqi) rather than the longest word forcing the column wider on
// narrow phones.
const card = "@container flex min-h-80 flex-col justify-end border border-border bg-card p-8 sm:p-10 lg:p-14";
const stat = "text-[clamp(2.25rem,22cqi,3.75rem)] font-medium leading-[1.02] tracking-[-0.04em] lg:text-7xl";
const note = "mt-4 text-xl text-muted-foreground";

// The page's column: the hero copy and every section below it share this width, so their left edges line up.
const column = "mx-auto w-[calc(100%-2rem)] max-w-[1000px] md:w-[calc(100%-8rem)]";
---

<Layout>
<main>
  <!-- Full-bleed hero filling the first screen. The 3D stage (HeroScene) frames itself in the space right of the copy,
       or above it once the screen is taller than wide (the max-aspect-ratio variants, same breakpoint as the scene).
       Its fog runs on past the bottom into the next section, so the hero clips only sideways. -->
  <section class="relative isolate flex min-h-svh flex-col overflow-x-clip text-[#000305]">
    <HeroScene />
    <div class:list={[column, "my-auto py-16 [@media(max-aspect-ratio:9/10)]:mb-0 [@media(max-aspect-ratio:9/10)]:mt-auto [@media(max-aspect-ratio:9/10)]:pb-10"]}>
      <div class="w-fit max-w-2xl" data-hero-copy>
        <h1 class="text-4xl font-semibold leading-[0.98] tracking-[-0.03em] sm:text-5xl lg:text-6xl xl:text-7xl">ISO-only <br class="hidden md:inline" /><span class="text-[#0b7a9a]">funding</span></h1>
        <HeroPoints points={heroPoints} class="mt-6 max-w-md" />
        <GlassButton href="/partner" arrow class="mt-8 max-sm:[@media(max-aspect-ratio:9/10)]:w-full">Onboard now</GlassButton>
      </div>
    </div>
  </section>

  <!-- relative: paints over the hero's fog, which reaches into the top of this section -->
  <section class:list={[column, "relative pt-16 sm:pt-24"]}>
    <h2 class="text-4xl font-bold">It's simple,<br />we don't go direct-to-merchant.</h2>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      <GlareCard class={card}>
        <h3 class={stat}>Always yours</h3>
        <p class={note}>Every merchant you submit stays yours, even the ones we decline. We never market to them or contact them on our own.</p>
      </GlareCard>
      <GlareCard class={card}>
        <h3 class={stat}>100% ISO</h3>
        <p class={note}>We have no sales floor. Every deal we fund comes from a broker.</p>
      </GlareCard>
    </div>
    <DealFlow class="my-4" />
    <div class="grid gap-4 md:grid-cols-2">
      <GlareCard class={card}>
        <h3 class={stat}>Your deal</h3>
        <p class={note}>We use your name on the merchant call. We don't shop your file to other funders, and it never leaves our team.</p>
      </GlareCard>
      <GlareCard class={card}>
        <h3 class={stat}>Push back</h3>
        <p class={note}>Every decline comes with the reason. If we got something wrong, tell us and we'll take another look.</p>
      </GlareCard>
      <GlareCard class={card}>
        <WeekStrip active={commissionDays} class="mb-auto pb-10" />
        <h3 class={stat}>{shortDays(commissionDays)}</h3>
        <p class={note}>Commission runs twice a week, every {dayList(commissionDays)}.</p>
      </GlareCard>
      <GlareCard class={card}>
        <WeekStrip active={underwriterDays} class="mb-auto pb-10" />
        <h3 class={stat}>{underwriterHours.short}</h3>
        <p class={note}>Speak with an underwriter live, {underwriterAvailability}.</p>
      </GlareCard>
      <GlareCard class={card}>
        <div class="mb-auto pb-10" aria-hidden="true">
          <div class="relative h-2 bg-muted">
            <div class="absolute inset-y-0 left-0 bg-foreground" style={`width: ${renewAtPercent}%`}></div>
          </div>
          <div class="relative mt-3 h-5 text-sm text-muted-foreground">
            <span class="absolute left-0">0%</span>
            <span class="absolute -translate-x-1/2 text-foreground" style={`left: ${renewAtPercent}%`}>Renew</span>
            <span class="absolute right-0">100% paid in</span>
          </div>
        </div>
        <h3 class={stat}>Renewals at {renewAtPercent}%</h3>
        <p class={note}>Merchants can renew at {renewAtPercent}% paid in. Every renewal is credited to you, at the same commission as the first funding.</p>
      </GlareCard>
      <GlareCard class={card}>
        <div class="mb-auto pb-10" aria-hidden="true">
          <div class="h-2 bg-linear-to-r from-muted to-foreground"></div>
          <div class="mt-3 flex justify-between text-sm">
            <span class="text-muted-foreground">$0 to start</span>
            <span>{bonusAt} funded: bonus</span>
          </div>
        </div>
        <h3 class={stat}>No minimum</h3>
        <p class={note}>No volume minimum. A bonus once you reach {bonusAt} funded.</p>
      </GlareCard>
      <GlareCard class={`${card} justify-start`}>
        <h3 class={stat}>Pre-approvals</h3>
        <p class={note}>Automated checks of the industry type and the position stack, with the actual underwriting done by a person.</p>
      </GlareCard>
      <GlareCard class={`${card} justify-start`}>
        <h3 class={stat}>{stips.length} stips</h3>
        <ol class="mt-10 list-none border-t border-border text-lg">
          {stips.map((stip, i) => (
            <li class="flex gap-4 border-b border-border py-3">
              <span class="text-muted-foreground tabular-nums">{String(i + 1).padStart(2, "0")}</span>
              {stip}
            </li>
          ))}
        </ol>
      </GlareCard>
    </div>
  </section>

  <CtaBand title="Stop chasing your funder." text="" lens class="mt-8 lg:mt-12" />
</main>
  <Footer />
</Layout>
