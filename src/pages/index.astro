---
import Layout from "@/layouts/Layout.astro";
import StepsBackground from "@/components/StepsBackground.astro";
import StepsAccent from "@/components/StepsAccent.astro";
import Star from "@/components/Star.astro";
import Footer from "@/components/Footer.astro";
import { Button } from "@/ui/button";
import { BadgeDollarSign, ChevronLeft, ChevronRight, CircleDollarSign, ClipboardCheck, Quote, Sheet, ShieldCheck, ToolCase, Timer, TrendingUp, UsersRound, Wallet } from "@lucide/astro";
---

<Layout>

  <!-- The steps background spans 210vh behind both the hero and the content that follows it -->
  <div class="relative isolate overflow-hidden bg-background">
    <StepsBackground class="absolute inset-x-0 top-0 -z-10 w-full h-[210vh]" />
    <div class="w-full h-[120vh] flex flex-col items-center mb-50 px-6">
      <h1 class="text-center text-3xl sm:text-5xl pt-50 mx-auto">Working capital<br>built for small businesses</h1>
      <p class="mx-auto text-center py-5 text-lg">Boost cash flow, inventory, operations, and more with Ventra Fund.</p>
    </div>
    
  </div>
  <section class="mx-auto grid w-[calc(100%-2rem)] my-[4rem] grid-cols-1 md:min-h-176 md:grid-cols-[1fr_2fr] md:w-[calc(100%-8rem)]">
    <img class="h-80 w-full bg-muted object-cover md:h-0 md:min-h-full" src="/media/businesswoman.webp" alt="Small business owner" width="600" height="900" loading="lazy" decoding="async" />
    <div class="flex flex-col gap-8 bg-secondary px-6 py-12 md:px-16 md:py-20">
      <h2 class="text-4xl font-bold text-accent md:text-5xl">Business financing to fuel your growth.</h2>
      <p class="max-w-xl text-lg text-secondary-foreground">Apply for working capital with Ventra Fund to cover inventory, payroll, marketing, and more, all from one simple application.</p>
      <ul class="flex flex-col gap-8">
        <li class="flex items-center gap-6 text-lg font-semibold text-accent">
          <BadgeDollarSign class="size-12 shrink-0" stroke-width={1.5} />
          <span>Access competitive pricing and repayment terms</span>
        </li>
        <li class="flex items-center gap-6 text-lg font-semibold text-accent">
          <ClipboardCheck class="size-12 shrink-0" stroke-width={1.5} />
          <span>Apply in minutes without impacting your credit score</span>
        </li>
        <li class="flex items-center gap-6 text-lg font-semibold text-accent">
          <Timer class="size-12 shrink-0" stroke-width={1.5} />
          <span>Get a decision in as fast as 24 hours</span>
        </li>
      </ul>
      <Button as="a" href="#" size="lg" class="mt-auto self-start">Explore business financing</Button>
    </div>
  </section>

  <section class="mx-auto grid w-[calc(100%-2rem)] my-[4rem] grid-cols-1 md:min-h-176 md:grid-cols-[2fr_1fr] md:w-[calc(100%-8rem)]">
    <img class="h-80 w-full bg-muted object-cover md:order-last md:h-0 md:min-h-full" src="/media/business-handshake.jpeg" alt="Business owners shaking hands" width="736" height="1306" loading="lazy" decoding="async" />
    <div class="flex flex-col gap-8 bg-secondary px-6 py-12 md:px-16 md:py-20">
      <h2 class="text-4xl font-bold text-accent md:text-5xl">Unlock funding that doesn’t hold you back.</h2>
      <p class="max-w-xl text-lg text-secondary-foreground">Flexible working capital on terms that put your business first, with no strings attached.</p>
      <ul class="flex flex-col gap-8">
        <li class="flex items-center gap-6 text-lg font-semibold text-accent">
          <Wallet class="size-12 shrink-0" stroke-width={1.5} />
          <span>Use funds for anything your business needs - we trust you to know what’s best.</span>
        </li>
        <li class="flex items-center gap-6 text-lg font-semibold text-accent">
          <ShieldCheck class="size-12 shrink-0" stroke-width={1.5} />
          <span>No personal guarantee, so your personal assets aren’t on the line.</span>
        </li>
        <li class="flex items-center gap-6 text-lg font-semibold text-accent">
          <TrendingUp class="size-12 shrink-0" stroke-width={1.5} />
          <span>No prepayment fees because we don’t think you should be penalized for growth.</span>
        </li>
      </ul>
      <Button as="a" href="#" size="lg" class="mt-auto self-start">Check eligibility</Button>
    </div>
  </section>

  <section class="mx-auto grid w-[calc(100%-2rem)] my-[4rem] grid-cols-1 gap-10 bg-secondary px-6 py-12 md:w-[calc(100%-8rem)] md:gap-8 md:px-16 md:py-20 lg:grid-cols-3">
      <div class="mx-auto flex max-w-sm flex-col items-center text-center">
        <CircleDollarSign class="mb-3 size-8 text-foreground" stroke-width={1.5} />
        <h3 class="text-lg font-extrabold text-foreground">Flat-fee pricing and competitive rates</h3>
        <p class="mt-1 text-lg text-muted-foreground">Easy-to-understand terms so you know your true cost of capital.</p>
      </div>
      <div class="mx-auto flex max-w-sm flex-col items-center text-center">
        <Sheet class="mb-3 size-8 text-foreground" stroke-width={1.5} />
        <h3 class="text-lg font-extrabold text-foreground">Fixed weekly repayment schedule</h3>
        <p class="mt-1 text-lg text-muted-foreground">Forecast your finances without the unpredictability of revenue-based payback.</p>
      </div>
      <div class="mx-auto flex max-w-sm flex-col items-center text-center">
        <UsersRound class="mb-3 size-8 text-foreground" stroke-width={1.5} />
        <h3 class="text-lg font-extrabold text-foreground">Long-term partnership</h3>
        <p class="mt-1 text-lg text-muted-foreground">Consultation on how payments impact the business in various forecast cases.</p>
      </div>
  </section>

  <section class="mx-auto w-[calc(100%-2rem)] my-[4rem] md:w-[calc(100%-8rem)]">
    <h2 class="max-w-3xl text-4xl font-bold text-accent md:text-6xl mt-24">See why our customers love Ventra Fund.</h2>
    <p class="mt-6 text-lg text-secondary-foreground">And why you will, too.</p>
    <div class="mt-10 grid grid-cols-1 items-end gap-10 md:mt-6 md:grid-cols-[3fr_2fr]">
      <figure class="relative isolate flex flex-col justify-end gap-10 self-stretch">
        <StepsAccent class="absolute inset-0 -z-10 opacity-30" />
        <Quote class="size-14 fill-primary text-primary" stroke-width={0} />
        <blockquote class="max-w-2xl text-2xl text-accent md:text-3xl">
          “I applied on a Tuesday night and the money was in my account by Friday. We stocked up for summer before our suppliers raised their prices, and I didn't have to touch our cash reserves.”
        </blockquote>
        <figcaption class="flex items-center gap-8 text-accent">
          <div class="border-r border-border pr-8">
            <p class="font-bold">Josh N.</p>
            <p>Polar Bear Mechanical</p>
          </div>
          <div class="flex items-center gap-4">
            <ToolCase class="size-10 shrink-0" stroke-width={1.5} />
            <span>HVAC &amp; Refrigeration</span>
          </div>
        </figcaption>
      </figure>
      <img class="h-auto w-full bg-muted" src="/media/hvac.jpeg" alt="HVAC business owner" width="735" height="919" loading="lazy" decoding="async" />
    </div>
  </section>

  <section class="bg-primary/10 py-20 md:py-28">
    <div class="mx-auto w-[calc(100%-2rem)] md:w-[calc(100%-8rem)]">
      <h2 class="text-4xl font-bold text-accent md:text-6xl">Read the latest from our customers.</h2>
      <!-- Placeholder reviews and rating: replace with real review data before launch -->
      <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-[1fr_3fr]">
        <div class="flex flex-col justify-center gap-4 rounded-br-[5rem] bg-accent p-10 text-accent-foreground">
          <p class="text-xl font-semibold">Excellent</p>
          <div class="flex items-center gap-3">
            <div class="flex gap-2" role="img" aria-label="Rated 4.9 out of 5">
              {Array.from({ length: 5 }, () => (
                <span class="grid size-10 place-items-center bg-primary text-primary-foreground"><Star class="size-6" aria-hidden="true" /></span>
              ))}
            </div>
            <p class="text-2xl font-bold">4.9</p>
          </div>
          <p class="text-sm">Based on <strong>128</strong> reviews</p>
          <img class="mt-2 h-8 w-auto self-start" src="/media/trustpilot.svg" alt="Trustpilot" width="140" height="34" loading="lazy" />
        </div>
        <div class="min-w-0" data-reviews>
          <div class="flex snap-x snap-mandatory gap-6 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-reviews-track>
        <article class="flex shrink-0 basis-[85%] snap-start flex-col rounded-tr-[5rem] bg-background p-8 pr-12 sm:basis-[calc((100%-1.5rem)/2)] xl:basis-[calc((100%-3rem)/3)]">
          <div class="mb-4 flex gap-0.5" role="img" aria-label="Rated 5 out of 5">
            {Array.from({ length: 5 }, () => (
              <span class="grid size-6 place-items-center bg-primary text-primary-foreground"><Star class="size-4" aria-hidden="true" /></span>
            ))}
          </div>
          <h3 class="text-xl font-bold text-accent">Applied Monday, funded Wednesday</h3>
          <p class="mt-4 line-clamp-3 text-accent">Had a big payroll week and an old tax bill land at the same time. Ventra covered both without the endless paperwork I expected. Now I just pay a fixed amount each week and it's easy to plan around.</p>
          <hr class="mt-4 w-28 border-border" />
          <p class="mt-4 text-sm font-bold text-accent">Sandra K.</p>
        </article>
        <article class="flex shrink-0 basis-[85%] snap-start flex-col rounded-tr-[5rem] bg-background p-8 pr-12 sm:basis-[calc((100%-1.5rem)/2)] xl:basis-[calc((100%-3rem)/3)]">
          <div class="mb-4 flex gap-0.5" role="img" aria-label="Rated 5 out of 5">
            {Array.from({ length: 5 }, () => (
              <span class="grid size-6 place-items-center bg-primary text-primary-foreground"><Star class="size-4" aria-hidden="true" /></span>
            ))}
          </div>
          <h3 class="text-xl font-bold text-accent">Finally a lender that answers the phone</h3>
          <p class="mt-4 line-clamp-3 text-accent">Every other company kept us waiting for weeks or called back to resell us. The rep explained the flat fee upfront and helped schedule payments around our slower months.</p>
          <hr class="mt-4 w-28 border-border" />
          <p class="mt-4 text-sm font-bold text-accent">Marcus T.</p>
        </article>
        <article class="flex shrink-0 basis-[85%] snap-start flex-col rounded-tr-[5rem] bg-background p-8 pr-12 sm:basis-[calc((100%-1.5rem)/2)] xl:basis-[calc((100%-3rem)/3)]">
          <div class="mb-4 flex gap-0.5" role="img" aria-label="Rated 4 out of 5">
            {Array.from({ length: 4 }, () => (
              <span class="grid size-6 place-items-center bg-primary text-primary-foreground"><Star class="size-4" aria-hidden="true" /></span>
            ))}
            {Array.from({ length: 1 }, () => (
              <span class="grid size-6 place-items-center bg-muted text-muted-foreground"><Star class="size-4" aria-hidden="true" /></span>
            ))}
          </div>
          <h3 class="text-xl font-bold text-accent">Good rates, honest terms</h3>
          <p class="mt-4 line-clamp-3 text-accent">Funding cleared quickly for our inventory order and the weekly repayments are easy to budget. Took a day longer to hit our account than promised, but the true cost was clear from day one.</p>
          <hr class="mt-4 w-28 border-border" />
          <p class="mt-4 text-sm font-bold text-accent">Priya S.</p>
        </article>
        <article class="flex shrink-0 basis-[85%] snap-start flex-col rounded-tr-[5rem] bg-background p-8 pr-12 sm:basis-[calc((100%-1.5rem)/2)] xl:basis-[calc((100%-3rem)/3)]">
          <div class="mb-4 flex gap-0.5" role="img" aria-label="Rated 5 out of 5">
            {Array.from({ length: 5 }, () => (
              <span class="grid size-6 place-items-center bg-primary text-primary-foreground"><Star class="size-4" aria-hidden="true" /></span>
            ))}
          </div>
          <h3 class="text-xl font-bold text-accent">Kept our bakery running through summer</h3>
          <p class="mt-4 line-clamp-3 text-accent">Our delivery van gave out right before our busiest season. Ventra approved us in 24 hours and we had a replacement on the road the next week. Can't recommend them enough.</p>
          <hr class="mt-4 w-28 border-border" />
          <p class="mt-4 text-sm font-bold text-accent">Dan &amp; Lyn M.</p>
        </article>
        <article class="flex shrink-0 basis-[85%] snap-start flex-col rounded-tr-[5rem] bg-background p-8 pr-12 sm:basis-[calc((100%-1.5rem)/2)] xl:basis-[calc((100%-3rem)/3)]">
          <div class="mb-4 flex gap-0.5" role="img" aria-label="Rated 4 out of 5">
            {Array.from({ length: 4 }, () => (
              <span class="grid size-6 place-items-center bg-primary text-primary-foreground"><Star class="size-4" aria-hidden="true" /></span>
            ))}
            {Array.from({ length: 1 }, () => (
              <span class="grid size-6 place-items-center bg-muted text-muted-foreground"><Star class="size-4" aria-hidden="true" /></span>
            ))}
          </div>
          <h3 class="text-xl font-bold text-accent">Rescued a late-paying client's contract</h3>
          <p class="mt-4 line-clamp-3 text-accent">A client paid late and we nearly missed payroll. The application took ten minutes and the decision came back the same day. Only downer is the fixed weekly payment day was a bit of a squeeze.</p>
          <hr class="mt-4 w-28 border-border" />
          <p class="mt-4 text-sm font-bold text-accent">Renee C.</p>
        </article>
          </div>
          <div class="mt-6 flex items-center gap-6">
            <button type="button" class="text-accent disabled:opacity-30" aria-label="Previous reviews" data-reviews-prev>
              <ChevronLeft class="size-5" />
            </button>
            <div class="h-2 flex-1 overflow-hidden rounded-full bg-background">
              <div class="h-full rounded-full bg-primary" data-reviews-thumb></div>
            </div>
            <button type="button" class="text-accent disabled:opacity-30" aria-label="Next reviews" data-reviews-next>
              <ChevronRight class="size-5" />
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />

</Layout>

<script>
  // Review carousel: arrows scroll by one card, the bar shows the visible share of the track and its position
  document.querySelectorAll<HTMLElement>("[data-reviews]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-reviews-track]")!;
    const thumb = root.querySelector<HTMLElement>("[data-reviews-thumb]")!;
    const prev = root.querySelector<HTMLButtonElement>("[data-reviews-prev]")!;
    const next = root.querySelector<HTMLButtonElement>("[data-reviews-next]")!;

    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      const visible = track.clientWidth / track.scrollWidth;
      thumb.style.width = `${visible * 100}%`;
      thumb.style.transform = `translateX(${max > 0 ? (track.scrollLeft / max) * (1 / visible - 1) * 100 : 0}%)`;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max - 1;
    };

    const step = (dir: number) => {
      const card = track.firstElementChild as HTMLElement;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      track.scrollBy({ left: dir * (card.offsetWidth + gap), behavior: "smooth" });
    };

    prev.addEventListener("click", () => step(-1));
    next.addEventListener("click", () => step(1));
    track.addEventListener("scroll", update, { passive: true });
    new ResizeObserver(update).observe(track);
    update();
  });
</script>
