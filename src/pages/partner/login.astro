---
// Placeholder until the partner portal exists: there are no partner accounts yet, so this page
// points partners at their relationship manager instead of showing a sign-in form that can't work.
import PageShell from "@/components/page/PageShell.astro";
import PageHero from "@/components/page/PageHero.astro";
import Section from "@/components/page/Section.astro";
import PillLink from "@/components/page/PillLink.astro";
---

<PageShell title="Partner login">
  <PageHero eyebrow="For ISOs" title="Partner portal">
    <p>Our online partner portal is on its way. Until it launches, send deals to your relationship manager, who will update you at every step and answer commission questions.</p>
  </PageHero>

  <Section tone="muted">
    <div class="flex flex-wrap gap-3">
      <PillLink href="/contact">Contact us</PillLink>
      <PillLink href="/partner" variant="outline">Onboard now</PillLink>
    </div>
  </Section>
</PageShell>
