---
import PartnerLayout from "@/layouts/PartnerLayout.astro";
import Card from "@/components/partner/Card.astro";
import DealStatusBadge from "@/components/partner/DealStatusBadge.astro";
import SourceBadge from "@/components/partner/SourceBadge.astro";
import { Button } from "@/ui/button";
import { Input } from "@/ui/input";
import { Upload, FileText, Image as ImageIcon, TriangleAlert, CircleCheck, Circle, Download } from "@lucide/astro";
import { deals, DEAL_STATUS, FILE_KIND_LABEL, filesFor, eventsFor, stipsFor, offersFor, nextAction, userName, formatDate, formatDateTime, formatBytes, daysSince, org } from "@/data/portal-fixtures";
import { DEFAULT_COMMISSION_PLAN as plan, quote, formatMoney, PAPER_GRADE_LABEL } from "@/data/commission-plan";
import { UPLOAD_ACCEPT, UPLOAD_TYPE_LABEL, MAX_UPLOAD_FILE_BYTES, formatMb } from "@/lib/upload-config";

// One deal: header, what to do next, then the sections an ISO works from. Every section exists
// for every status (empty states included) so the page reads the same from "received" to
// "funded"; the pipeline's next-action links jump to #details, #files or #offers.
export function getStaticPaths() {
  return deals.map((d) => ({ params: { number: d.number }, props: { deal: d } }));
}

const { deal } = Astro.props;
const files = filesFor(deal.id);
const events = eventsFor(deal.id);
const stips = stipsFor(deal.id);
const offers = offersFor(deal.id);
const action = nextAction(deal);
const stored = files.filter((f) => f.status === "stored");
const closed = ["funded", "declined", "withdrawn"].includes(deal.status);

// The package checklist: what we have against what a complete file needs.
const required: { kind: keyof typeof FILE_KIND_LABEL; label: string; have: boolean; note?: string }[] = [
  { kind: "application", label: "Signed application", have: stored.some((f) => f.kind === "application") },
  { kind: "bank_statement", label: "3 to 6 months of bank statements", have: stored.filter((f) => f.kind === "bank_statement").length >= 3 || stored.some((f) => f.kind === "bank_statement" && f.bytes > 4_000_000), note: `${stored.filter((f) => f.kind === "bank_statement").length} file(s)` },
  { kind: "id", label: "Owner ID (50%+ owners)", have: stored.some((f) => f.kind === "id") },
  { kind: "voided_check", label: "Voided check or bank letter", have: stored.some((f) => f.kind === "voided_check") },
];

const missingDetails = deal.status === "needs_details";
const detailRows: { label: string; value: string | number | null; missing?: boolean }[] = [
  { label: "Legal name", value: deal.legalName || null, missing: !deal.legalName },
  { label: "DBA", value: deal.dba || null },
  { label: "Industry", value: deal.industry || null, missing: !deal.industry },
  { label: "State", value: deal.state || null, missing: !deal.state },
  { label: "Product", value: deal.product },
  { label: "Requested", value: deal.amountRequested ? formatMoney(deal.amountRequested) : null, missing: !deal.amountRequested },
  { label: "Monthly revenue", value: deal.monthlyRevenue ? formatMoney(deal.monthlyRevenue) : null },
  { label: "Open positions", value: deal.openPositions },
  { label: "Paper grade", value: deal.paperGrade ? PAPER_GRADE_LABEL[deal.paperGrade] : "Set by underwriting" },
  ...(deal.externalRef ? [{ label: "Your reference", value: deal.externalRef }] : []),
];
---

<PartnerLayout title={deal.dba || "Unnamed merchant"} current="deals" wide>
  <Fragment slot="actions">
    {action && <Button as="a" href={action.href}>{action.label}</Button>}
    {!closed && <Button variant="outline" data-withdraw>Withdraw</Button>}
  </Fragment>

  <div class="-mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground">
    <a href="/partner/deals" class="hover:text-foreground">← Deals</a>
    <span class="font-mono">{deal.number}</span>
    <DealStatusBadge status={deal.status} />
    <SourceBadge source={deal.source} />
    <span>Submitted {formatDate(deal.submittedAt)} by {userName(deal.submittedBy)} · {daysSince(deal.submittedAt)} days</span>
  </div>

  {/* The status in words, and the one thing to do about it. */}
  <div class:list={["flex flex-wrap items-center justify-between gap-3 border px-4 py-3 text-sm", DEAL_STATUS[deal.status].tone === "warning" ? "border-amber-500/40 bg-amber-500/5" : DEAL_STATUS[deal.status].tone === "success" ? "border-emerald-500/40 bg-emerald-500/5" : DEAL_STATUS[deal.status].tone === "danger" ? "border-destructive/40 bg-destructive/5" : "border-border bg-muted/30"]}>
    <p><span class="font-medium">{DEAL_STATUS[deal.status].label}.</span> {DEAL_STATUS[deal.status].help}</p>
    {deal.declineReasons && (
      <ul class="w-full list-disc pl-5 text-muted-foreground">{deal.declineReasons.map((r) => <li>{r}</li>)}</ul>
    )}
  </div>

  <div class="grid gap-6 lg:grid-cols-[3fr_2fr]">
    <div class="flex flex-col gap-6">
      <Card id="details" title="Merchant" description={missingDetails ? "The email package arrived without these. Fill them in to send the deal to review." : undefined}>
        {missingDetails ? (
          <form class="grid grid-cols-1 gap-4 sm:grid-cols-2" data-details-form>
            {detailRows.filter((r) => r.missing).map((r) => (
              <label class="flex flex-col gap-1.5 text-sm font-medium">{r.label}<Input name={r.label} required /></label>
            ))}
            <label class="flex flex-col gap-1.5 text-sm font-medium">Owner name<Input name="owner" required /></label>
            <label class="flex flex-col gap-1.5 text-sm font-medium">Owner email<Input name="ownerEmail" type="email" required /></label>
            <div class="sm:col-span-2 flex gap-2"><Button type="submit">Send to review</Button><Button as="a" href="/partner/submit" variant="outline">Open the full form</Button></div>
          </form>
        ) : (
          <dl class="grid grid-cols-1 gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
            {detailRows.map((r) => (
              <div class="flex justify-between gap-4 border-b border-border py-1.5 sm:last:border-0"><dt class="text-muted-foreground">{r.label}</dt><dd class="text-right tabular-nums">{r.value ?? "—"}</dd></div>
            ))}
          </dl>
        )}
      </Card>

      <Card id="files" title="Files" description="Everything we hold for this deal. Uploads go straight to the file, and underwriting is told.">
        <Fragment slot="actions">
          {!closed && <Button size="sm" variant="outline" data-upload-trigger><Upload class="size-4" aria-hidden="true" /> Upload</Button>}
        </Fragment>

        {stips.length > 0 && (
          <div class="flex flex-col gap-2 border border-amber-500/40 bg-amber-500/5 p-3 text-sm">
            <p class="font-medium">Requested by underwriting</p>
            <ul class="flex flex-col gap-2">
              {stips.map((s) => (
                <li class="flex items-start gap-2">
                  {s.status === "cleared" ? <CircleCheck class="mt-0.5 size-4 shrink-0 text-emerald-600" aria-hidden="true" /> : s.status === "received" ? <Circle class="mt-0.5 size-4 shrink-0 fill-primary/30 text-primary" aria-hidden="true" /> : <TriangleAlert class="mt-0.5 size-4 shrink-0 text-amber-600" aria-hidden="true" />}
                  <div class="flex-1">
                    <p class:list={["font-medium", s.status === "cleared" && "text-muted-foreground line-through"]}>{s.shortText} <span class="font-normal text-xs text-muted-foreground">· {s.status}</span></p>
                    <p class="text-muted-foreground">{s.longText}</p>
                  </div>
                  {s.status === "open" && !closed && <Button size="sm" variant="outline" data-upload-trigger data-stip={s.id}>Upload</Button>}
                </li>
              ))}
            </ul>
          </div>
        )}

        <ul class="grid grid-cols-2 gap-2 text-sm sm:grid-cols-4">
          {required.map((r) => (
            <li class="flex items-center gap-2 border border-border px-2.5 py-2">
              {r.have ? <CircleCheck class="size-4 shrink-0 text-emerald-600" aria-hidden="true" /> : <Circle class="size-4 shrink-0 text-muted-foreground" aria-hidden="true" />}
              <span class="flex flex-col"><span class:list={["text-xs", !r.have && "text-muted-foreground"]}>{r.label}</span>{r.note && <span class="text-[11px] text-muted-foreground">{r.note}</span>}</span>
            </li>
          ))}
        </ul>

        <div data-upload-dropzone hidden role="button" tabindex="0" class="flex cursor-pointer flex-col items-center gap-1 border-2 border-dashed border-border p-6 text-center hover:border-primary data-[dragging]:border-primary data-[dragging]:bg-primary/5">
          <Upload class="size-5 text-muted-foreground" aria-hidden="true" />
          <p class="text-sm font-medium">Drop files here or click to choose</p>
          <p class="text-xs text-muted-foreground">{UPLOAD_TYPE_LABEL} · {formatMb(MAX_UPLOAD_FILE_BYTES)} each · one file at a time is fine</p>
          <input data-upload-input type="file" multiple accept={UPLOAD_ACCEPT} class="sr-only" tabindex="-1" aria-hidden="true" />
        </div>

        {files.length === 0 ? (
          <p class="text-sm text-muted-foreground">No files yet.</p>
        ) : (
          <ul data-file-list class="divide-y divide-border text-sm">
            {files.map((f) => (
              <li class="flex items-center gap-3 py-2">
                {f.mime === "application/pdf" ? <FileText class="size-4 shrink-0 text-muted-foreground" aria-hidden="true" /> : <ImageIcon class="size-4 shrink-0 text-muted-foreground" aria-hidden="true" />}
                <div class="min-w-0 flex-1">
                  <p class:list={["truncate font-medium", f.status !== "stored" && "text-muted-foreground"]}>{f.name}</p>
                  <p class="text-xs text-muted-foreground">{FILE_KIND_LABEL[f.kind]} · {formatBytes(f.bytes)} · {formatDateTime(f.uploadedAt)} · {userName(f.uploadedBy)}</p>
                </div>
                {f.status === "duplicate" && <span class="text-xs text-muted-foreground" title="Same bytes as a file already on the deal">Duplicate, skipped</span>}
                {f.status === "rejected" && <span class="text-xs text-destructive" title="Not a PDF, JPG or PNG">Rejected</span>}
                {f.status === "stored" && <a href="#" class="text-muted-foreground hover:text-foreground" aria-label={`Download ${f.name}`}><Download class="size-4" aria-hidden="true" /></a>}
              </li>
            ))}
          </ul>
        )}
      </Card>

      <Card id="offers" title="Offers">
        {offers.length === 0 ? (
          <p class="text-sm text-muted-foreground">{closed ? "No offers were issued." : "Offers appear here when underwriting prices the deal. You'll get an email and, if set up, a webhook."}</p>
        ) : (
          <div class="grid gap-3 sm:grid-cols-2">
            {offers.map((o) => {
              const q = quote(plan, { fundedAmount: o.amount, grade: o.grade, upsellPoints: o.points, termMonths: o.termMonths, frequency: o.frequency });
              return (
                <div class:list={["flex flex-col gap-3 border p-4", o.status === "selected" ? "border-primary bg-primary/5" : "border-border"]}>
                  <div class="flex items-baseline justify-between"><span class="text-xl font-semibold tabular-nums">{formatMoney(o.amount)}</span><span class="text-xs text-muted-foreground">{o.product}</span></div>
                  <dl class="grid grid-cols-2 gap-x-3 gap-y-1 text-sm">
                    <dt class="text-muted-foreground">Factor</dt><dd class="text-right tabular-nums">{q.sellRate.toFixed(2)} <span class="text-xs text-muted-foreground">({PAPER_GRADE_LABEL[o.grade]} {q.buyRate.toFixed(2)} + {o.points} pts)</span></dd>
                    <dt class="text-muted-foreground">Term</dt><dd class="text-right">{o.termMonths} months, {o.frequency}</dd>
                    <dt class="text-muted-foreground">Payment</dt><dd class="text-right tabular-nums">{formatMoney(q.payment, true)} × {q.periods}</dd>
                    <dt class="text-muted-foreground">Payback</dt><dd class="text-right tabular-nums">{formatMoney(q.payback)}</dd>
                    <dt class="font-medium">Your commission</dt><dd class="text-right font-medium tabular-nums">{formatMoney(q.commission)}</dd>
                  </dl>
                  {o.status === "selected" ? <p class="text-sm font-medium text-primary">Selected</p> : <div class="flex gap-2"><Button size="sm">Select for merchant</Button><Button size="sm" variant="outline" as="a" href={`/partner/calculator?amount=${o.amount}&grade=${o.grade}&points=${o.points}&term=${o.termMonths}`}>Reprice</Button></div>}
                </div>
              );
            })}
          </div>
        )}
      </Card>
    </div>

    <div class="flex flex-col gap-6">
      <Card title="Timeline">
        <ol class="flex flex-col gap-4 text-sm">
          {events.map((e) => (
            <li class="flex gap-3">
              <span class="mt-1.5 size-2 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
              <div class="flex flex-col gap-0.5">
                <p>{e.text}</p>
                <p class="text-xs text-muted-foreground">{formatDateTime(e.at)} · {userName(e.actor)}</p>
              </div>
            </li>
          ))}
          <li class="flex gap-3"><span class="mt-1.5 size-2 shrink-0 rounded-full bg-muted-foreground/40" aria-hidden="true"></span><p class="text-muted-foreground">Submitted {formatDateTime(deal.submittedAt)} via {deal.source}</p></li>
        </ol>
      </Card>

      <Card title="Notes" description="Seen by your team and your relationship manager.">
        <form class="flex flex-col gap-2" data-note-form>
          <textarea name="note" rows="3" class="w-full border border-input bg-background p-2 text-sm" placeholder="Context for underwriting, e.g. why the September deposits dipped."></textarea>
          <Button size="sm" type="submit" class="self-end">Add note</Button>
        </form>
      </Card>

      <Card title="Questions?">
        <p class="text-sm text-muted-foreground">Reply to any email about {deal.number} or call {org.relationshipManager.name} on <a href={`tel:${org.relationshipManager.phone}`} class="text-foreground hover:underline">{org.relationshipManager.phone}</a>.</p>
      </Card>
    </div>
  </div>
</PartnerLayout>

<script>
  import "@/lib/portal/deal";
</script>
