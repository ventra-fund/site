---
import PartnerLayout from "@/layouts/PartnerLayout.astro";
import Card from "@/components/partner/Card.astro";
import { Input } from "@/ui/input";
import { DEFAULT_COMMISSION_PLAN as plan, PAPER_GRADE_LABEL, quote, formatMoney } from "@/data/commission-plan";
import { org } from "@/data/portal-fixtures";

// Price a deal: funded amount, paper grade, points, term. The math is src/data/commission-plan.ts,
// run once here for the initial numbers and again in the browser on every change
// (src/lib/portal/calculator.ts). ?amount=&grade=&points=&term= preloads an offer from a deal page.
const initial = { fundedAmount: 100000, grade: "B" as const, upsellPoints: 12, termMonths: 8, frequency: "daily" as const };
const q = quote(plan, initial);
const grades = Object.keys(plan.buyRates) as (keyof typeof plan.buyRates)[];
---

<PartnerLayout title="Commission calculator" current="calculator" intro="What the merchant pays and what you earn, from the buy rate on your plan.">
  <div class="grid gap-6 lg:grid-cols-[2fr_3fr]">
    <Card title="Deal">
      <form data-calc class="flex flex-col gap-5" novalidate>
        <label class="flex flex-col gap-1.5 text-sm font-medium">Funded amount
          <Input name="amount" type="number" inputmode="numeric" min="5000" max="5000000" step="1000" value={String(initial.fundedAmount)} />
        </label>
        <fieldset class="flex flex-col gap-2">
          <legend class="text-sm font-medium">Paper grade</legend>
          <div class="grid grid-cols-2 gap-2">
            {grades.map((g) => (
              <label class="flex cursor-pointer flex-col gap-0.5 border border-border px-3 py-2 has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                <span class="flex items-center gap-2 text-sm font-medium"><input type="radio" name="grade" value={g} checked={g === initial.grade} class="size-4" />{PAPER_GRADE_LABEL[g]}</span>
                <span class="text-xs text-muted-foreground">Buy rate {plan.buyRates[g].toFixed(2)}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <label class="flex flex-col gap-1.5 text-sm font-medium">
          <span class="flex justify-between">Your points <span data-points-label class="tabular-nums">{initial.upsellPoints}</span></span>
          <input name="points" type="range" min="0" max={String(plan.maxUpsellPoints)} step="0.5" value={String(initial.upsellPoints)} class="accent-primary" />
          <span class="flex justify-between text-xs font-normal text-muted-foreground"><span>0 (buy rate)</span><span>{plan.maxUpsellPoints} max</span></span>
        </label>
        <div class="grid grid-cols-2 gap-3">
          <label class="flex flex-col gap-1.5 text-sm font-medium">Term (months)
            <Input name="term" type="number" inputmode="numeric" min="3" max="24" step="1" value={String(initial.termMonths)} />
          </label>
          <label class="flex flex-col gap-1.5 text-sm font-medium">Payments
            <select name="frequency" class="h-9 border border-input bg-background px-2 text-sm font-normal">
              <option value="daily" selected>Daily (21 per month)</option>
              <option value="weekly">Weekly</option>
            </select>
          </label>
        </div>
      </form>
    </Card>

    <div class="flex flex-col gap-6">
      <Card title="Quote">
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
          <div class="flex flex-col"><span class="text-xs text-muted-foreground">Your commission</span><span data-out="commission" class="text-2xl font-semibold tabular-nums text-primary">{formatMoney(q.commission)}</span></div>
          <div class="flex flex-col"><span class="text-xs text-muted-foreground">Sell rate</span><span data-out="sellRate" class="text-2xl font-semibold tabular-nums">{q.sellRate.toFixed(2)}</span></div>
          <div class="flex flex-col"><span class="text-xs text-muted-foreground">Merchant payback</span><span data-out="payback" class="text-2xl font-semibold tabular-nums">{formatMoney(q.payback)}</span></div>
        </div>
        <dl class="grid grid-cols-[1fr_auto] gap-x-6 gap-y-1.5 border-t border-border pt-4 text-sm">
          <dt class="text-muted-foreground">Buy rate</dt><dd data-out="buyRate" class="text-right tabular-nums">{q.buyRate.toFixed(2)}</dd>
          <dt class="text-muted-foreground">Points added</dt><dd data-out="points" class="text-right tabular-nums">{q.points}</dd>
          <dt class="text-muted-foreground">Cost of capital to merchant</dt><dd data-out="cost" class="text-right tabular-nums">{formatMoney(q.payback - initial.fundedAmount)}</dd>
          <dt class="text-muted-foreground">Estimated payment</dt><dd data-out="payment" class="text-right tabular-nums">{formatMoney(q.payment, true)} × {q.periods}</dd>
        </dl>
        <p class="text-xs text-muted-foreground">Estimates. The offer underwriting issues is what counts; a renewal pays {plan.renewalPoints} points; a default within {plan.clawbackDays} days claws the commission back. <a href="/partner/terms#commission" class="underline">Partner terms</a>.</p>
      </Card>

      <Card title="Side by side" description="Every half point, so you can see the trade-off with the merchant's cost.">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="text-xs text-muted-foreground"><tr><th class="py-1 pr-3 font-medium">Points</th><th class="py-1 pr-3 font-medium text-right">Sell rate</th><th class="py-1 pr-3 font-medium text-right">Payback</th><th class="py-1 font-medium text-right">Commission</th></tr></thead>
            <tbody data-table></tbody>
          </table>
        </div>
      </Card>

      <p class="text-xs text-muted-foreground">Plan: <span class="font-medium text-foreground">{plan.name}</span>, set by {org.relationshipManager.name}. Buy rates and the maximum are per organisation and change only with notice.</p>
    </div>
  </div>
</PartnerLayout>

<script>
  import "@/lib/portal/calculator";
</script>
