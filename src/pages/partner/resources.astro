---
import PartnerLayout from "@/layouts/PartnerLayout.astro";
import Card from "@/components/partner/Card.astro";
import { Button } from "@/ui/button";
import { Input } from "@/ui/input";
import { FileText, CirclePlay, BookOpen, ClipboardList, Search } from "@lucide/astro";
import { portalResources, RESOURCE_CATEGORIES } from "@/data/portal-resources";
import { formatDate } from "@/data/portal-fixtures";

// The broker-only library. Everything here is behind sign-in (the decision over Credibly's public
// hub); the real files are served through /api/partner/resources/<slug> from R2.
const icons = { PDF: FileText, Video: CirclePlay, Guide: BookOpen, Form: ClipboardList };
const action = { PDF: "Open PDF", Video: "Watch", Guide: "Read", Form: "Request" };
const hrefFor = (slug: string) => (slug === "api-reference" ? "/partner/developers/docs" : slug === "email-intake" ? "/partner/developers#email" : "#");
---

<PartnerLayout title="Resources" current="resources" intro="Guidelines, one-pagers and tools for partners. Not for merchants; please don't forward.">
  <label class="relative max-w-md">
    <Search class="pointer-events-none absolute top-1/2 left-2.5 size-4 -translate-y-1/2 text-muted-foreground" aria-hidden="true" />
    <Input data-search type="search" placeholder="Search resources" class="pl-8" aria-label="Search resources" />
  </label>

  {RESOURCE_CATEGORIES.map((cat) => (
    <section data-category class="flex flex-col gap-3">
      <h2 class="text-base font-semibold">{cat}</h2>
      <ul class="grid gap-3 sm:grid-cols-2">
        {portalResources.filter((r) => r.category === cat).map((r) => {
          const Icon = icons[r.kind];
          return (
            <li data-resource data-text={`${r.title} ${r.description}`.toLowerCase()}>
              <Card class="h-full">
                <div class="flex items-start gap-3">
                  <Icon class="mt-0.5 size-5 shrink-0 text-primary" aria-hidden="true" />
                  <div class="flex flex-1 flex-col gap-1">
                    <h3 class="font-medium">{r.title}</h3>
                    <p class="text-sm text-muted-foreground">{r.description}</p>
                    <div class="mt-2 flex items-center justify-between gap-3">
                      <span class="text-xs text-muted-foreground">{r.kind} · updated {formatDate(r.updatedAt)}</span>
                      <Button as="a" href={hrefFor(r.slug)} size="sm" variant="outline">{action[r.kind]}</Button>
                    </div>
                  </div>
                </div>
              </Card>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
  <p data-empty hidden class="text-sm text-muted-foreground">Nothing matches.</p>
</PartnerLayout>

<script>
  const search = document.querySelector<HTMLInputElement>("[data-search]");
  const items = [...document.querySelectorAll<HTMLElement>("[data-resource]")];
  const sections = [...document.querySelectorAll<HTMLElement>("[data-category]")];
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  search?.addEventListener("input", () => {
    const q = search.value.trim().toLowerCase();
    let shown = 0;
    for (const it of items) {
      it.hidden = !!q && !(it.dataset.text ?? "").includes(q);
      if (!it.hidden) shown++;
    }
    for (const s of sections) s.hidden = ![...s.querySelectorAll<HTMLElement>("[data-resource]")].some((i) => !i.hidden);
    if (empty) empty.hidden = shown > 0;
  });
</script>
