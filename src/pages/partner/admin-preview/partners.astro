---
import PartnerLayout from "@/layouts/PartnerLayout.astro";
import Card from "@/components/partner/Card.astro";
import { Button } from "@/ui/button";
import { Input } from "@/ui/input";
import { org, users, deals, formatDate } from "@/data/portal-fixtures";
import { DEFAULT_COMMISSION_PLAN as plan } from "@/data/commission-plan";
import { formatMoney } from "@/data/commission-plan";

// PREVIEW of the admin side (/admin/partners when built): partner applications to approve,
// active organisations, and each one's commission plan. Lives under /partner/ for now so it is
// prerendered with fixtures and visible in `pnpm dev`; the real page sits behind the admin guard.
const applications = [
  { name: "Lakeshore Funding Group", contact: "r.chen@lakeshorefg.com", submittedAt: "2026-10-19T15:10:00Z", volume: "$1M to $3M / month", ein: true, w9: false },
  { name: "Atlas Business Advisors", contact: "m.ortiz@atlasba.com", submittedAt: "2026-10-18T09:30:00Z", volume: "Under $500k / month", ein: true, w9: true },
];
const funded = deals.filter((d) => d.status === "funded").reduce((s, d) => s + d.amountRequested, 0);
---

<PartnerLayout title="Partners (admin preview)" current="dashboard" wide intro="What the admin side needs for release 1: approve partners, invite their first user, set their plan.">
  <Card title="Applications" description="From /partner. Approving creates the organisation and emails the contact an invitation as owner.">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="text-xs text-muted-foreground"><tr><th class="py-1.5 pr-3 font-medium">Company</th><th class="py-1.5 pr-3 font-medium">Contact</th><th class="py-1.5 pr-3 font-medium">Volume</th><th class="py-1.5 pr-3 font-medium">Docs</th><th class="py-1.5 pr-3 font-medium">Applied</th><th class="py-1.5"></th></tr></thead>
        <tbody>
          {applications.map((a) => (
            <tr class="border-t border-border">
              <td class="py-2 pr-3 font-medium">{a.name}</td>
              <td class="py-2 pr-3 text-muted-foreground">{a.contact}</td>
              <td class="py-2 pr-3 text-muted-foreground">{a.volume}</td>
              <td class="py-2 pr-3 text-xs">{a.ein ? "EIN ✓" : "EIN —"} · {a.w9 ? "W-9 ✓" : "W-9 —"}</td>
              <td class="whitespace-nowrap py-2 pr-3 text-muted-foreground">{formatDate(a.submittedAt)}</td>
              <td class="py-2 text-right whitespace-nowrap"><Button size="sm" disabled={!a.w9}>Approve &amp; invite</Button> <Button size="sm" variant="ghost">Decline</Button></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Card>

  <Card title="Active organisations">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="text-xs text-muted-foreground"><tr><th class="py-1.5 pr-3 font-medium">Organisation</th><th class="py-1.5 pr-3 font-medium">RM</th><th class="py-1.5 pr-3 font-medium">Users</th><th class="py-1.5 pr-3 font-medium text-right">Deals</th><th class="py-1.5 pr-3 font-medium text-right">Funded</th><th class="py-1.5 pr-3 font-medium">Plan</th><th class="py-1.5 pr-3 font-medium">Intake alias</th></tr></thead>
        <tbody>
          <tr class="border-t border-border">
            <td class="py-2 pr-3"><p class="font-medium">{org.name}</p><p class="text-xs text-muted-foreground">Agreement {formatDate(org.agreementSignedAt)}</p></td>
            <td class="py-2 pr-3 text-muted-foreground">{org.relationshipManager.name}</td>
            <td class="py-2 pr-3 text-muted-foreground">{users.filter((u) => u.status === "active").length} active</td>
            <td class="py-2 pr-3 text-right tabular-nums">{deals.length}</td>
            <td class="py-2 pr-3 text-right tabular-nums">{formatMoney(funded)}</td>
            <td class="py-2 pr-3 text-muted-foreground">{plan.name}</td>
            <td class="py-2 pr-3 font-mono text-xs">{org.inboundAlias}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </Card>

  <Card title={`Commission plan: ${org.name}`} description="Overrides the standard plan for this organisation. The portal's calculator and every offer use it.">
    <form class="grid grid-cols-2 gap-4 sm:grid-cols-4" data-stub>
      <label class="flex flex-col gap-1.5 text-sm font-medium">B paper buy rate<Input name="b" type="number" step="0.01" min="1" max="2" value={String(plan.buyRates.B)} /></label>
      <label class="flex flex-col gap-1.5 text-sm font-medium">C paper buy rate<Input name="c" type="number" step="0.01" min="1" max="2" value={String(plan.buyRates.C)} /></label>
      <label class="flex flex-col gap-1.5 text-sm font-medium">Max upsell points<Input name="max" type="number" step="0.5" min="0" max="20" value={String(plan.maxUpsellPoints)} /></label>
      <label class="flex flex-col gap-1.5 text-sm font-medium">Renewal points<Input name="renewal" type="number" step="0.5" min="0" max="20" value={String(plan.renewalPoints)} /></label>
      <label class="flex flex-col gap-1.5 text-sm font-medium">Clawback days<Input name="clawback" type="number" step="1" min="0" max="180" value={String(plan.clawbackDays)} /></label>
      <label class="col-span-2 flex flex-col gap-1.5 text-sm font-medium">Payout timing<Input name="payout" value={plan.payoutTiming} /></label>
      <div class="col-span-full flex items-center gap-3"><Button type="submit" size="sm">Save plan</Button><span class="text-xs text-muted-foreground">Changes apply to offers issued from now; the partner is emailed.</span></div>
    </form>
  </Card>
</PartnerLayout>

<script>
  document.querySelector<HTMLFormElement>("form[data-stub]")?.addEventListener("submit", (e) => { e.preventDefault(); alert("Prototype: the plan would be saved for this organisation."); });
</script>
