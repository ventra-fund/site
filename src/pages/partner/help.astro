---
import PartnerLayout from "@/layouts/PartnerLayout.astro";
import Card from "@/components/partner/Card.astro";
import { Button } from "@/ui/button";
import { Mail, Phone } from "@lucide/astro";
import { org } from "@/data/portal-fixtures";

const faqs = [
  { q: "How long until I hear back on a submission?", a: "A complete package gets a first response within one business day. A deal in Needs details waits on you, not us." },
  { q: "What puts a deal on hold?", a: "Missing statement pages, undisclosed positions, or a mismatch between the application and the statements. The deal page lists exactly what's needed." },
  { q: "When is commission paid?", a: "The next business day after funding, by ACH. The remittance is emailed and shown on the deal." },
  { q: "Can I change an offer's points after it's issued?", a: "Yes, down to the buy rate, from the deal page before the merchant signs. Reprice opens the calculator with that offer loaded." },
  { q: "Can my CRM submit for me?", a: "Yes. Create an API key under Developers; Cloudsquare and similar CRMs integrate against the same contract. Emailing your package to your intake address also works." },
];
---

<PartnerLayout title="Help" current="help">
  <div class="grid gap-6 lg:grid-cols-[2fr_3fr]">
    <div class="flex flex-col gap-6">
      <Card title="Your relationship manager">
        <p class="text-sm font-medium">{org.relationshipManager.name}</p>
        <div class="flex flex-col gap-2 text-sm">
          <a href={`mailto:${org.relationshipManager.email}`} class="flex items-center gap-2 text-muted-foreground hover:text-foreground"><Mail class="size-4" aria-hidden="true" /> {org.relationshipManager.email}</a>
          <a href={`tel:${org.relationshipManager.phone}`} class="flex items-center gap-2 text-muted-foreground hover:text-foreground"><Phone class="size-4" aria-hidden="true" /> {org.relationshipManager.phone}</a>
        </div>
        <p class="text-xs text-muted-foreground">Weekdays 8am to 7pm ET. For a deal, reply to any email about it so the thread stays with the file.</p>
      </Card>
      <Card title="Partner support">
        <p class="text-sm text-muted-foreground">Portal, sign-in and API questions.</p>
        <a href="mailto:partners@ventrafund.com" class="text-sm text-primary hover:underline">partners@ventrafund.com</a>
        <Button as="a" href="/partner/resources" variant="outline" size="sm" class="self-start">Portal guide</Button>
      </Card>
    </div>
    <Card title="Common questions">
      <dl class="flex flex-col gap-4 text-sm">
        {faqs.map((f) => <div><dt class="font-medium">{f.q}</dt><dd class="text-muted-foreground">{f.a}</dd></div>)}
      </dl>
    </Card>
  </div>
</PartnerLayout>
