---
import PartnerLayout from "@/layouts/PartnerLayout.astro";
import Card from "@/components/partner/Card.astro";
import { Button } from "@/ui/button";
import { Input } from "@/ui/input";
import { UserPlus } from "@lucide/astro";
import { users, ROLE_LABEL, currentUser, formatDateTime, org } from "@/data/portal-fixtures";

// Who can act for the organisation. Owners and admins invite by email and pick a role; a member
// signs in with a code to the invited address. Credibly's Admin/User split, with Owner on top.
const methodLabel = { code: "Email code", password_code: "Password + code", passkey: "Passkey" };
const statusClass = { active: "text-emerald-700 dark:text-emerald-300", invited: "text-amber-700 dark:text-amber-300", deactivated: "text-muted-foreground" };
---

<PartnerLayout title="Team" current="team" intro={`People who can submit and see deals for ${org.name}.`}>
  <Fragment slot="actions">
    <Button data-invite-open><UserPlus class="size-4" aria-hidden="true" /> Invite</Button>
  </Fragment>

  <Card data-invite-card hidden title="Invite a teammate" description="They get an email with a link; signing in with a code to that address joins them.">
    <form data-invite-form class="grid grid-cols-1 gap-4 sm:grid-cols-[2fr_1fr_auto]" novalidate>
      <label class="flex flex-col gap-1.5 text-sm font-medium">Work email<Input name="email" type="email" required placeholder="name@yourcompany.com" /></label>
      <label class="flex flex-col gap-1.5 text-sm font-medium">Role
        <select name="role" class="h-9 border border-input bg-background px-2 text-sm font-normal">
          <option value="member">Member</option>
          <option value="admin">Admin</option>
        </select>
      </label>
      <Button type="submit" class="self-end">Send invite</Button>
    </form>
    <ul class="grid gap-1 text-xs text-muted-foreground sm:grid-cols-3">
      {(Object.keys(ROLE_LABEL) as (keyof typeof ROLE_LABEL)[]).map((r) => <li><span class="font-medium text-foreground">{ROLE_LABEL[r].label}:</span> {ROLE_LABEL[r].help}</li>)}
    </ul>
  </Card>

  <div class="overflow-x-auto border border-border">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-border bg-muted/40 text-xs text-muted-foreground">
        <tr><th class="px-3 py-2 font-medium">Name</th><th class="px-3 py-2 font-medium">Role</th><th class="px-3 py-2 font-medium">Status</th><th class="px-3 py-2 font-medium">Sign-in</th><th class="px-3 py-2 font-medium">Last active</th><th class="px-3 py-2"></th></tr>
      </thead>
      <tbody>
        {users.map((u) => (
          <tr class="border-b border-border last:border-0">
            <td class="px-3 py-2"><p class="font-medium">{u.name}{u.id === currentUser.id && <span class="ml-2 text-xs font-normal text-muted-foreground">you</span>}</p><p class="text-xs text-muted-foreground">{u.email}</p></td>
            <td class="px-3 py-2">
              {u.role === "owner" || u.id === currentUser.id ? ROLE_LABEL[u.role].label : (
                <select class="h-8 border border-input bg-background px-2 text-sm" aria-label={`Role for ${u.name}`}>
                  <option value="admin" selected={u.role === "admin"}>Admin</option>
                  <option value="member" selected={u.role === "member"}>Member</option>
                </select>
              )}
            </td>
            <td class:list={["px-3 py-2 capitalize", statusClass[u.status]]}>{u.status}</td>
            <td class="px-3 py-2 text-muted-foreground">{methodLabel[u.signInMethod]}</td>
            <td class="whitespace-nowrap px-3 py-2 text-muted-foreground">{u.lastActiveAt ? formatDateTime(u.lastActiveAt) : "—"}</td>
            <td class="px-3 py-2 text-right">
              {u.status === "invited" ? <Button size="sm" variant="outline">Resend invite</Button> : u.id !== currentUser.id && u.role !== "owner" ? <Button size="sm" variant="ghost" class="text-destructive">Deactivate</Button> : null}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="text-xs text-muted-foreground">Deactivating keeps the person's deals and history; they just can't sign in. Only the owner can transfer ownership, from Settings.</p>
</PartnerLayout>

<script>
  const card = document.querySelector<HTMLElement>("[data-invite-card]");
  document.querySelector("[data-invite-open]")?.addEventListener("click", () => {
    if (!card) return;
    card.hidden = false;
    card.querySelector("input")?.focus();
  });
  document.querySelector<HTMLFormElement>("[data-invite-form]")?.addEventListener("submit", (e) => {
    e.preventDefault();
    alert("Prototype: an invitation email would be sent.");
  });
</script>
