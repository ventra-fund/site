---
import PartnerLayout from "@/layouts/PartnerLayout.astro";
import Card from "@/components/partner/Card.astro";
import { Button } from "@/ui/button";
import { Input } from "@/ui/input";
import { Checkbox } from "@/ui/checkbox";
import { KeyRound, Webhook, BookOpen, Copy, RefreshCw } from "@lucide/astro";
import { apiKeys, API_SCOPES, webhookEndpoints, webhookDeliveries, WEBHOOK_EVENTS, intakeEmails, users, org, userName, formatDateTime, relativeDay } from "@/data/portal-fixtures";

// The three machine channels in one place: API keys, webhooks and email intake. Keys and
// webhook secrets are shown once at creation and only ever as a hint afterwards.
const activeKeys = apiKeys.filter((k) => k.status === "active");
const revokedKeys = apiKeys.filter((k) => k.status === "revoked");
const deliveryTone = { delivered: "text-emerald-700 dark:text-emerald-300", failed: "text-destructive", retrying: "text-amber-700 dark:text-amber-300" };
const members = users.filter((u) => u.status === "active");
---

<PartnerLayout title="Developers" current="developers" wide intro="Submit from your CRM with the API, get told about changes with webhooks, or just email the package.">
  <Fragment slot="actions">
    <Button as="a" href="/partner/developers/docs" variant="outline"><BookOpen class="size-4" aria-hidden="true" /> API reference</Button>
  </Fragment>

  <Card id="keys" title="API keys" description="Bearer tokens for the Partner API. Live keys reach underwriting; test keys hit the sandbox.">
    <Fragment slot="actions"><Button size="sm" data-key-create-open><KeyRound class="size-4" aria-hidden="true" /> Create key</Button></Fragment>

    <form data-key-form hidden class="flex flex-col gap-4 border border-border bg-muted/30 p-4" novalidate>
      <div class="grid gap-4 sm:grid-cols-[2fr_1fr_1fr]">
        <label class="flex flex-col gap-1.5 text-sm font-medium">Name<Input name="name" required placeholder="e.g. Cloudsquare prod" /></label>
        <label class="flex flex-col gap-1.5 text-sm font-medium">Environment
          <select name="environment" class="h-9 border border-input bg-background px-2 text-sm font-normal"><option value="live">Live</option><option value="test">Test (sandbox)</option></select>
        </label>
        <label class="flex flex-col gap-1.5 text-sm font-medium">Expires
          <select name="expires" class="h-9 border border-input bg-background px-2 text-sm font-normal"><option value="">Never</option><option value="90">In 90 days</option><option value="365">In a year</option></select>
        </label>
      </div>
      <fieldset class="flex flex-col gap-2">
        <legend class="text-sm font-medium">Scopes</legend>
        <div class="grid gap-2 sm:grid-cols-2">
          {API_SCOPES.map((s) => <Checkbox id={`scope-${s.key}`} name="scopes" value={s.key} defaultChecked={s.key !== "webhooks:manage"}>{s.label} <span class="font-mono text-xs text-muted-foreground">{s.key}</span></Checkbox>)}
        </div>
      </fieldset>
      <div class="flex gap-2"><Button type="submit" size="sm">Create</Button><Button type="button" size="sm" variant="outline" data-key-cancel>Cancel</Button></div>
    </form>

    <div data-key-reveal hidden class="flex flex-col gap-3 border border-primary bg-primary/5 p-4">
      <p class="text-sm font-medium">Copy your key now. It won't be shown again.</p>
      <div class="flex items-center gap-2">
        <code data-key-value class="flex-1 overflow-x-auto bg-background px-3 py-2 font-mono text-sm"></code>
        <Button size="sm" variant="outline" data-key-copy><Copy class="size-4" aria-hidden="true" /> Copy</Button>
      </div>
      <p class="text-xs text-muted-foreground">Send it as <code class="font-mono">Authorization: Bearer &lt;key&gt;</code>. Store it in your CRM's secret store, never in code.</p>
      <Button size="sm" variant="ghost" class="self-start" data-key-done>Done</Button>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="text-xs text-muted-foreground"><tr><th class="py-1.5 pr-3 font-medium">Name</th><th class="py-1.5 pr-3 font-medium">Key</th><th class="py-1.5 pr-3 font-medium">Scopes</th><th class="py-1.5 pr-3 font-medium">Last used</th><th class="py-1.5 pr-3 font-medium">Created</th><th class="py-1.5"></th></tr></thead>
        <tbody data-key-rows>
          {activeKeys.map((k) => (
            <tr class="border-t border-border">
              <td class="py-2 pr-3"><p class="font-medium">{k.name}</p><p class="text-xs text-muted-foreground">{k.environment === "test" ? "Sandbox" : "Live"}{k.expiresAt && ` · expires ${relativeDay(k.expiresAt) === "today" ? "today" : formatDateTime(k.expiresAt)}`}</p></td>
              <td class="py-2 pr-3 font-mono text-xs">{k.display}</td>
              <td class="py-2 pr-3 text-xs text-muted-foreground">{k.scopes.length === API_SCOPES.length ? "All" : k.scopes.map((s) => s.split(":")[0]).filter((v, i, a) => a.indexOf(v) === i).join(", ")}</td>
              <td class="whitespace-nowrap py-2 pr-3 text-muted-foreground">{k.lastUsedAt ? relativeDay(k.lastUsedAt) : "Never"}</td>
              <td class="whitespace-nowrap py-2 pr-3 text-muted-foreground">{formatDateTime(k.createdAt)} · {userName(k.createdBy)}</td>
              <td class="py-2 text-right whitespace-nowrap"><Button size="sm" variant="ghost" title="Issue a new key and revoke this one after 24 hours"><RefreshCw class="size-4" aria-hidden="true" /> Rotate</Button><Button size="sm" variant="ghost" class="text-destructive">Revoke</Button></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {revokedKeys.length > 0 && <p class="text-xs text-muted-foreground">{revokedKeys.length} revoked key{revokedKeys.length === 1 ? "" : "s"}: {revokedKeys.map((k) => `${k.name} (${k.display})`).join(", ")}.</p>}
    <p class="text-xs text-muted-foreground">Limits: 60 requests a minute per key, 10 document uploads a minute. Over the limit returns 429 with Retry-After.</p>
  </Card>

  <div class="grid gap-6 lg:grid-cols-2">
    <Card id="webhooks" title="Webhooks" description="We POST to your endpoint when a deal changes. Signed, retried for 24 hours.">
      <Fragment slot="actions"><Button size="sm" variant="outline" data-webhook-open><Webhook class="size-4" aria-hidden="true" /> Add endpoint</Button></Fragment>
      <form data-webhook-form hidden class="flex flex-col gap-3 border border-border bg-muted/30 p-4" novalidate>
        <label class="flex flex-col gap-1.5 text-sm font-medium">Endpoint URL<Input name="url" type="url" required placeholder="https://" /></label>
        <fieldset class="flex flex-col gap-2"><legend class="text-sm font-medium">Events</legend>{WEBHOOK_EVENTS.map((e) => <Checkbox id={`ev-${e.key}`} name="events" value={e.key} defaultChecked>{e.label} <span class="font-mono text-xs text-muted-foreground">{e.key}</span></Checkbox>)}</fieldset>
        <div class="flex gap-2"><Button type="submit" size="sm">Add</Button><Button type="button" size="sm" variant="outline" data-webhook-cancel>Cancel</Button></div>
      </form>
      {webhookEndpoints.map((w) => (
        <div class="flex flex-col gap-2 border border-border p-3 text-sm">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <code class="font-mono text-xs">{w.url}</code>
            <span class="text-xs capitalize text-muted-foreground">{w.status} · secret {w.secretHint}</span>
          </div>
          <p class="text-xs text-muted-foreground">{w.events.join(", ")}</p>
          <div class="flex gap-2"><Button size="sm" variant="outline" data-webhook-test>Send test event</Button><Button size="sm" variant="ghost">Rotate secret</Button><Button size="sm" variant="ghost" class="text-destructive">Delete</Button></div>
        </div>
      ))}
      <div class="flex flex-col gap-1">
        <p class="text-sm font-medium">Recent deliveries</p>
        <ul class="divide-y divide-border text-xs">
          {webhookDeliveries.map((d) => (
            <li class="flex flex-wrap items-center justify-between gap-2 py-1.5">
              <span class="font-mono">{d.event}</span>
              <span class="text-muted-foreground">{d.dealNumber} · {formatDateTime(d.at)}</span>
              <span class={deliveryTone[d.status]}>{d.status}{d.responseCode ? ` · ${d.responseCode}` : ""} · {d.attempts} attempt{d.attempts === 1 ? "" : "s"}{d.status !== "delivered" && <button type="button" class="ml-2 underline">Retry</button>}</span>
            </li>
          ))}
        </ul>
      </div>
      <p class="text-xs text-muted-foreground">Verify <code class="font-mono">X-Ventra-Signature</code> (HMAC-SHA256 of <code class="font-mono">timestamp.body</code>) and reject timestamps older than 5 minutes. Details in the <a href="/partner/developers/docs#webhooks" class="underline">reference</a>.</p>
    </Card>

    <Card id="email" title="Email intake" description="No integration needed. Email the package from a team address and a deal is created.">
      <div class="flex flex-col gap-1">
        <p class="text-xs text-muted-foreground">Your intake address</p>
        <div class="flex items-center gap-2"><code class="flex-1 overflow-x-auto bg-muted px-3 py-2 font-mono text-sm">{org.inboundAlias}</code><Button size="sm" variant="outline" data-copy={org.inboundAlias}><Copy class="size-4" aria-hidden="true" /> Copy</Button></div>
      </div>
      <ul class="flex flex-col gap-1.5 text-sm text-muted-foreground">
        <li>Subject becomes the merchant name. Put the amount in it too, e.g. <span class="font-mono text-xs">Harbor Lights Seafood - MCA 85k</span>.</li>
        <li>Attach the signed application and statements as PDF, JPG or PNG. Anything else is ignored and listed on the deal.</li>
        <li>The deal lands in <span class="font-medium text-foreground">Needs details</span>; the auto-reply links to the deal to finish it.</li>
        <li>Accepted senders are your active team members, below. A package from anyone else is held, never dropped, and you're emailed.</li>
      </ul>
      <div class="flex flex-col gap-1">
        <p class="text-sm font-medium">Accepted senders</p>
        <ul class="flex flex-wrap gap-2 text-xs">{members.map((m) => <li class="bg-muted px-2 py-1 font-mono">{m.email}</li>)}</ul>
        <p class="text-xs text-muted-foreground">Add a shared mailbox from <a href="/partner/team" class="underline">Team</a> as a member.</p>
      </div>
      <div class="flex flex-col gap-1">
        <p class="text-sm font-medium">Recent emails</p>
        <ul class="divide-y divide-border text-xs">
          {intakeEmails.filter((e) => e.orgId === org.id).map((e) => (
            <li class="flex flex-col gap-0.5 py-1.5">
              <div class="flex flex-wrap justify-between gap-2"><span class="font-medium">{e.subject}</span><span class="text-muted-foreground">{formatDateTime(e.receivedAt)}</span></div>
              <div class="flex flex-wrap gap-2 text-muted-foreground"><span class="font-mono">{e.from}</span><span>{e.attachments} attachment{e.attachments === 1 ? "" : "s"}</span><span class:list={[e.status === "matched" ? "text-emerald-700 dark:text-emerald-300" : "text-amber-700 dark:text-amber-300"]}>{e.note}</span></div>
            </li>
          ))}
        </ul>
      </div>
    </Card>
  </div>
</PartnerLayout>

<script>
  import "@/lib/portal/developers";
</script>
