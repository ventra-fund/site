---
import PartnerLayout from "@/layouts/PartnerLayout.astro";
import Card from "@/components/partner/Card.astro";
import spec from "@/data/openapi-v1.json";

// The API reference, rendered from the OpenAPI file so the docs and the contract are one thing.
// A deliberately plain renderer: paths grouped by tag, then the schemas. The file itself will be
// served at /api/v1/openapi.json for tools.
type Op = { tags?: string[]; summary?: string; description?: string; operationId?: string; parameters?: any[]; requestBody?: any; responses?: Record<string, any> };
const methods = ["get", "post", "patch", "put", "delete"] as const;
const ops: { method: string; path: string; op: Op }[] = [];
for (const [path, item] of Object.entries(spec.paths as Record<string, any>)) {
  for (const m of methods) if (item[m]) ops.push({ method: m, path, op: item[m] });
}
const byTag = spec.tags.map((t) => ({ tag: t.name, ops: ops.filter((o) => o.op.tags?.includes(t.name)) }));
const schemas = spec.components.schemas as Record<string, any>;
const refName = (ref: string) => ref.split("/").pop()!;
const typeOf = (s: any): string => {
  if (!s) return "";
  if (s.$ref) return refName(s.$ref);
  if (s.allOf) return s.allOf.map(typeOf).join(" & ");
  if (s.type === "array") return `${typeOf(s.items)}[]`;
  if (Array.isArray(s.type)) return s.type.join(" | ");
  if (s.enum) return s.enum.map((e: string) => `"${e}"`).join(" | ");
  return s.format ? `${s.type} (${s.format})` : s.type ?? "object";
};
const bodySchema = (rb: any) => rb?.content?.["application/json"]?.schema ?? rb?.content?.["multipart/form-data"]?.schema;
const methodTone: Record<string, string> = { get: "bg-emerald-500/15 text-emerald-700 dark:text-emerald-300", post: "bg-primary/10 text-primary", patch: "bg-amber-500/15 text-amber-700 dark:text-amber-300", delete: "bg-destructive/10 text-destructive", put: "bg-muted" };
const webhook = (spec as any).webhooks?.event?.post;
---

<PartnerLayout title="API reference" current="developers" wide intro={`${spec.info.title} ${spec.info.version}. Bearer-token REST, JSON in and out.`}>
  <div class="grid gap-6 lg:grid-cols-[12rem_1fr]">
    <nav class="flex flex-col gap-1 text-sm lg:sticky lg:top-6 lg:self-start" aria-label="Reference">
      <a href="#intro" class="text-muted-foreground hover:text-foreground">Overview</a>
      {byTag.map((t) => <a href={`#${t.tag.toLowerCase()}`} class="text-muted-foreground hover:text-foreground">{t.tag}</a>)}
      <a href="#webhooks" class="text-muted-foreground hover:text-foreground">Webhook delivery</a>
      <a href="#schemas" class="text-muted-foreground hover:text-foreground">Schemas</a>
      <a href="/api/v1/openapi.json" class="mt-2 text-primary hover:underline">openapi.json</a>
    </nav>

    <div class="flex min-w-0 flex-col gap-8">
      <Card id="intro" title="Overview">
        <div class="flex flex-col gap-3 text-sm text-muted-foreground">
          {spec.info.description.split("\n\n").map((p) => <p>{p}</p>)}
          <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
            {spec.servers.map((s) => <><dt class="text-foreground">{s.description}</dt><dd class="font-mono text-xs">{s.url}</dd></>)}
          </dl>
          <pre class="overflow-x-auto bg-muted p-3 font-mono text-xs text-foreground">{`curl https://ventrafund.com/api/v1/submissions \\
  -H "Authorization: Bearer vf_live_…" \\
  -H "Idempotency-Key: crm-88213" \\
  -H "Content-Type: application/json" \\
  -d '{"business": {…}, "owners": [{…}], "product": "merchant_cash_advance", "amount_requested": 85000}'`}</pre>
          <p>Errors are <code class="font-mono text-xs">{`{ "error": "<code>", "message": "…", "issues": [...] }`}</code>. Rate limits: 60 requests a minute per key; 429 carries <code class="font-mono text-xs">Retry-After</code>.</p>
        </div>
      </Card>

      {byTag.map((t) => (
        <section id={t.tag.toLowerCase()} class="flex flex-col gap-4">
          <h2 class="text-lg font-semibold">{t.tag}</h2>
          {t.ops.map(({ method, path, op }) => {
            const body = bodySchema(op.requestBody);
            return (
              <Card id={op.operationId}>
                <div class="flex flex-wrap items-center gap-2">
                  <span class:list={["px-1.5 py-0.5 font-mono text-xs font-semibold uppercase", methodTone[method]]}>{method}</span>
                  <code class="font-mono text-sm">{path}</code>
                  <span class="text-sm text-muted-foreground">{op.summary}</span>
                </div>
                {op.description && <p class="text-sm text-muted-foreground">{op.description}</p>}
                {op.parameters && op.parameters.length > 0 && (
                  <div class="flex flex-col gap-1 text-sm">
                    <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Parameters</p>
                    <ul class="flex flex-col gap-1">{op.parameters.map((p: any) => { const r = p.$ref ? (spec.components.parameters as any)[refName(p.$ref)] : p; return <li><code class="font-mono text-xs">{r.name}</code> <span class="text-xs text-muted-foreground">{r.in}{r.required ? ", required" : ""}</span>{r.description && <span class="text-muted-foreground"> · {r.description}</span>}</li>; })}</ul>
                  </div>
                )}
                {body && (
                  <div class="flex flex-col gap-1 text-sm">
                    <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Body</p>
                    {body.$ref ? <p>See <a href={`#schema-${refName(body.$ref)}`} class="text-primary hover:underline">{refName(body.$ref)}</a>.</p> : (
                      <ul class="flex flex-col gap-1">{Object.entries(body.properties ?? {}).map(([k, v]: [string, any]) => <li><code class="font-mono text-xs">{k}</code> <span class="text-xs text-muted-foreground">{typeOf(v)}{body.required?.includes(k) ? ", required" : ""}</span>{v.description && <span class="text-muted-foreground"> · {v.description}</span>}</li>)}</ul>
                    )}
                  </div>
                )}
                <div class="flex flex-col gap-1 text-sm">
                  <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Responses</p>
                  <ul class="flex flex-col gap-1">{Object.entries(op.responses ?? {}).map(([code, r]: [string, any]) => { const res = r.$ref ? (spec.components.responses as any)[refName(r.$ref)] : r; const schema = res.content?.["application/json"]?.schema; return <li><code class="font-mono text-xs">{code}</code> <span class="text-muted-foreground">{res.description}</span>{schema && <span class="text-xs text-muted-foreground"> · {typeOf(schema)}</span>}</li>; })}</ul>
                </div>
              </Card>
            );
          })}
        </section>
      ))}

      <section id="webhooks" class="flex flex-col gap-4">
        <h2 class="text-lg font-semibold">Webhook delivery</h2>
        <Card>
          <p class="text-sm text-muted-foreground">{webhook?.description}</p>
          <p class="text-sm">Body: <a href="#schema-WebhookEvent" class="text-primary hover:underline">WebhookEvent</a>.</p>
          <pre class="overflow-x-auto bg-muted p-3 font-mono text-xs">{`// Node
const [t, v1] = sig.split(",").map((p) => p.split("=")[1]);
const expected = createHmac("sha256", secret).update(\`\${t}.\${rawBody}\`).digest("hex");
if (!timingSafeEqual(Buffer.from(v1), Buffer.from(expected))) throw new Error("bad signature");
if (Date.now() / 1000 - Number(t) > 300) throw new Error("stale");`}</pre>
        </Card>
      </section>

      <section id="schemas" class="flex flex-col gap-4">
        <h2 class="text-lg font-semibold">Schemas</h2>
        {Object.entries(schemas).map(([name, s]) => (
          <Card id={`schema-${name}`} title={name} description={s.description}>
            {s.enum ? (
              <p class="font-mono text-xs">{s.enum.join(" · ")}</p>
            ) : s.properties ? (
              <ul class="flex flex-col gap-1 text-sm">{Object.entries(s.properties).map(([k, v]: [string, any]) => <li><code class="font-mono text-xs">{k}</code> <span class="text-xs text-muted-foreground">{typeOf(v)}{s.required?.includes(k) ? ", required" : ""}</span>{v.description && <span class="text-muted-foreground"> · {v.description}</span>}</li>)}</ul>
            ) : <p class="text-xs text-muted-foreground">{typeOf(s)}</p>}
          </Card>
        ))}
      </section>
    </div>
  </div>
</PartnerLayout>
