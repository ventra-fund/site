---
import PageShell from "@/components/page/PageShell.astro";
import PageHero from "@/components/page/PageHero.astro";
import Section from "@/components/page/Section.astro";
import FeatureTiles from "@/components/page/FeatureTiles.astro";
import CtaBand from "@/components/page/CtaBand.astro";
import { industries, moreIndustries, notFunded } from "@/data/industries";
import { photos } from "@/data/photos";
import { minimumRequirements } from "@/data/funding-products";
import { isoProgram, underwriterAvailability } from "@/data/iso-program";
import CheckList from "@/components/page/CheckList.astro";
import { CalendarCheck, CircleDollarSign, Gauge, Landmark, X } from "@lucide/astro";
---

<PageShell title="Deal guidelines">
  <PageHero eyebrow="Deal guidelines" title="What we fund" cta={{ href: "/partner", label: "Onboard now" }} secondary={{ href: "/why-us/how-it-works", label: "How submissions work" }} image={[photos.mechanicWorkshop, photos.florist, photos.constructionSite, photos.barista]}>
    <p>B and C paper, in hundreds of industries. If your merchant has steady deposits and some history, send the file over.</p>
  </PageHero>

  <Section title="Minimums" intro="The lowest across our products; each product's page lists its own." tone="muted">
    <FeatureTiles
      columns={4}
      items={[
        { icon: CalendarCheck, title: `In business ${minimumRequirements.timeInBusiness}`, text: "Long enough to show a track record." },
        { icon: Gauge, title: `Credit score ${minimumRequirements.creditScore}+`, text: "For every owner on the file." },
        { icon: CircleDollarSign, title: `${minimumRequirements.monthlyRevenue} monthly revenue`, text: "Consistent deposits in the business account." },
        { icon: Landmark, title: "Business checking", text: "To verify revenue and receive the funds." },
      ]}
    />
  </Section>

  <Section title="Paper and positions">
    <CheckList
      columns={2}
      items={[
        { title: "B and C paper", text: "We underwrite on deposits and cash flow, so imperfect credit isn't an automatic decline." },
        { title: "Open positions", text: "Files with existing advances are considered. If the stack is the problem, a consolidation can pay it off." },
        { title: "Pre-approval first", text: "Automated checks of industry type and position stack come first, so you hear early if a file won't fit." },
        { title: "Then a person", text: `A human underwriter makes the decision. You can reach one live, ${underwriterAvailability}.` },
      ]}
    />
  </Section>

  <Section title="What a submission needs" tone="muted">
    <CheckList items={isoProgram.stips} columns={2} />
  </Section>

  <Section title="Industries we fund">
    <ul class="grid list-none grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {industries.map((ind) => (
        <li>
          <a href={`/who-we-fund/${ind.slug}`} class="flex h-full flex-col gap-2 border border-border bg-card p-6 transition-colors hover:border-foreground">
            <span class="text-xl font-bold text-foreground">{ind.name}</span>
            <span class="text-base text-muted-foreground">{ind.intro}</span>
            <span class="mt-auto pt-2 text-sm font-medium text-foreground">Guidelines →</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="flex flex-col gap-4">
      <h3 class="text-xl font-bold text-foreground">And many more, including</h3>
      <ul class="flex list-none flex-wrap gap-2">
        {moreIndustries.map((name) => <li class="bg-secondary px-3 py-1.5 text-sm text-secondary-foreground">{name}</li>)}
      </ul>
    </div>
  </Section>

  <Section title="What we don't fund" tone="muted">
    <ul class="grid list-none grid-cols-1 gap-4 sm:grid-cols-2">
      {notFunded.map((item) => (
        <li class="flex items-center gap-3 text-base text-foreground"><X class="size-5 shrink-0 text-destructive" aria-hidden="true" />{item}</li>
      ))}
    </ul>
  </Section>

  <CtaBand />
</PageShell>
