---
import PageShell from "@/components/page/PageShell.astro";
import PageHero from "@/components/page/PageHero.astro";
import Section from "@/components/page/Section.astro";
import FeatureTiles from "@/components/page/FeatureTiles.astro";
import CtaBand from "@/components/page/CtaBand.astro";
import Disclaimer from "@/components/page/Disclaimer.astro";
import { industries, moreIndustries, notFunded } from "@/data/industries";
import { photos } from "@/data/photos";
import { minimumRequirements } from "@/data/funding-products";
import { Store, CalendarCheck, CircleDollarSign, Gauge, Landmark, Rocket, X } from "@lucide/astro";
---

<PageShell title="Who we fund">
  <PageHero eyebrow="Who we fund" title="Funding for established small businesses" cta={{ href: "/apply", label: "Check eligibility" }} image={[photos.mechanicWorkshop, photos.florist, photos.constructionSite, photos.barista]}>
    <p>We work with businesses across hundreds of industries nationwide. If you've been operating for a while and have steady revenue, there's a good chance we can help.</p>
  </PageHero>

  <Section title="Do you qualify?" intro="These are the basics we look at first. If you have them covered, the application takes a few minutes and won't affect your credit score." tone="muted">
    <FeatureTiles
      items={[
        { icon: CalendarCheck, title: `In business ${minimumRequirements.timeInBusiness}`, text: "Enough history to show your business has staying power." },
        { icon: Gauge, title: `Credit score ${minimumRequirements.creditScore}+`, text: "Your credit doesn't need to be perfect. The minimum applies to every owner on the application." },
        { icon: CircleDollarSign, title: `${minimumRequirements.monthlyRevenue} monthly revenue`, text: "Consistent deposits that show up in your business bank statements." },
        { icon: Store, title: "An eligible industry", text: "We fund most industries. If you're not sure about yours, ask us." },
        { icon: Landmark, title: "A business checking account", text: "We use it to verify revenue and deposit your funds quickly." },
        { icon: Rocket, title: "Not a startup", text: "We fund operating businesses, not new ventures or ideas." },
      ]}
    />
  </Section>

  <Section title="Industries we serve">
    <ul class="grid list-none grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {industries.map((ind) => (
        <li>
          <a href={`/who-we-fund/${ind.slug}`} class="flex h-full flex-col gap-2 border border-border bg-card p-6 transition-colors hover:border-primary">
            <span class="text-xl font-bold text-foreground">{ind.name}</span>
            <span class="text-base text-muted-foreground">{ind.intro}</span>
            <span class="mt-auto pt-2 text-sm font-semibold text-primary">Learn more →</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="flex flex-col gap-4">
      <h3 class="text-xl font-bold text-foreground">And many more, including</h3>
      <ul class="flex list-none flex-wrap gap-2">
        {moreIndustries.map((name) => <li class="bg-secondary px-3 py-1.5 text-sm text-secondary-foreground">{name}</li>)}
      </ul>
    </div>
  </Section>

  <Section title="What we don't fund" intro="We focus on working capital for established businesses, so a few things are outside what we do." tone="muted">
    <ul class="grid list-none grid-cols-1 gap-4 sm:grid-cols-2">
      {notFunded.map((item) => (
        <li class="flex items-center gap-3 text-base text-foreground"><X class="size-5 shrink-0 text-destructive" aria-hidden="true" />{item}</li>
      ))}
    </ul>
  </Section>

  <CtaBand />
  <Disclaimer />
</PageShell>
