---
import PageShell from "@/components/page/PageShell.astro";
import PageHero from "@/components/page/PageHero.astro";
import Section from "@/components/page/Section.astro";
import FeatureTiles from "@/components/page/FeatureTiles.astro";
import CtaBand from "@/components/page/CtaBand.astro";
import { industries, moreIndustries, notFunded } from "@/data/industries";
import { photos } from "@/data/photos";
import { minimumRequirements } from "@/data/funding-products";
import { CalendarCheck, CircleDollarSign, Gauge, Landmark, X } from "@lucide/astro";
---

<PageShell title="Who we fund">
  <PageHero eyebrow="Who we fund" title="Funding for established small businesses" cta={{ href: "/apply", label: "Check eligibility" }} image={[photos.mechanicWorkshop, photos.florist, photos.constructionSite, photos.barista]}>
    <p>We fund businesses in hundreds of industries. If you have steady revenue and some history, there's a good chance we can help.</p>
  </PageHero>

  <Section title="Do you qualify?" tone="muted">
    <FeatureTiles
      columns={4}
      items={[
        { icon: CalendarCheck, title: `In business ${minimumRequirements.timeInBusiness}`, text: "Long enough to show a track record." },
        { icon: Gauge, title: `Credit score ${minimumRequirements.creditScore}+`, text: "Applies to every owner on the application." },
        { icon: CircleDollarSign, title: `${minimumRequirements.monthlyRevenue} monthly revenue`, text: "Consistent deposits in your business account." },
        { icon: Landmark, title: "Business checking", text: "To verify revenue and receive your funds." },
      ]}
    />
  </Section>

  <Section title="Industries we serve">
    <ul class="grid list-none grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {industries.map((ind) => (
        <li>
          <a href={`/who-we-fund/${ind.slug}`} class="flex h-full flex-col gap-2 border border-border bg-card p-6 transition-colors hover:border-primary">
            <span class="text-xl font-bold text-foreground">{ind.name}</span>
            <span class="text-base text-muted-foreground">{ind.intro}</span>
            <span class="mt-auto pt-2 text-sm font-semibold text-primary">Learn more →</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="flex flex-col gap-4">
      <h3 class="text-xl font-bold text-foreground">And many more, including</h3>
      <ul class="flex list-none flex-wrap gap-2">
        {moreIndustries.map((name) => <li class="bg-secondary px-3 py-1.5 text-sm text-secondary-foreground">{name}</li>)}
      </ul>
    </div>
  </Section>

  <Section title="What we don't fund" tone="muted">
    <ul class="grid list-none grid-cols-1 gap-4 sm:grid-cols-2">
      {notFunded.map((item) => (
        <li class="flex items-center gap-3 text-base text-foreground"><X class="size-5 shrink-0 text-destructive" aria-hidden="true" />{item}</li>
      ))}
    </ul>
  </Section>

  <CtaBand />
</PageShell>
