---
import AdminLayout from "@/layouts/AdminLayout.astro";
import StatusBadge from "@/components/StatusBadge.astro";
import { getDraft, getDraftDb, parseIds, parseObject } from "@/lib/server/drafts";
import { getDocumentBucket, headDocument, type StoredDocument } from "@/lib/server/documents";
import DocumentActions from "@/components/DocumentActions.astro";
import { Dialog, DialogClose, DialogContent, DialogTitle, DialogTrigger } from "@/ui/dialog";
import { X } from "@lucide/astro";
import { Font } from "astro:assets";
import ApplicationDecision from "@/components/admin/ApplicationDecision.astro";
import SignatureRecord from "@/components/admin/SignatureRecord.astro";
import { DRAFT_FIELDS, DRAFT_FIELD_LABELS, UUID_V4, type DraftField } from "@/lib/draft-config";
import { formatName, formatPlace, formatTime } from "@/lib/server/admin-format";
import { DECISION_NOTICES, handleDecisionPost, type DecisionNotice } from "@/lib/server/decision-actions";
import { getDecision, getLatestRequest, listEvents, listRequestIds } from "@/lib/server/signing";

// One /apply session: its stored statements, what was typed (and when each field was first
// filled), the admin's decision and, after an approval, the signing link and the signed record,
// then the signals it arrived with. Sign-in is enforced by src/middleware.ts.
export const prerender = false;

const id = Astro.params.id ?? "";
const db = UUID_V4.test(id) ? await getDraftDb() : undefined;
const row = db ? await getDraft(db, id) : null;
if (!db || !row) return new Response("Not found", { status: 404 });

if (Astro.request.method === "POST") {
  // Same guard as the settings form on /admin: the session cookie is SameSite=Lax, and the origin
  // check makes refusing a cross-site post explicit.
  if (Astro.request.headers.get("Origin") !== Astro.url.origin) return new Response("Forbidden", { status: 403 });
  const notice = await handleDecisionPost(db, row, await Astro.request.formData(), {
    actor: Astro.locals.adminSession!.user.email,
    origin: Astro.url.origin,
  });
  // Post/redirect/get, so a reload doesn't approve (and email) twice.
  return Astro.redirect(`/admin/drop-offs/${id}?notice=${notice}#decision`, 303);
}
const noticeParam = Astro.url.searchParams.get("notice");
const notice = noticeParam && noticeParam in DECISION_NOTICES ? (noticeParam as DecisionNotice) : null;

const [decision, latestRequest, requestIds] = await Promise.all([getDecision(db, id), getLatestRequest(db, id), listRequestIds(db, id)]);
const events = await listEvents(db, requestIds);
const latestViews = latestRequest ? events.filter((e) => e.request_id === latestRequest.id && e.type === "viewed").length : 0;
const signedRequest = latestRequest?.status === "signed" ? latestRequest : null;

const fields = parseObject(row.fields_json);
const progress = parseObject(row.field_progress_json);
const autofilled = new Set(parseIds(row.autofilled_json));
const jobIds = parseIds(row.job_ids_json);

// Stored statements; one that is no longer in the bucket shows as missing.
const bucket = await getDocumentBucket();
const documents: { id: string; doc: StoredDocument | null }[] = await Promise.all(
  parseIds(row.document_ids_json).map(async (docId) => ({ id: docId, doc: bucket ? await headDocument(bucket, docId).catch(() => null) : null })),
);

const value = (name: DraftField) => (typeof fields[name] === "string" ? (fields[name] as string) : "");
const firstFilled = (name: DraftField) => (typeof progress[name] === "number" ? (progress[name] as number) : null);
// The order fields were first filled in, for reading how far the visitor got and in what order.
const timeline = DRAFT_FIELDS.filter((n) => firstFilled(n) != null).sort((a, b) => firstFilled(a)! - firstFilled(b)!);

const title = value("legalBusinessName") || formatName(value("firstName"), value("lastName")) || "Unnamed";
const utm = [row.utm_source, row.utm_medium, row.utm_campaign].filter(Boolean).join(" · ");
const signals: [string, string][] = [
  ["Created", formatTime(row.created_at)],
  ["Updated", formatTime(row.last_active_at)],
  ...(row.converted_at ? [["Submitted", formatTime(row.converted_at)] as [string, string]] : []),
  ["Location", formatPlace(row.city, [row.region, row.country].filter(Boolean).join(", ") || null)],
  ["Network", [row.as_org, row.asn != null ? `AS${row.asn}` : null].filter(Boolean).join(" · ") || "—"],
  ["Browser", row.ua ?? "—"],
  ["Referrer", row.referrer ?? "—"],
  ["UTM", utm || "—"],
  ["Saves", String(row.save_count)],
];
const sizeLabel = (bytes: number) => `${(bytes / 1024 / 1024).toFixed(1)} MB`;
---

<AdminLayout title={title} current="applications">
  {signedRequest && <Font cssVariable="--font-signature" slot="head" />}
  <div class="flex flex-col gap-2">
    <a href="/admin/drop-offs" class="text-sm text-primary hover:underline">← Applications</a>
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-xl font-semibold">{title}</h1>
      <StatusBadge status={row.status} signed={!!signedRequest} />
    </div>
  </div>

  <section class="flex flex-col gap-3">
    <h2 class="text-base font-semibold">Statements</h2>
    {documents.length === 0 ? (
      <p class="text-sm text-muted-foreground">{jobIds.length ? `${jobIds.length} uploaded, not stored.` : "None."}</p>
    ) : (
      <ul class="flex flex-col gap-3 text-sm">
        {documents.map(({ id: docId, doc }) => (
          <li class="flex items-center gap-3 rounded-lg border border-border px-3 py-2">
            {doc ? (
              <>
                <Dialog class="min-w-0" data-document-dialog>
                  <DialogTrigger class="max-w-full truncate font-medium text-primary hover:underline">{doc.filename}</DialogTrigger>
                  {/* A full-screen dark backdrop with the pages floating on it, like Gmail's attachment preview. */}
                  <DialogContent
                    showCloseButton={false}
                    class="top-0 left-0 flex h-dvh w-screen max-w-none translate-x-0 translate-y-0 flex-col gap-0 rounded-none bg-black/55 p-0 text-white ring-0 sm:max-w-none"
                  >
                    <div class="flex h-14 shrink-0 items-center gap-3 bg-black/40 px-4">
                      <DialogTitle class="min-w-0 truncate">{doc.filename}</DialogTitle>
                      <div class="ml-auto flex items-center gap-1">
                        <DocumentActions id={docId} filename={doc.filename} buttonClass="text-white hover:bg-white/15" />
                        <DialogClose class="static size-8.5 justify-center rounded-lg hover:bg-white/15 [&_svg]:size-4" title="Close">
                          <X />
                        </DialogClose>
                      </div>
                    </div>
                    {/* Filled on first open by src/lib/admin-document-viewer.ts; a click on the backdrop around the pages closes. */}
                    <div data-document-backdrop class="min-h-0 flex-1 overflow-y-auto px-4 py-6">
                      <div
                        data-document-pages
                        data-src={`/api/admin/documents/${docId}`}
                        data-kind={doc.mime === "application/pdf" ? "pdf" : doc.mime.startsWith("image/") ? "image" : "other"}
                        data-filename={doc.filename}
                        class="mx-auto flex max-w-4xl flex-col items-center gap-4"
                      ></div>
                    </div>
                  </DialogContent>
                </Dialog>
                <span class="shrink-0 text-muted-foreground">{sizeLabel(doc.size)}</span>
                <span class="ml-auto"><DocumentActions id={docId} filename={doc.filename} /></span>
              </>
            ) : (
              <span class="text-muted-foreground">{docId.slice(0, 8)} (expired)</span>
            )}
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="flex flex-col gap-3">
    <h2 class="text-base font-semibold">Form <span class="font-normal text-muted-foreground">{row.fields_completed}/{row.fields_total}</span></h2>
    <div class="rounded-md border border-border">
      <table class="w-full text-left text-sm">
        <tbody>
          {DRAFT_FIELDS.map((name) => (
            <tr class="border-b border-border last:border-0">
              <th class="w-1/3 px-3 py-2 align-top font-normal text-muted-foreground">{DRAFT_FIELD_LABELS[name]}</th>
              <td class="break-words px-3 py-2 align-top">
                {value(name) || <span class="text-muted-foreground">—</span>}
                {autofilled.has(name) && <span class="ml-2 text-xs text-muted-foreground">(statement)</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {timeline.length > 1 && (
      <p class="text-xs text-muted-foreground">Fill order: {timeline.map((n) => DRAFT_FIELD_LABELS[n]).join(" → ")}</p>
    )}
  </section>

  <div id="decision" class="scroll-mt-6">
    <ApplicationDecision decision={decision} request={latestRequest} views={latestViews} email={value("email")} notice={notice} />
  </div>

  {signedRequest && <SignatureRecord request={signedRequest} events={events} />}

  <section class="flex flex-col gap-3">
    <h2 class="text-base font-semibold">Session</h2>
    <dl class="grid grid-cols-1 gap-x-6 gap-y-1.5 text-sm sm:grid-cols-[8rem_1fr]">
      {signals.map(([k, v]) => (
        <>
          <dt class="text-muted-foreground">{k}</dt>
          <dd class="break-words">{v}</dd>
        </>
      ))}
      <dt class="text-muted-foreground">IP</dt>
      <dd class="font-mono text-xs">
        {row.ip ? <a href={`/admin/drop-offs?ip=${encodeURIComponent(row.ip)}`} class="text-primary hover:underline">{row.ip}</a> : "—"}
      </dd>
      <dt class="text-muted-foreground">ID</dt>
      <dd class="font-mono text-xs text-muted-foreground">{row.id}</dd>
    </dl>
  </section>
</AdminLayout>

<script>
  import { setupDocumentViewer } from "@/lib/admin-document-viewer";

  document.querySelectorAll<HTMLElement>("[data-document-dialog]").forEach(setupDocumentViewer);
</script>
