---
import Layout from "@/layouts/Layout.astro";
import AdminHeader from "@/components/AdminHeader.astro";
import StatusBadge from "@/components/StatusBadge.astro";
import { getDraft, getDraftDb, parseIds, parseObject } from "@/lib/server/drafts";
import { getDocumentBucket, headDocument, type StoredDocument } from "@/lib/server/documents";
import { DRAFT_FIELDS, DRAFT_FIELD_LABELS, UUID_V4, type DraftField } from "@/lib/draft-config";
import { formatName, formatPlace, formatTime } from "@/lib/server/admin-format";

// One /apply session: what was typed (and when each field was first filled), the signals it
// arrived with, and its stored statements. Sign-in is enforced by src/middleware.ts.
export const prerender = false;

const id = Astro.params.id ?? "";
const db = UUID_V4.test(id) ? await getDraftDb() : undefined;
const row = db ? await getDraft(db, id) : null;
if (!row) return new Response("Not found", { status: 404 });

const fields = parseObject(row.fields_json);
const progress = parseObject(row.field_progress_json);
const autofilled = new Set(parseIds(row.autofilled_json));
const jobIds = parseIds(row.job_ids_json);

// Stored statements; one that has aged out of the bucket (lifecycle rule) shows as missing.
const bucket = await getDocumentBucket();
const documents: { id: string; doc: StoredDocument | null }[] = await Promise.all(
  parseIds(row.document_ids_json).map(async (docId) => ({ id: docId, doc: bucket ? await headDocument(bucket, docId).catch(() => null) : null })),
);

const value = (name: DraftField) => (typeof fields[name] === "string" ? (fields[name] as string) : "");
const firstFilled = (name: DraftField) => (typeof progress[name] === "number" ? (progress[name] as number) : null);
// The order fields were first filled in, for reading how far the visitor got and in what order.
const timeline = DRAFT_FIELDS.filter((n) => firstFilled(n) != null).sort((a, b) => firstFilled(a)! - firstFilled(b)!);

const title = value("legalBusinessName") || formatName(value("firstName"), value("lastName")) || "Unnamed session";
const utm = [row.utm_source && `source ${row.utm_source}`, row.utm_medium && `medium ${row.utm_medium}`, row.utm_campaign && `campaign ${row.utm_campaign}`].filter(Boolean).join(" · ");
const signals: [string, string][] = [
  ["Location", formatPlace(row.city, [row.region, row.country].filter(Boolean).join(", ") || null)],
  ["Network", [row.as_org, row.asn != null ? `AS${row.asn}` : null].filter(Boolean).join(" · ") || "—"],
  ["Browser", row.ua ?? "—"],
  ["Referrer", row.referrer ?? "—"],
  ["Campaign", utm || "—"],
  ["Saves", String(row.save_count)],
];
const sizeLabel = (bytes: number) => `${(bytes / 1024 / 1024).toFixed(1)} MB`;
---

<Layout title="Drop-off" noindex>
  <main class="w-full min-h-screen px-4 py-16">
    <div class="mx-auto flex max-w-4xl flex-col gap-10">
      <AdminHeader current="drop-offs" />

      <div class="flex flex-col gap-2">
        <a href="/admin/drop-offs" class="text-sm text-primary hover:underline">← All sessions</a>
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="text-2xl font-bold">{title}</h1>
          <StatusBadge status={row.status} />
        </div>
        <p class="text-sm text-muted-foreground">
          Opened {formatTime(row.created_at)} · last active {formatTime(row.last_active_at)}
          {row.converted_at && <> · submitted {formatTime(row.converted_at)}</>}
          · {row.fields_completed}/{row.fields_total} fields
        </p>
      </div>

      <section class="flex flex-col gap-3">
        <h2 class="text-lg font-semibold">Form</h2>
        <table class="w-full text-left text-sm">
          <tbody>
            {DRAFT_FIELDS.map((name) => (
              <tr class="border-b border-border last:border-0">
                <th class="w-1/3 py-2 pr-4 align-top font-medium">{DRAFT_FIELD_LABELS[name]}</th>
                <td class="py-2 pr-4 align-top break-words">
                  {value(name) || <span class="text-muted-foreground">—</span>}
                  {autofilled.has(name) && <span class="ml-2 rounded bg-primary/10 px-1.5 py-0.5 text-xs text-primary">from statement</span>}
                </td>
                <td class="whitespace-nowrap py-2 align-top text-xs text-muted-foreground">{firstFilled(name) != null && `first filled ${formatTime(firstFilled(name))}`}</td>
              </tr>
            ))}
          </tbody>
        </table>
        {timeline.length > 1 && (
          <p class="text-xs text-muted-foreground">Fill order: {timeline.map((n) => DRAFT_FIELD_LABELS[n]).join(" → ")}</p>
        )}
      </section>

      <section class="flex flex-col gap-3">
        <h2 class="text-lg font-semibold">Statements</h2>
        {documents.length === 0 ? (
          <p class="text-sm text-muted-foreground">
            {jobIds.length ? `${jobIds.length} uploaded, but no stored copy (storage was off or failed).` : "None uploaded."}
          </p>
        ) : (
          <ul class="flex flex-col gap-2 text-sm">
            {documents.map(({ id: docId, doc }) => (
              <li>
                {doc ? (
                  <a href={`/api/admin/documents/${docId}`} class="text-primary hover:underline">{doc.filename}</a>
                ) : (
                  <span class="text-muted-foreground">Statement {docId.slice(0, 8)} (no longer stored)</span>
                )}
                {doc && <span class="text-xs text-muted-foreground"> · {sizeLabel(doc.size)}</span>}
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="flex flex-col gap-3">
        <h2 class="text-lg font-semibold">Session</h2>
        <dl class="grid grid-cols-1 gap-x-6 gap-y-2 text-sm sm:grid-cols-[10rem_1fr]">
          <dt class="font-medium">IP</dt>
          <dd class="font-mono text-xs">
            {row.ip ? <a href={`/admin/drop-offs?ip=${encodeURIComponent(row.ip)}`} class="text-primary hover:underline" title="Every session from this IP">{row.ip}</a> : "—"}
          </dd>
          {signals.map(([k, v]) => (
            <>
              <dt class="font-medium">{k}</dt>
              <dd class="break-words text-muted-foreground">{v}</dd>
            </>
          ))}
          <dt class="font-medium">Session id</dt>
          <dd class="font-mono text-xs text-muted-foreground">{row.id}</dd>
        </dl>
      </section>
    </div>
  </main>
</Layout>
