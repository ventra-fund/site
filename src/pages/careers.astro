---
import PageShell from "@/components/page/PageShell.astro";
import PageHero from "@/components/page/PageHero.astro";
import Section from "@/components/page/Section.astro";
import NumberedGrid from "@/components/page/NumberedGrid.astro";
import CheckList from "@/components/page/CheckList.astro";
import ContactReveal from "@/components/ContactReveal.astro";
import { photos } from "@/data/photos";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import { Button } from "@/ui/button";
import { Accordion, AccordionItem, AccordionTrigger, AccordionContent } from "@/ui/accordion";
import { careerBenefits, values } from "@/data/company";
import { openings } from "@/data/careers";
---

<PageShell title="Careers">
  <PageHero eyebrow="Careers" title="Help small businesses grow" cta={{ href: "#openings", label: "View open positions" }} image={photos.teamWhiteboard}>
    <p>We're building a team of smart, owner-focused people who want their work to matter to real businesses and real communities.</p>
  </PageHero>

  <Section title="Why work at Ventra Fund" tone="muted">
    <CheckList items={careerBenefits} columns={2} />
  </Section>

  <Section title="What we value">
    <NumberedGrid items={values} columns={4} />
  </Section>

  <Section id="openings" title="Open positions" tone="muted">
    {/* Same accordion as the FAQs (FaqList.astro): closed rows stay findable with find-in-page. */}
    {openings.length > 0 ? (
      <Accordion multiple data-hidden-until-found class="border-t border-border">
        {openings.map((job, i) => (
          <AccordionItem value={`job-${i}`} class="border-border">
            <AccordionTrigger class="items-center gap-6 py-5 text-lg font-semibold text-foreground hover:no-underline **:data-[slot=accordion-trigger-icon]:size-5 **:data-[slot=accordion-trigger-icon]:text-foreground">
              <span class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <span>{job.title}</span>
                <span class="text-sm font-normal text-muted-foreground">{job.team} · {job.highlight}</span>
              </span>
              <ChevronDown slot="icon" class="size-5 transition-transform group-aria-expanded/accordion-trigger:rotate-180" aria-hidden="true" />
            </AccordionTrigger>
            <AccordionContent class="flex max-w-3xl flex-col gap-3 pb-6 text-base text-muted-foreground [&_p:not(:last-child)]:mb-0">
              <p>{job.intro}</p>
              {job.sections.map((section) => (
                <>
                  <h3 class="mt-3 font-semibold text-foreground">{section.title}</h3>
                  {section.text.map((p) => <p>{p}</p>)}
                </>
              ))}
              <h3 class="mt-3 font-semibold text-foreground">How to apply</h3>
              <p>Email us and mention the {job.title} role. {job.apply}</p>
              {/* The address is never in the page: it sits behind the anti-scrape reveal (docs/contact-reveal.md). */}
              <p class="text-foreground"><ContactReveal contact="careers" /></p>
            </AccordionContent>
          </AccordionItem>
        ))}
      </Accordion>
    ) : (
      <div class="flex flex-col gap-4">
        <p class="text-lg text-muted-foreground">We don't have any openings right now, but we're always glad to hear from great people.</p>
        <Button as="a" href="/contact" variant="outline" size="lg" class="self-start">Get in touch</Button>
      </div>
    )}
  </Section>
</PageShell>
