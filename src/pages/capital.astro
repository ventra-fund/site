---
import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/Footer.astro";
import { Button } from "@/ui/button";
import { fundingProducts } from "@/data/funding-products";
import { Gauge, CircleDollarSign, Calendar } from "@lucide/astro";

const tableRows = [
  { label: "Amount", key: "amount" },
  { label: "Time to Fund", key: "timeToFund" },
  { label: "Term Length", key: "termLength" },
  { label: "Repayment", key: "repayment" },
  { label: "Rate / Cost", key: "rateCost" },
] as const;
---

<Layout>
  <main class="mx-auto w-[calc(100%-2rem)] max-w-6xl px-0 pt-30 pb-20 md:w-[calc(100%-8rem)]">
    <div class="flex flex-col gap-3">
      <h1 class="text-3xl font-bold text-accent sm:text-5xl">Business financing options</h1>
      <p class="max-w-2xl text-lg text-muted-foreground">Every path to capital we offer, side by side, so you can find the fit for your business.</p>
    </div>

    <div class="hidden sm:block mt-16 overflow-x-auto">
      <table class="w-full border-collapse text-sm">
        <thead>
          <tr>
            <th class="text-left pr-3 py-2 md:py-3 lg:py-6 whitespace-nowrap"></th>
            {fundingProducts.map((p) => (
              <th class="text-left pr-3 py-2 md:py-3 lg:py-6 border-b border-border">
                <span class="block text-sm text-muted-foreground">{p.category}</span>
                <span class="text-base text-foreground">{p.title}</span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {tableRows.map(({ label, key }) => (
            <tr class="border-t border-border">
              <td class="pr-3 py-2 md:py-3 lg:py-6 text-xs font-semibold uppercase tracking-widest text-muted-foreground whitespace-nowrap">{label}</td>
              {fundingProducts.map((p) => (
                <td class="pr-3 py-2 md:py-3 lg:py-6 text-foreground">{p[key]}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-10 sm:mt-20 flex flex-col gap-4">
      {fundingProducts.map((product, i) => {
        const num = String(i + 1).padStart(2, "0");
        return (
          <>
            {/* Mobile */}
            <div class="sm:hidden rounded-xl border border-border bg-card p-6 flex flex-col gap-4">
              <div class="grid grid-cols-[auto_1fr] gap-4">
                <span class="text-sm font-semibold text-primary bg-secondary rounded-lg self-stretch aspect-square flex items-center justify-center">{num}</span>
                <div class="flex flex-col gap-2">
                  <span class="text-sm text-muted-foreground">{product.category}</span>
                  <h2 class="text-[clamp(1rem,4.5vw,1.25rem)] font-bold text-foreground">{product.title}</h2>
                </div>
              </div>
              <p class="text-md text-muted-foreground">{product.description}</p>
              <hr class="border-border" />
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <span class="block text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-1">{product.amountLabel}</span>
                  <span class="text-sm font-semibold text-foreground">{product.amount}</span>
                </div>
                <div>
                  <span class="block text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-1">Time to Fund</span>
                  <span class="text-sm font-semibold text-foreground">{product.timeToFund}</span>
                </div>
                <div>
                  <span class="block text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-1">Term Length</span>
                  <span class="text-sm font-semibold text-foreground">{product.termLength}</span>
                </div>
                <div>
                  <span class="block text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-1">Repayment</span>
                  <span class="text-sm font-semibold text-foreground">{product.repayment}</span>
                </div>
              </div>
              <hr class="border-border" />
              <div class="flex items-center justify-between gap-3 bg-secondary p-3">
                <span class="text-sm text-foreground"><span class="font-bold">Best for:</span> {product.bestFor}</span>
              </div>
            </div>

            {/* Desktop */}
            <div class="hidden sm:flex rounded-xl border border-border bg-card p-6 flex-row items-start gap-6">
              <div class="flex items-start gap-4 flex-1">
                <span class="text-sm font-semibold text-primary bg-secondary rounded-lg px-3 py-2 shrink-0">{num}</span>
                <div class="flex flex-col gap-2">
                  <span class="text-sm text-muted-foreground">{product.category}</span>
                  <h2 class="text-xl font-bold text-foreground">{product.title}</h2>
                  <p class="text-md text-muted-foreground">{product.description}</p>
                </div>
              </div>
              <div class="w-px self-stretch bg-border shrink-0"></div>
              <div class="flex flex-col gap-4 shrink-0 w-50">
                <div>
                  <span class="block text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-1">Best For</span>
                  <span class="text-sm font-semibold text-foreground">{product.bestFor}</span>
                </div>
                <div>
                  <span class="block text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-1">{product.amountLabel}</span>
                  <span class="text-sm font-semibold text-foreground">{product.amount}</span>
                </div>
              </div>
            </div>
          </>
        );
      })}
    </div>

    <section class="mt-20 bg-secondary w-full py-16 px-6 md:px-10 rounded-xl">
      <h2 class="mb-12 text-3xl sm:text-4xl font-bold text-accent text-center">Minimum requirements</h2>
      <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="flex items-center gap-4">
          <div class="shrink-0 bg-accent/10 rounded-full p-4 w-16 h-16 flex items-center justify-center">
            <Gauge class="size-7 text-accent" stroke-width={1.5} />
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">Credit Score</p>
            <p class="text-2xl font-bold text-foreground">450</p>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <div class="shrink-0 bg-accent/10 rounded-full p-4 w-16 h-16 flex items-center justify-center">
            <CircleDollarSign class="size-7 text-accent" stroke-width={1.5} />
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">Monthly Revenue</p>
            <p class="text-2xl font-bold text-foreground">$5k+</p>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <div class="shrink-0 bg-accent/10 rounded-full p-4 w-16 h-16 flex items-center justify-center">
            <Calendar class="size-7 text-accent" stroke-width={1.5} />
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">Time in Business</p>
            <p class="text-2xl font-bold text-foreground">6+ months</p>
          </div>
        </div>
      </div>
    </section>

    <div class="mt-16 flex justify-center">
      <Button as="a" href="/apply" size="lg">Apply now</Button>
    </div>
  </main>

  <Footer />
</Layout>
