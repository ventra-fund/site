---
// One page per product an ISO can submit: what it is, three headline facts, how the ISO gets paid on
// it, why it places well, a comparison to share with the merchant (where it has one), when to submit it, FAQs.
import PageShell from "@/components/page/PageShell.astro";
import PageHero from "@/components/page/PageHero.astro";
import Section from "@/components/page/Section.astro";
import FeatureTiles from "@/components/page/FeatureTiles.astro";
import CheckList from "@/components/page/CheckList.astro";
import CompareTable from "@/components/page/CompareTable.astro";
import FaqList from "@/components/page/FaqList.astro";
import CtaBand from "@/components/page/CtaBand.astro";
import PillLink from "@/components/page/PillLink.astro";
import { productPages, type ProductPage } from "@/data/product-pages";
import { faqGroup } from "@/data/faqs";
import { dayList, isoProgram, shortDays } from "@/data/iso-program";
import { BadgePercent, CalendarCheck, CalendarSync, ChartNoAxesCombined, ShieldCheck, Timer } from "@lucide/astro";

export function getStaticPaths() {
  return productPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

interface Props {
  page: ProductPage;
}

const { page } = Astro.props;
const { product } = page;
const faqs = faqGroup(page.slug)?.items ?? [];
const others = productPages.filter((p) => p.slug !== page.slug);
---

<PageShell title={product.title}>
  <PageHero eyebrow={product.category} title={page.heading} cta={{ href: "/partner", label: "Onboard now" }} secondary={{ href: "/capital", label: "Compare products" }} image={page.image}>
    <p>{product.description}</p>
  </PageHero>

  <Section wide title={`How ${page.noun} works`}>
    <p class="max-w-3xl text-lg text-muted-foreground">{page.howItWorks}</p>
    <FeatureTiles
      items={[
        { icon: CalendarSync, title: "Repayment", text: product.repayment },
        { icon: ChartNoAxesCombined, title: "Amount", text: product.amount },
        { icon: Timer, title: "Time to fund", text: product.timeToFund },
      ]}
    />
  </Section>

  <Section title="How you get paid" tone="muted">
    <FeatureTiles
      items={[
        { icon: BadgePercent, title: `Up to ${isoProgram.maxPoints} points`, text: "Built into the merchant's total cost, which they see in dollars before signing." },
        { icon: CalendarCheck, title: `Paid ${shortDays(isoProgram.commissionDays)}`, text: `Commission runs every ${dayList(isoProgram.commissionDays)}.` },
        { icon: ShieldCheck, title: "Your merchant stays yours", text: "Funded or declined, we never contact your merchant on our own. The only call they get is the verification call, made in your name." },
      ]}
    />
  </Section>

  <Section title="Why it's easy to place">
    <CheckList items={page.advantages} columns={2} />
  </Section>

  {page.comparison && (
    <Section title={page.comparison.title} intro="What to tell your merchant when they're weighing up their options." tone="muted">
      <CompareTable them={page.comparison.them} rows={page.comparison.rows} />
    </Section>
  )}

  <Section title="When to submit it">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-3">
      <div class="flex flex-col gap-4">
        <h3 class="text-xl font-bold text-foreground">A good fit if</h3>
        <CheckList items={page.goodFitIf} />
      </div>
      <div class="flex flex-col gap-4">
        <h3 class="text-xl font-bold text-foreground">Common uses</h3>
        <CheckList items={page.uses} />
      </div>
      <div class="flex flex-col gap-4">
        <h3 class="text-xl font-bold text-foreground">Minimum requirements</h3>
        <CheckList
          items={[
            `${product.requirements.timeInBusiness} in business`,
            `${product.requirements.monthlyRevenue} average monthly revenue`,
            `Credit score of ${product.requirements.creditScore}+`,
            "A business checking account",
          ]}
        />
        <p class="text-sm text-muted-foreground italic">Additional underwriting criteria apply.</p>
        <PillLink href="/who-we-fund" variant="outline" class="self-start">Deal guidelines</PillLink>
      </div>
    </div>
    <p class="max-w-3xl border-l-4 border-primary pl-5 text-lg text-muted-foreground">{page.example}</p>
  </Section>

  <Section title="FAQs" tone="muted">
    <div class="max-w-3xl">
      <FaqList items={faqs} />
    </div>
  </Section>

  <Section title={others.length === 1 ? "Another product you can submit" : "Other products you can submit"}>
    <ul class="grid list-none grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {others.map((o) => (
        <li>
          <a href={`/capital/${o.slug}`} class="flex h-full flex-col gap-2 border border-border bg-card p-6 transition-colors hover:border-foreground">
            <span class="text-sm text-muted-foreground">{o.product.category}</span>
            <span class="text-lg font-bold text-foreground">{o.product.title}</span>
            <span class="text-sm text-muted-foreground">{o.product.amount}</span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <CtaBand />
</PageShell>
