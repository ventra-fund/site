---
import PageShell from "@/components/page/PageShell.astro";
import PageHero from "@/components/page/PageHero.astro";
import Section from "@/components/page/Section.astro";
import FeatureTiles from "@/components/page/FeatureTiles.astro";
import CtaBand from "@/components/page/CtaBand.astro";
import { dayList, isoProgram, shortDays } from "@/data/iso-program";
import { BadgePercent, CalendarCheck, RefreshCw } from "@lucide/astro";
---

<PageShell title="Commission">
  <PageHero eyebrow="For ISOs" title="Points, commission and when you get paid" cta={{ href: "/partner", label: "Onboard now" }}>
    <p>You set your points on every deal, commission runs twice a week, and renewals pay you again. Your merchant sees the full cost in dollars before they sign.</p>
  </PageHero>

  <Section>
    <FeatureTiles
      items={[
        { icon: BadgePercent, title: `Up to ${isoProgram.maxPoints} points`, text: "Each point earns you 1% of the funded amount. Your commission is built into the deal, not taken out of it." },
        { icon: CalendarCheck, title: `Paid ${shortDays(isoProgram.commissionDays)}`, text: `Commission runs every ${dayList(isoProgram.commissionDays)} on funded deals.` },
        { icon: RefreshCw, title: "Paid again on renewals", text: `Merchants can renew at ${isoProgram.renewAtPercent}% paid in, and you earn the same commission as the first funding.` },
      ]}
    />
  </Section>

  <Section title="Honest numbers for your merchant" tone="muted">
    <div class="flex max-w-3xl flex-col gap-4 text-lg text-muted-foreground">
      <p>Every contract states the total repayment amount in dollars, how often the merchant pays and what each payment is, with an estimated APR alongside. Nothing changes at signing, so the quote you give holds up.</p>
      <p>No volume minimum to stay on the program, and a bonus once you reach {isoProgram.bonusAt} funded.</p>
    </div>
  </Section>

  <CtaBand />
</PageShell>
