---
import PageShell from "@/components/page/PageShell.astro";
import PageHero from "@/components/page/PageHero.astro";
import Section from "@/components/page/Section.astro";
import FeatureTiles from "@/components/page/FeatureTiles.astro";
import Photo from "@/components/page/Photo.astro";
import DealFlow from "@/components/DealFlow.astro";
import { photos } from "@/data/photos";
import CtaBand from "@/components/page/CtaBand.astro";
import PillLink from "@/components/page/PillLink.astro";
import { dayList, isoProgram, shortDays, underwriterAvailability } from "@/data/iso-program";
import { CalendarCheck, MessageSquareText, RefreshCw, Timer } from "@lucide/astro";
---

<PageShell title="Why Ventra Fund">
  <PageHero eyebrow="For ISOs" title="Why ISOs send us their deals" cta={{ href: "/partner", label: "Onboard now" }} secondary={{ href: "/why-us/how-it-works", label: "How submissions work" }}>
    <p>We're a funder that works only through brokers. That changes how we treat your file, your merchant and your commission.</p>
  </PageHero>

  <Section>
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div class="flex flex-col gap-5">
        <h2 class="text-3xl font-bold tracking-[-0.02em] sm:text-4xl">We don't compete with you</h2>
        <p class="text-lg text-muted-foreground">We have no sales floor and no direct-to-merchant channel. Every merchant you submit stays yours, funded or declined: we never market to them or contact them on our own, and the verification call is made in your name. We don't shop your file to other funders.</p>
        <PillLink href="/who-we-fund" variant="outline" class="self-start">Deal guidelines</PillLink>
      </div>
      <Photo photo={photos.brokerCall} class="aspect-square" />
    </div>
  </Section>

  <Section title="Built around how brokers work" tone="muted">
    <FeatureTiles
      columns={4}
      items={[
        { icon: MessageSquareText, title: "Every decline explained", text: "The reason comes with the decision. If we got something wrong, push back and we'll take another look." },
        { icon: Timer, title: "Decisions in a day", text: "Automated pre-approval checks on industry and position stack, then a person underwrites the file." },
        { icon: CalendarCheck, title: `Commission ${shortDays(isoProgram.commissionDays)}`, text: `Commission runs every ${dayList(isoProgram.commissionDays)}, with up to ${isoProgram.maxPoints} points on every deal.` },
        { icon: RefreshCw, title: "Renewals credited to you", text: `Merchants can renew at ${isoProgram.renewAtPercent}% paid in, at the same commission as the first funding.` },
      ]}
    />
  </Section>

  <Section title="Know where every deal stands" intro={`You hear from us at each step. And when you'd rather talk, an underwriter is on the phone ${underwriterAvailability}.`}>
    <DealFlow />
  </Section>

  <Section title="Learn more" tone="muted">
    <ul class="grid list-none grid-cols-1 gap-4 md:grid-cols-3">
      {[
        { href: "/why-us/how-it-works", title: "How submissions work", text: "From onboarding to your first commission run." },
        { href: "/why-us/transparent-pricing", title: "Commission", text: "Points, renewals and when you get paid." },
        { href: "/why-us/faq", title: "FAQ", text: "Answers to the questions brokers ask most." },
      ].map((card) => (
        <li>
          <a href={card.href} class="flex h-full flex-col gap-2 border border-border bg-card p-6 transition-colors hover:border-foreground">
            <span class="text-xl font-bold text-foreground">{card.title}</span>
            <span class="text-base text-muted-foreground">{card.text}</span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <CtaBand />
</PageShell>
