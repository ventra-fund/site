---
import PageShell from "@/components/page/PageShell.astro";
import PageHero from "@/components/page/PageHero.astro";
import Section from "@/components/page/Section.astro";
import ReviewGrid from "@/components/page/ReviewGrid.astro";
import CtaBand from "@/components/page/CtaBand.astro";
---

<PageShell title="Customer reviews">
  <PageHero eyebrow="About us" title="What owners say about Ventra Fund" cta={{ href: "/apply", label: "Apply for Funding", rounded: true }}>
    <p>Real feedback from the business owners we've funded: what went well, and what we're still working on.</p>
  </PageHero>

  <Section>
    <ReviewGrid />
  </Section>

  <CtaBand title="Join them" />
</PageShell>
