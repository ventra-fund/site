---
import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/Footer.astro";
import QuillEditor from "@/components/QuillEditor.astro";
import Turnstile from "@/components/Turnstile.astro";
import { Button } from "@/ui/button";
import { Input } from "@/ui/input";

// Mirrors the server's z.email(): the browser's own type="email" check would pass "me@localhost".
const EMAIL_PATTERN = "[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}";
---
<Layout title="Contact us">
    <main class="w-full min-h-screen px-4 pt-30 pb-20">
        <div class="mx-auto flex max-w-2xl flex-col gap-8">
            <div class="flex flex-col gap-3">
                <h1 class="text-3xl font-bold text-accent sm:text-5xl">Contact us</h1>
                <p class="text-lg text-muted-foreground">Questions about financing with Ventra Fund? Send us a message and we'll get back to you. Otherwise, call us at (###) ###-####</p>
            </div>

            <form data-contact-form novalidate class="flex flex-col gap-5">
                <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                    <label class="flex flex-col gap-1.5 text-sm font-medium">
                        Name
                        <Input name="name" type="text" required maxlength="200" autocomplete="name" />
                    </label>
                    <label class="flex flex-col gap-1.5 text-sm font-medium">
                        Email
                        <Input name="email" type="email" required maxlength="254" pattern={EMAIL_PATTERN} autocomplete="email" />
                    </label>
                </div>

                <div class="flex flex-col gap-1.5">
                    <span id="ct-message-label" class="text-sm font-medium">Message</span>
                    <QuillEditor placeholder="How can we help?" labelledby="ct-message-label" toolbar="open" />
                </div>

                <Turnstile />

                <p data-contact-error hidden role="alert" class="text-sm text-destructive"></p>
                <p data-contact-success hidden role="status" class="text-sm font-medium text-accent">Thanks, your message was sent. We'll be in touch.</p>

                <Button type="submit" size="lg" class="self-start" data-contact-submit data-label="Send message" disabled>Checking security…</Button>
            </form>
        </div>
    </main>
    <Footer />
</Layout>

<script>
    import { gateOnFirstInteraction } from '@/lib/turnstile';
    import { setupValidation, showMessage, submitJson, validateForm } from '@/lib/form';

    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (form) {
        const editorEl = form.querySelector('[data-quill-editor]') as (HTMLElement & { quill?: any }) | null;
        const widget = form.querySelector('turnstile-widget');
        const submitBtn = form.querySelector<HTMLButtonElement>('[data-contact-submit]')!;
        const errorEl = form.querySelector<HTMLElement>('[data-contact-error]')!;
        const successEl = form.querySelector<HTMLElement>('[data-contact-success]')!;
        const showError = (msg: string) => showMessage(errorEl, msg);

        // Turnstile is only fetched once the user touches the form; from then on submit stays disabled
        // until it verifies (invisible first, visible fallback after 5s).
        if (widget) gateOnFirstInteraction({ form, widget, button: submitBtn, onError: showError });

        setupValidation(form);

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            errorEl.hidden = true;
            successEl.hidden = true;

            if (!validateForm(form, errorEl)) return;
            const quill = editorEl?.quill;
            // Friendly checks only. The limits that count are enforced by the zod schema in
            // src/lib/contact-schema.ts on the server; keep the numbers here in step with it.
            const text = quill?.getText().trim() ?? '';
            if (!text) { showError('Please enter a message.'); quill?.focus(); return; }
            if (text.length > 10_000) { showError('Your message is too long.'); quill?.focus(); return; }

            const data = new FormData(form);
            await submitJson({
                form, widget, button: submitBtn, errorEl, successEl,
                url: '/api/contact',
                body: () => ({
                    name: String(data.get('name') ?? '').trim(),
                    email: String(data.get('email') ?? '').trim(),
                    html: quill.getSemanticHTML(),
                }),
                onSuccess: () => { form.reset(); quill.setText(''); },
            });
        });
    }
</script>
