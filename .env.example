# Cloudflare Turnstile (apply, contact and partner forms).
# Copy to .env and fill in. Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# and add your hostnames (localhost included, for local dev).
#
# Site key: public, rendered into the page at build time.
# For local testing, Cloudflare's always-pass test key works on any hostname: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
# Secret key: server-side only, for verifying tokens with the siteverify API. Never prefix with
# PUBLIC_ and never commit the real value. Store it on the Worker with `wrangler secret put`.
# Always-pass test secret: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# Resend (apply, contact and partner form delivery). Server-side only; in production set these as
# Worker secrets. All three forms share this inbox and sender; there's no separate address configured.
RESEND_API_KEY=
# Where applications, contact and partner messages are delivered.
CONTACT_TO_EMAIL=
# Sender. Must be on a domain verified in Resend, e.g. "Ventra Fund <contact@yourdomain.com>".
# For testing, onboarding@resend.dev works but only delivers to the Resend account owner's address.
CONTACT_FROM_EMAIL=

# LlamaCloud (reading uploaded bank statements on the apply form: classify, then extract the
# account holder, address and monthly deposits). Server-side only; a Worker secret in production.
# Get a key at https://cloud.llamaindex.ai. Without it the upload area reports uploads as
# unavailable and the form still submits without statements.
LLAMA_CLOUD_API_KEY=

# Admin sign-in at /admin (email one-time codes, sent through the Resend settings above). Server-side
# only; Worker secrets in production. Needs the AUTH_DB D1 database (see wrangler.jsonc), so it only
# works under `pnpm build && pnpm preview` or deployed, not `pnpm dev`.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The site's origin, e.g. https://ventrafund.com. Optional locally (taken from the request).
BETTER_AUTH_URL=
# Comma-separated list of the only emails allowed to sign in.
ADMIN_EMAILS=

# Encrypts the EIN and SSN an approved applicant gives on the signing page. Server-side only; a
# Worker secret in production. 32 random bytes, base64: `openssl rand -base64 32`. Keep a copy
# somewhere safe: without it, stored identifiers can't be decrypted. Without it set, the signing
# page's final step fails closed and nothing is stored.
SIGNING_ENCRYPTION_KEY=

# The phone number on /contact, E.164 (e.g. +15555550123). Server-side only; a Worker secret in
# production (`wrangler secret put CONTACT_PHONE`). Never commit the real value: it is only ever
# served by /api/contact/reveal behind Turnstile, drawn as shapes (docs/contact-reveal.md).
# `pnpm check:contact` fails if it turns up in a committable file or in dist/.
CONTACT_PHONE=
