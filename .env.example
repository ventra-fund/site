# Cloudflare Turnstile (contact and partner forms).
# Copy to .env and fill in. Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# and add your hostnames (localhost included, for local dev).
#
# Site key: public, rendered into the page at build time.
# For local testing, Cloudflare's always-pass test key works on any hostname: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
# Secret key: server-side only, for verifying tokens with the siteverify API. Never prefix with
# PUBLIC_ and never commit the real value. Store it on the Worker with `wrangler secret put`.
# Always-pass test secret: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# Resend (contact and partner form delivery). Server-side only; in production set these as Worker
# secrets. The partner form shares this inbox and sender, there's no separate address configured.
RESEND_API_KEY=
# Where contact and partner messages are delivered.
CONTACT_TO_EMAIL=
# Sender. Must be on a domain verified in Resend, e.g. "Ventra Fund <contact@yourdomain.com>".
# For testing, onboarding@resend.dev works but only delivers to the Resend account owner's address.
CONTACT_FROM_EMAIL=
